            <stringProp name="script">def tenant = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())._embedded?.tenants?.getAt(0)

vars.put(&quot;customerId&quot;, tenant?.uniqueId ?: &quot;&quot;)
