                <stringProp name="HTTPSampler.method">POST</stringProp>
                <boolProp name="HTTPSampler.follow_redirects">false</boolProp>
                <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
                <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
                <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
                <stringProp name="HTTPSampler.embedded_url_re"></stringProp>
                <stringProp name="HTTPSampler.connect_timeout">30000</stringProp>
                <stringProp name="HTTPSampler.response_timeout">30000</stringProp>
              </HTTPSamplerProxy>
              <hashTree>
                <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Build Topic Presenter Payload" enabled="true">
                  <stringProp name="script">// Runs once per loop iteration (Topic Loop Controller loops = topicsForThisPresenter) - picks ONE
// random topic from the list loaded once by Topics PostProcessor, and creates ONE Topic
// resource (child of the presenter just created) per call, using the Topic resourcetype&apos;s
// own form/field-mappings (fn_topicPayloadBuilder) so the payload shape always matches the
// live form template - e.g. { &quot;data&quot;: { &quot;textField1&quot;: &quot;&lt;topicMasterId&gt;&quot;, &quot;isActive&quot;: true } }.
def presenterNum = vars.get(&quot;presenterCounter&quot;) ?: &quot;?&quot;

int topicIterNum = (vars.get(&quot;topicIterCounter&quot;) ?: &quot;0&quot;).toInteger() + 1
vars.put(&quot;topicIterCounter&quot;, topicIterNum.toString())

def totalDesired = vars.get(&quot;topicsForThisPresenter&quot;) ?: &quot;?&quot;
def requestName = sampler.getName()
// sampler.setName(&quot;${requestName} (${topicIterNum}/${totalDesired})&quot;)
sampler.setName(&quot;${requestName} #${topicIterNum}&quot;)

int totalTopics = (vars.get(&quot;topicId_count&quot;) ?: &quot;0&quot;) as int

if (totalTopics == 0) {
    vars.put(&quot;dynamicPayload&quot;, &apos;{&quot;data&quot;:{}}&apos;)
    log.warn(&quot;Presenter #&quot; + presenterNum + &quot;, topic &quot; + topicIterNum + &quot;/&quot; + totalDesired + &quot;: no topics available - sending empty payload&quot;)
} else {
    // FIX: the flat list now contains every hierarchy level (thanks to ?hierarchy=true
    // on Get Topics), so a plain random index over 1..totalTopics would often land on
    // a mid-level/root node instead of a fully specified multi-level topic. Mirrors
    // BIQ.jmx&apos;s leaf-first approach: a leaf is any topic whose id never appears as
    // another topic&apos;s parentId - i.e. the deepest node in its branch. The single
    // Topic field only needs that one leaf id; the API resolves the ancestor chain.
    def allParentIds = (1..totalTopics).collect { vars.get(&quot;topicParentId_&quot; + it) ?: &quot;&quot; }.findAll { it }.toSet()
    def leafIndices = (1..totalTopics).findAll { idx -&gt;
        def id = vars.get(&quot;topicId_&quot; + idx)
        id &amp;&amp; !allParentIds.contains(id)
    }

    def rand = java.util.concurrent.ThreadLocalRandom.current()
    int pickIdx
    if (leafIndices) {
        pickIdx = leafIndices[rand.nextInt(leafIndices.size())]
    } else {
        // Data gap fallback: no leaves resolvable (e.g. parentId missing on every
        // row) - fall back to picking from the full flat list rather than failing.
        log.warn(&quot;Presenter #&quot; + presenterNum + &quot;, topic &quot; + topicIterNum + &quot;/&quot; + totalDesired + &quot;: no leaf-level topic found - falling back to full list&quot;)
        pickIdx = rand.nextInt(totalTopics) + 1
    }

    def selectedTopicId = vars.get(&quot;topicId_&quot; + pickIdx)
    def selectedTopicName = vars.get(&quot;topicName_&quot; + pickIdx) ?: selectedTopicId

    vars.put(&quot;selectedTopicId&quot;, selectedTopicId)
    vars.put(&quot;selectedTopicName&quot;, selectedTopicName)

    props.get(&quot;fn_topicPayloadBuilder&quot;)(vars, selectedTopicId, log)
}</stringProp>
                  <stringProp name="scriptLanguage">groovy</stringProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="cacheKey">true</stringProp>
                </JSR223PreProcessor>
                <hashTree/>
                <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header Manager" enabled="true">
                  <collectionProp name="HeaderManager.headers">
                    <elementProp name="" elementType="Header">
