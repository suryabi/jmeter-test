                <stringProp name="WhileController.condition">${__javaScript(parseInt(vars.get(&quot;blockSlotIterCounter&quot;) || 0) &lt; parseInt(vars.get(&quot;blockSlotsForThisPresenter&quot;) || 0))}</stringProp>
              </WhileController>
              <hashTree>
                <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Create Blocked Time Slot" enabled="true">
                  <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
                  <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
                    <collectionProp name="Arguments.arguments">
                      <elementProp name="" elementType="HTTPArgument">
                        <boolProp name="HTTPArgument.always_encode">false</boolProp>
                        <stringProp name="Argument.value">${dynamicPayload}</stringProp>
                        <stringProp name="Argument.metadata">=</stringProp>
                      </elementProp>
                    </collectionProp>
                  </elementProp>
                  <stringProp name="HTTPSampler.domain"></stringProp>
                  <stringProp name="HTTPSampler.port"></stringProp>
                  <stringProp name="HTTPSampler.protocol"></stringProp>
                  <stringProp name="HTTPSampler.contentEncoding"></stringProp>
                  <stringProp name="HTTPSampler.path">/${contextname}/api/resources/${presenterId}/calendars</stringProp>
                  <stringProp name="HTTPSampler.method">POST</stringProp>
                  <boolProp name="HTTPSampler.follow_redirects">false</boolProp>
                  <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
                  <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
                  <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
                  <stringProp name="HTTPSampler.embedded_url_re"></stringProp>
                  <stringProp name="HTTPSampler.connect_timeout">30000</stringProp>
                  <stringProp name="HTTPSampler.response_timeout">30000</stringProp>
                </HTTPSamplerProxy>
                <hashTree>
                  <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Build Existing Presenter Blocked Slot Payload" enabled="true">
                    <stringProp name="script">// Same shared payload builder as the create-flow&apos;s &quot;Build Presenter Blocked Slot
// Payload&quot; (fn_buildBlockedSlotPayload), reusing the SAME blockFromDate..blockToDate/
// blockSlotFullDay/blockTimes/blockDurations variables (just point them at
// whichever month you&apos;re targeting, e.g. September dates). Runs once per loop
// iteration (Existing Presenter Blocked Slot Loop Controller loops =
// blockSlotsForThisPresenter, the total slot count returned by fn_planBlockedDays in
// Load Next Existing Presenter) - only entered at all when the exists-check above found
// this presenter has no blocked slot yet in the target range. blockedSlotDatesPlan has
// one date entry per planned slot, in order, so the Nth iteration targets the Nth entry -
// this is what makes blockSlots (days) and blockSlotsPerDay (slots per day) line up.
// This preprocessor only handles the existing-flow-specific loop counter, date lookup,
// and sampler naming.
def presenterId = vars.get(&quot;presenterId&quot;) ?: &quot;?&quot;

int blockIterNum = (vars.get(&quot;blockSlotIterCounter&quot;) ?: &quot;0&quot;).toInteger() + 1
vars.put(&quot;blockSlotIterCounter&quot;, blockIterNum.toString())
def totalDesired = vars.get(&quot;blockSlotsForThisPresenter&quot;) ?: &quot;?&quot;

def plannedDates = (vars.get(&quot;blockedSlotDatesPlan&quot;) ?: &quot;&quot;).split(&quot;;&quot;)*.trim().findAll { it }
def forcedDate = (blockIterNum &gt;= 1 &amp;&amp; blockIterNum &lt;= plannedDates.size()) ? plannedDates[blockIterNum - 1] : null

def requestName = sampler.getName()
//sampler.setName(&quot;${requestName} (${blockIterNum}/${totalDesired})&quot;)
sampler.setName(&quot;${requestName} #${blockIterNum}&quot;)

props.get(&quot;fn_buildBlockedSlotPayload&quot;)(vars, log, presenterId + &quot;, blocked slot &quot; + blockIterNum + &quot;/&quot; + totalDesired, forcedDate)</stringProp>
                    <stringProp name="scriptLanguage">groovy</stringProp>
                    <stringProp name="parameters"></stringProp>
                    <stringProp name="filename"></stringProp>
                    <stringProp name="cacheKey">true</stringProp>
                  </JSR223PreProcessor>
