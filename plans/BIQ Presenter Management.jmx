                <hashTree/>
                <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Added Topics Extractor" enabled="true">
                  <stringProp name="script">def presenterNum = vars.get(&quot;presenterCounter&quot;) ?: &quot;?&quot;
def topicIterNum = vars.get(&quot;topicIterCounter&quot;) ?: &quot;?&quot;
def totalDesired = vars.get(&quot;topicsForThisPresenter&quot;) ?: &quot;?&quot;
def responseCode = prev.getResponseCode()

if (responseCode != &quot;200&quot; &amp;&amp; responseCode != &quot;201&quot;) {
    log.warn(&quot;Add Topic to Presenter #&quot; + presenterNum + &quot;, topic &quot; + topicIterNum + &quot;/&quot; + totalDesired + &quot;: failed with response code &quot; + responseCode)
} else {
    def topicName = vars.get(&quot;selectedTopicName&quot;) ?: &quot;&quot;
    log.info(&quot;Add Topic to Presenter #&quot; + presenterNum + &quot;, topic &quot; + topicIterNum + &quot;/&quot; + totalDesired + &quot;: &apos;&quot; + topicName + &quot;&apos; added successfully&quot;)
}</stringProp>
                  <stringProp name="scriptLanguage">groovy</stringProp>
