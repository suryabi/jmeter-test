          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Category PostProcessor" enabled="true">
            <stringProp name="script">// Check if test is aborting due to previous validation failure
if (props.get(&quot;fn_checkAbort&quot;)(vars, prev)) return

// Parse JSON response
def response = prev.getResponseDataAsString()
def json = new groovy.json.JsonSlurper().parseText(response)

// Extract categories from response
// Real shape: uniqueId, isActive, categoryName, description, sortOrder,
// categoryType{uniqueId,categoryTypeName,description}, parent{uniqueId,categoryName,description}, identifier
def categories = json._embedded?.categories ?: []

// Only consider active categories
categories = categories.findAll { it.isActive != false }

// Validate categories exist
if (categories.isEmpty()) {
    log.error(&quot;No active categories found under parent Category=&quot; + vars.get(&quot;category&quot;))
    props.get(&quot;fn_abortNotFound&quot;)(vars, prev, &quot;Category&quot;, vars.get(&quot;category&quot;) ?: &quot;&quot;, &quot;&quot;, ctx)
    return
}

// &quot;Category&quot; (Global Variable, the location dropdown, desc=&quot;UniqueId of category&quot;) tells us
// which specific one of these results to select. Falls back to lowest sortOrder if left blank.
def preferredCategoryId = vars.get(&quot;category&quot;)?.trim()
def selectedCategory

if (preferredCategoryId) {
    selectedCategory = categories.find { it.uniqueId?.equalsIgnoreCase(preferredCategoryId) }
    if (selectedCategory) {
        log.info(&quot;Category matched Global Variable &apos;Category&apos;: &quot; + selectedCategory.categoryName)
    } else {
        def availableCategories = categories.collect { it.uniqueId + &quot; (&quot; + (it.categoryName ?: &quot;&quot;) + &quot;)&quot; }.join(&quot;, &quot;)
        props.get(&quot;fn_abortNotFound&quot;)(vars, prev, &quot;category&quot;, preferredCategoryId, availableCategories, ctx)
        return
    }
} else {
    selectedCategory = categories.sort { it.sortOrder ?: 0 }[0]
    log.info(&quot;No Category specified — defaulting to lowest sortOrder: &quot; + selectedCategory.categoryName)
}

// Store selected category variables
vars.put(&quot;categoryId&quot;, selectedCategory.uniqueId ?: &quot;&quot;)
vars.put(&quot;categoryName&quot;, selectedCategory.categoryName ?: &quot;&quot;)
vars.put(&quot;categoryIdentifier&quot;, selectedCategory.identifier ?: &quot;&quot;)
vars.put(&quot;categoryTypeName&quot;, selectedCategory.categoryType?.categoryTypeName ?: vars.get(&quot;categoryTypeName&quot;) ?: &quot;&quot;)

// Update sampler label with selected category so it shows in View Results Tree
def selectedCatName = vars.get(&quot;categoryName&quot;) ?: &quot;&quot;
if (selectedCatName) {
    prev.setSampleLabel(prev.getSampleLabel() + &quot; - &quot; + selectedCatName)
}

// Logging for debugging
log.info(&quot;Selected Category ID: &quot; + vars.get(&quot;categoryId&quot;))
log.info(&quot;Selected Category Name: &quot; + vars.get(&quot;categoryName&quot;))
log.info(&quot;Category Identifier: &quot; + vars.get(&quot;categoryIdentifier&quot;))

log.info(&quot;----- Terminated: Category PostProcessor -----&quot;)</stringProp>
