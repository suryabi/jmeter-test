<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.4.1">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="BIQ - EIQ" enabled="true">
      <boolProp name="TestPlan.serialize_threadgroups">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <stringProp name="TestPlan.comments"></stringProp>
      <stringProp name="TestPlan.user_define_classpath"></stringProp>
    </TestPlan>
    <hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="BIQ Presenter Management" enabled="true">
        <stringProp name="ThreadGroup.num_threads">1</stringProp>
        <stringProp name="ThreadGroup.ramp_time">1</stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">1</stringProp>
        </elementProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <stringProp name="ThreadGroup.duration"></stringProp>
        <stringProp name="ThreadGroup.delay"></stringProp>
      </ThreadGroup>
      <hashTree>
        <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
          <collectionProp name="Arguments.arguments">
            <elementProp name="categoryType" elementType="Argument">
              <stringProp name="Argument.name">categoryType</stringProp>
              <stringProp name="Argument.value">CATEGORY_TYPE_BRIEFINGS</stringProp>
              <stringProp name="Argument.desc">DROPDOWN, API, REQUIRED. Select the category type to use</stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
            </elementProp>
            <elementProp name="category" elementType="Argument">
              <stringProp name="Argument.name">category</stringProp>
              <stringProp name="Argument.value">de83BC6A-472E-41A0-BE2C-E0429C85D015</stringProp>
              <stringProp name="Argument.desc">DROPDOWN, API, REQUIRED. Select the category to use</stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
            </elementProp>
            <elementProp name="presenters" elementType="Argument">
              <stringProp name="Argument.name">presenters</stringProp>
              <stringProp name="Argument.value">1</stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
              <stringProp name="Argument.desc">LABEL=NoOfPresenters. REQUIRED. Min,max number of presenters to create</stringProp>
            </elementProp>
            <elementProp name="topicsPerPresenter" elementType="Argument">
              <stringProp name="Argument.name">topicsPerPresenter</stringProp>
              <stringProp name="Argument.value">2,3</stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
              <stringProp name="Argument.desc">Min,max topics to assign per presenter</stringProp>
            </elementProp>
            <elementProp name="emailDomain" elementType="Argument">
              <stringProp name="Argument.name">emailDomain</stringProp>
              <stringProp name="Argument.value">briefingiq.com</stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
              <stringProp name="Argument.desc">LABEL=domainForEmails. Domain used for generated email addresses</stringProp>
            </elementProp>
            <elementProp name="blockFromDate" elementType="Argument">
              <stringProp name="Argument.name">blockFromDate</stringProp>
              <stringProp name="Argument.value">2026-11-01</stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
              <stringProp name="Argument.desc">DATE. LABEL=blockStartDate. Start date of the blocked slot range (yyyy-MM-dd).</stringProp>
            </elementProp>
            <elementProp name="blockToDate" elementType="Argument">
              <stringProp name="Argument.name">blockToDate</stringProp>
              <stringProp name="Argument.value">2026-11-30</stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
              <stringProp name="Argument.desc">DATE. LABEL=blockEndDate. End date of the blocked slot range (yyyy-MM-dd).</stringProp>
            </elementProp>
            <elementProp name="blockSlots" elementType="Argument">
              <stringProp name="Argument.name">blockSlots</stringProp>
              <stringProp name="Argument.value">1</stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
              <stringProp name="Argument.desc">LABEL=noOfBlockedDays. Min,max number of blocked days to create within the specified date range</stringProp>
            </elementProp>
            <elementProp name="blockSlotsPerDay" elementType="Argument">
              <stringProp name="Argument.name">blockSlotsPerDay</stringProp>
              <stringProp name="Argument.value">1,3</stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
              <stringProp name="Argument.desc">LABEL=blockSlotsPerDay. Min,max number of blocked slots to create per day from configured blocked slots</stringProp>
            </elementProp>
            <elementProp name="blockSlotFullDay" elementType="Argument">
              <stringProp name="Argument.name">blockSlotFullDay</stringProp>
              <stringProp name="Argument.value">false</stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
              <stringProp name="Argument.desc">BOOLEAN, LABEL=fullDayBlock. If true, each blocked slot spans the entire day; otherwise each blocked slot uses a random time &amp; duration.</stringProp>
            </elementProp>
            <elementProp name="blockTimes" elementType="Argument">
              <stringProp name="Argument.name">blockTimes</stringProp>
              <stringProp name="Argument.value"></stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
              <stringProp name="Argument.desc">LABEL=blockStartTimes. ENABLE_IF=blockSlotFullDay:false. Comma-separated start times (HH:mm). Randomly selects one value. Leave blank for a random time. Ignored when fullDayBlock=true</stringProp>
            </elementProp>
            <elementProp name="blockDurations" elementType="Argument">
              <stringProp name="Argument.name">blockDurations</stringProp>
              <stringProp name="Argument.value">30, 60, 120, 150</stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
              <stringProp name="Argument.desc">LABEL=blockDurations. ENABLE_IF=blockSlotFullDay:false. Comma-separated durations (minutes). Randomly selects one value. Leave blank to use 30,60 minutes. Ignored when fullDayBlock=true</stringProp>
            </elementProp>
            <elementProp name="isNewPresenter" elementType="Argument">
              <stringProp name="Argument.name">isNewPresenter</stringProp>
              <stringProp name="Argument.value">false</stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
              <stringProp name="Argument.desc">BOOLEAN, REQUIRED, LABEL=createNewPresenters. true = create new presenters, topics, and blocked slots. false = add blocked slots to existing presenters that do not already have blocked slots within the specified date range</stringProp>
            </elementProp>
            <elementProp name="presenterEmails" elementType="Argument">
              <stringProp name="Argument.name">presenterEmails</stringProp>
              <stringProp name="Argument.value">brandy.chavez@briefingiq.com</stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
              <stringProp name="Argument.desc">DROPDOWN, API, MULTI, LABEL=existingPresenters. ENABLE_IF=isNewPresenter:false. Used only when createNewPresenter=false. If presenters are selected, blocked slots are created only for those presenters. Leave blank to use all existing presenters</stringProp>
            </elementProp>
          </collectionProp>
        </Arguments>
        <hashTree/>
