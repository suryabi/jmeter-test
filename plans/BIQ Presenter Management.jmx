            <hashTree>
              <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Build Presenter Payload" enabled="true">
                <stringProp name="script">def presenterNum = (vars.get(&quot;presenterCounter&quot;) ?: &quot;0&quot;).toInteger() + 1
vars.put(&quot;presenterCounter&quot;, presenterNum.toString())
vars.put(&quot;topicIterCounter&quot;, &quot;0&quot;)
def presenterName = sampler.getName()
sampler.setName(&quot;${presenterName} #${presenterNum}&quot;)
props.get(&quot;fn_presenterPayloadBuilder&quot;)(vars, log)

// topicsPerPresenter supports either a fixed count (e.g. &quot;3&quot;) or a range &quot;min,max&quot;
// (e.g. &quot;1,3&quot;) - a random count in [min,max] is picked once per presenter here,
// so every presenter can end up with a different number of topics.
int topicsForThisPresenter = props.get(&quot;fn_parseRangeCount&quot;)(vars, log, &quot;topicsPerPresenter&quot;, &quot;#&quot; + presenterNum)
vars.put(&quot;topicsForThisPresenter&quot;, topicsForThisPresenter.toString())
log.info(&quot;Presenter #&quot; + presenterNum + &quot;: will be assigned &quot; + topicsForThisPresenter + &quot; topic(s) (range &quot; + (vars.get(&quot;topicsPerPresenter&quot;) ?: &quot;0&quot;) + &quot;)&quot;)

// Every presenter created this run gets blocked days planned. fn_planBlockedDays picks
// blockSlots DISTINCT days within blockFromDate..blockToDate for THIS presenter, then
// independently rolls blockSlotsPerDay for each of those days (see Blocked Slot Loop
// Controller below, which iterates over the resulting flat per-slot day plan).
vars.put(&quot;presenterBlockedIntervals&quot;, &quot;&quot;) // reset per-presenter overlap tracker used by fn_buildBlockedSlotPayload
int blockSlotsForThisPresenter = props.get(&quot;fn_planBlockedDays&quot;)(vars, log, &quot;#&quot; + presenterNum)
vars.put(&quot;blockSlotsForThisPresenter&quot;, blockSlotsForThisPresenter.toString())
vars.put(&quot;blockSlotIterCounter&quot;, &quot;0&quot;)
log.info(&quot;Presenter #&quot; + presenterNum + &quot;: will be assigned &quot; + blockSlotsForThisPresenter + &quot; blocked slot(s) total across its blocked day(s)&quot;)</stringProp>
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
