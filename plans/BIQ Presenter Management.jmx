            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Presenter List Extractor" enabled="true">
              <stringProp name="script">import groovy.json.JsonSlurper

// Parses the presenter list response and stores each presenter&apos;s id + baseTimezone
// as indexed variables (presenterList_id_1, presenterList_tz_1, presenterList_name_1, ...)
// so the Existing Presenter Loop Controller below can iterate over them one at a time,
// the same counter-driven pattern already used by the Presenter/Topic/Blocked Slot loops.
def responseCode = prev.getResponseCode()
vars.put(&quot;existingPresenterCount&quot;, &quot;0&quot;)
vars.put(&quot;existingPresenterIterCounter&quot;, &quot;0&quot;)

if (responseCode != &quot;200&quot;) {
    log.warn(&quot;Get Presenters failed with response code &quot; + responseCode + &quot; - no presenters loaded, existing-presenter flow will do nothing&quot;)
} else {
    def json = new JsonSlurper().parseText(prev.getResponseDataAsString())
    def resources = json._embedded?.resources ?: []

    // presenterEmails: optional comma-separated list of presenter primary emails. If set,
    // only those presenters are kept for this run; everyone else from Get Presenters is
    // dropped before the indexed presenterList_* variables are built below.
    def presenterEmailsStr = (vars.get(&quot;presenterEmails&quot;) ?: &quot;&quot;).trim()
    if (presenterEmailsStr) {
        def selectedEmails = presenterEmailsStr.split(&quot;,&quot;)*.trim().findAll { it }.collect { it.toLowerCase() } as Set
        def beforeCount = resources.size()
        resources = resources.findAll { r -&gt;
            def email = (r.data?.primaryEmail ?: &quot;&quot;).trim().toLowerCase()
            email &amp;&amp; selectedEmails.contains(email)
        }
        log.info(&quot;Existing Presenter Flow: presenterEmails filter applied - &quot; + resources.size() + &quot; of &quot; + beforeCount + &quot; presenter(s) matched &quot; + selectedEmails.size() + &quot; selected email(s)&quot;)
        def matchedEmails = resources.collect { (it.data?.primaryEmail ?: &quot;&quot;).trim().toLowerCase() } as Set
        def unmatchedEmails = selectedEmails - matchedEmails
        if (unmatchedEmails) {
            log.warn(&quot;Existing Presenter Flow: presenterEmails entries not found among existing presenters: &quot; + unmatchedEmails.join(&quot;, &quot;))
        }
    }

    resources.eachWithIndex { r, i -&gt;
        def idx = i + 1
        vars.put(&quot;presenterList_id_&quot; + idx, r.uniqueId ?: &quot;&quot;)
        vars.put(&quot;presenterList_tz_&quot; + idx, r.data?.baseTimezone ?: &quot;&quot;)
        vars.put(&quot;presenterList_name_&quot; + idx, r.data?.presenterName ?: (r.uniqueId ?: &quot;&quot;))
    }
    vars.put(&quot;existingPresenterCount&quot;, resources.size().toString())

    def totalPages = json.page?.totalPages ?: 1
    if (totalPages &gt; 1) {
        log.warn(&quot;Get Presenters: response has &quot; + totalPages + &quot; page(s) but this request only fetches page 0 (size=1000) - only the first 1000 presenters will be processed. Increase page size or add pagination handling if you expect more.&quot;)
    }
    log.info(&quot;Existing Presenter Flow: loaded &quot; + resources.size() + &quot; presenter(s) from Get Presenters&quot;)
}</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
            <com.atlantbh.jmeter.plugins.jsonutils.jsonformatter.JSONFormatter guiclass="com.atlantbh.jmeter.plugins.jsonutils.jsonformatter.gui.JSONFormatterGui" testclass="com.atlantbh.jmeter.plugins.jsonutils.jsonformatter.JSONFormatter" testname="jp@gc - JSON Format Post Processor" enabled="true"/>
            <hashTree/>
          </hashTree>
          <WhileController guiclass="WhileControllerGui" testclass="WhileController" testname="Existing Presenter Loop Controller" enabled="true">
            <stringProp name="WhileController.condition">${__javaScript(parseInt(vars.get(&quot;existingPresenterIterCounter&quot;) || 0) &lt; parseInt(vars.get(&quot;existingPresenterCount&quot;) || 0))}</stringProp>
          </WhileController>
          <hashTree>
            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Get Blocked Time Slots" enabled="true">
              <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
                <collectionProp name="Arguments.arguments">
                  <elementProp name="fromDate" elementType="HTTPArgument">
                    <boolProp name="HTTPArgument.always_encode">true</boolProp>
                    <stringProp name="Argument.value">${blockFromDate}T00:00:00</stringProp>
                    <stringProp name="Argument.metadata">=</stringProp>
                    <boolProp name="HTTPArgument.use_equals">true</boolProp>
                    <stringProp name="Argument.name">fromDate</stringProp>
                  </elementProp>
                  <elementProp name="toDate" elementType="HTTPArgument">
                    <boolProp name="HTTPArgument.always_encode">true</boolProp>
                    <stringProp name="Argument.value">${blockToDate}T00:00:00</stringProp>
                    <stringProp name="Argument.metadata">=</stringProp>
                    <boolProp name="HTTPArgument.use_equals">true</boolProp>
                    <stringProp name="Argument.name">toDate</stringProp>
                  </elementProp>
                </collectionProp>
              </elementProp>
              <stringProp name="HTTPSampler.domain"></stringProp>
              <stringProp name="HTTPSampler.port"></stringProp>
              <stringProp name="HTTPSampler.protocol"></stringProp>
              <stringProp name="HTTPSampler.contentEncoding"></stringProp>
              <stringProp name="HTTPSampler.path">/${contextname}/api/resources/${presenterId}/calendars</stringProp>
              <stringProp name="HTTPSampler.method">GET</stringProp>
              <boolProp name="HTTPSampler.follow_redirects">false</boolProp>
              <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
              <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
              <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
              <stringProp name="HTTPSampler.embedded_url_re"></stringProp>
              <stringProp name="HTTPSampler.connect_timeout">30000</stringProp>
              <stringProp name="HTTPSampler.response_timeout">30000</stringProp>
            </HTTPSamplerProxy>
            <hashTree>
              <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Load Next Existing Presenter" enabled="true">
                <stringProp name="script">// Runs once per loop iteration (Existing Presenter Loop Controller loops = existingPresenterCount).
// Pulls the next presenter&apos;s id/timezone loaded earlier by Presenter List Extractor,
// sets presenterId + presenterSelectedTimezone (reused by the header managers and the
// payload builder below, same variables the create-flow already relies on), and resets
// targetMonthSlotExists so a previous presenter&apos;s result never leaks into this iteration.
int idx = (vars.get(&quot;existingPresenterIterCounter&quot;) ?: &quot;0&quot;).toInteger() + 1
vars.put(&quot;existingPresenterIterCounter&quot;, idx.toString())

def pid = vars.get(&quot;presenterList_id_&quot; + idx) ?: &quot;&quot;
def ptz = vars.get(&quot;presenterList_tz_&quot; + idx) ?: (vars.get(&quot;clientTimeZone&quot;) ?: &quot;UTC&quot;)
def pname = vars.get(&quot;presenterList_name_&quot; + idx) ?: pid

vars.put(&quot;presenterId&quot;, pid)
vars.put(&quot;presenterSelectedTimezone&quot;, ptz)
vars.put(&quot;targetMonthSlotExists&quot;, &quot;false&quot;)

// Every existing presenter processed this run gets blocked days planned. fn_planBlockedDays
// picks blockSlots DISTINCT days within blockFromDate..blockToDate for THIS presenter, then
// independently rolls blockSlotsPerDay for each of those days (only actually created below
// when this presenter has none yet in the target range - see Existing Presenter Blocked
// Slot Loop Controller / &quot;If No Blocked Time Slots Exists&quot; below).
vars.put(&quot;presenterBlockedIntervals&quot;, &quot;&quot;) // reset per-presenter overlap tracker used by fn_buildBlockedSlotPayload
int blockSlotsForThisPresenter = props.get(&quot;fn_planBlockedDays&quot;)(vars, log, pid)
vars.put(&quot;blockSlotsForThisPresenter&quot;, blockSlotsForThisPresenter.toString())
vars.put(&quot;blockSlotIterCounter&quot;, &quot;0&quot;)

def total = vars.get(&quot;existingPresenterCount&quot;) ?: &quot;?&quot;
def requestName = sampler.getName()
sampler.setName(&quot;${requestName} | 👤 ${pname} (${idx}/${total})&quot;)
log.info(&quot;Existing Presenter Flow: processing presenter &quot; + idx + &quot;/&quot; + total + &quot; id=&quot; + pid + &quot; tz=&quot; + ptz + &quot; - will create up to &quot; + blockSlotsForThisPresenter + &quot; blocked slot(s) if none exist in range&quot;)</stringProp>
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
              </JSR223PreProcessor>
              <hashTree/>
              <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header Manager" enabled="true">
                <collectionProp name="HeaderManager.headers">
                  <elementProp name="" elementType="Header">
                    <stringProp name="Header.name">x-cloud-customerid</stringProp>
                    <stringProp name="Header.value">${customerId}</stringProp>
                  </elementProp>
                  <elementProp name="" elementType="Header">
                    <stringProp name="Header.name">x-cloud-categorytypeid</stringProp>
                    <stringProp name="Header.value">${categoryTypeId}</stringProp>
                  </elementProp>
                  <elementProp name="" elementType="Header">
                    <stringProp name="Header.name">x-cloud-categoryid</stringProp>
                    <stringProp name="Header.value">${category}</stringProp>
                  </elementProp>
                  <elementProp name="" elementType="Header">
                    <stringProp name="Header.name">x-cloud-requested-timezone</stringProp>
                    <stringProp name="Header.value">${presenterSelectedTimezone}</stringProp>
                  </elementProp>
                  <elementProp name="" elementType="Header">
                    <stringProp name="Header.name">X_cloud_user</stringProp>
                    <stringProp name="Header.value">${user}</stringProp>
                  </elementProp>
                  <elementProp name="" elementType="Header">
                    <stringProp name="Header.name">x-cloud-parentid</stringProp>
                    <stringProp name="Header.value">${presenterId}</stringProp>
                  </elementProp>
                  <elementProp name="" elementType="Header">
                    <stringProp name="Header.name">X-Cloud-Client-Timezone</stringProp>
                    <stringProp name="Header.value">${clientTimeZone}</stringProp>
                  </elementProp>
                </collectionProp>
              </HeaderManager>
              <hashTree/>
              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Check Target Month Slot Exists" enabled="true">
                <stringProp name="script">import groovy.json.JsonSlurper
import java.time.LocalDate
import java.time.format.DateTimeFormatter

// Decides whether this presenter already has a blocked slot inside
// blockFromDate..blockToDate (the SAME variables the create-flow uses - just point them
// at whichever month you&apos;re targeting, e.g. 2026-09-01/2026-09-30 for September), using
// ONLY calendarFromDate (per requirement) - any existing slot whose calendarFromDate.zoneDate
// falls within that range counts as &quot;already exists&quot;, regardless of topics or anything
// else about the presenter.
def presenterId = vars.get(&quot;presenterId&quot;) ?: &quot;?&quot;
def fromStr = (vars.get(&quot;blockFromDate&quot;) ?: &quot;&quot;).trim()
def toStr = (vars.get(&quot;blockToDate&quot;) ?: &quot;&quot;).trim()
vars.put(&quot;targetMonthSlotExists&quot;, &quot;false&quot;)

if (!fromStr || !toStr) {
    log.warn(&quot;Presenter &quot; + presenterId + &quot;: blockFromDate/blockToDate not set - cannot check, defaulting to not-found (will attempt create)&quot;)
} else {
    def fmt = DateTimeFormatter.ISO_LOCAL_DATE
    LocalDate targetFrom = LocalDate.parse(fromStr, fmt)
    LocalDate targetTo = LocalDate.parse(toStr, fmt)
    if (targetTo.isBefore(targetFrom)) {
        def tmp = targetFrom; targetFrom = targetTo; targetTo = tmp
    }

    def responseCode = prev.getResponseCode()
    if (responseCode != &quot;200&quot;) {
        log.warn(&quot;Presenter &quot; + presenterId + &quot;: Get Presenter Blocked Slots failed with response code &quot; + responseCode + &quot; - skipping exists-check, defaulting to not-found&quot;)
    } else {
        def json = new JsonSlurper().parseText(prev.getResponseDataAsString())
        def slots = json._embedded?.resourceCalendars ?: []

        boolean found = slots.any { slot -&gt;
            def zoneDateStr = slot.calendarFromDate?.zoneDate
            if (!zoneDateStr || zoneDateStr.length() &lt; 10) return false
            LocalDate slotDate = LocalDate.parse(zoneDateStr.substring(0, 10), fmt)
            return !slotDate.isBefore(targetFrom) &amp;&amp; !slotDate.isAfter(targetTo)
        }

        vars.put(&quot;targetMonthSlotExists&quot;, found.toString())
        log.info(&quot;Presenter &quot; + presenterId + &quot;: &quot; + slots.size() + &quot; existing slot(s) found, target range &quot; + fromStr + &quot; to &quot; + toStr + &quot; -&gt; already blocked = &quot; + found)
    }
}</stringProp>
                <stringProp name="scriptLanguage">groovy</stringProp>
