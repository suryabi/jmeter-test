def _fn_beautifyFormConfig = { varsRef, prevRef, logRef, targetVarName = &quot;currentFormUIConfig&quot; -&gt;

// UI Config JSON Beautifier
try {
    def response = prevRef.getResponseDataAsString()
    def json = new groovy.json.JsonSlurper().parseText(response)

    // Parse the stringified formTemplate into actual JSON
    if (json.formTemplate) {
        if (json.formTemplate instanceof String) {
            json.formTemplate = new groovy.json.JsonSlurper().parseText(json.formTemplate)
        }
        // Update the target variable (currentFormUIConfig by default; callers for other
        // resourcetypes, e.g. Topic, pass their own var name so they don&apos;t clobber this one)
        varsRef.put(targetVarName, groovy.json.JsonOutput.toJson(json.formTemplate))
    }

    // Beautify and store
    def beautified = groovy.json.JsonOutput.prettyPrint(groovy.json.JsonOutput.toJson(json))
    prevRef.setResponseData(beautified, &quot;UTF-8&quot;)

} catch (Exception e) {
    logRef.warn(&quot;Could not beautify JSON: &quot; + e.getMessage())
}
}
props.put(&quot;fn_beautifyFormConfig&quot;, _fn_beautifyFormConfig)

// Stores the raw field mappings API response in currentFieldMappings (or another target var, e.g.
// currentTopicFieldMappings) for use by a payload builder to map attributeNames to their aliasNames.
def _fn_fieldMappingsPostProcessor = { varsRef, prevRef, logRef, targetVarName = &quot;currentFieldMappings&quot; -&gt;

// Parse and Store JSON Response
def response = prevRef.getResponseDataAsString()
varsRef.put(targetVarName, response)
}
props.put(&quot;fn_fieldMappingsPostProcessor&quot;, _fn_fieldMappingsPostProcessor)

// Flattens all form fields from a formUIConfig JSON string into a single list — used by the
// payload builder to resolve each field&apos;s lookupName dynamically instead of hardcoding it.
def _fn_extractAllFields = { String fuiConfigStr -&gt;
    def fuiConfig = new groovy.json.JsonSlurper().parseText(fuiConfigStr)
    def fields = []
    def items = fuiConfig.config ?: []
    items.each { item -&gt;
        if (item.type == &quot;SECTION&quot;) {
            fields.addAll(item.formFields ?: [])
        } else if (item.type == &quot;FORMFIELD&quot;) {
            fields.add(item)
        }
    }
    return fields
}
props.put(&quot;fn_extractAllFields&quot;, _fn_extractAllFields)

log.info(&quot;Common Function - Form Processing initialized&quot;)</stringProp>
