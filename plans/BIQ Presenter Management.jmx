        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Validate Variables" enabled="true">
          <stringProp name="script">import java.time.*
import java.time.format.DateTimeFormatter

def dateFormatter = DateTimeFormatter.ofPattern(&quot;yyyy-MM-dd&quot;)

// ===== VALIDATION: Check required Presenter UDV variables =====
def errors = []
def presentersStr          = vars.get(&quot;presenters&quot;)?.trim()
def user                   = vars.get(&quot;user&quot;)?.trim()
def clientTimeZone         = vars.get(&quot;clientTimeZone&quot;)?.trim()
def categoryTypeStr        = vars.get(&quot;categoryType&quot;)?.trim()
def categoryStr            = vars.get(&quot;category&quot;)?.trim()
def topicsPerPresenterStr = vars.get(&quot;topicsPerPresenter&quot;)?.trim()
def blockSlotsPerDayStr = vars.get(&quot;blockSlotsPerDay&quot;)?.trim()
def blockSlotsStr = vars.get(&quot;blockSlots&quot;)?.trim()
def blockFromDate          = vars.get(&quot;blockFromDate&quot;)?.trim()
def blockToDate            = vars.get(&quot;blockToDate&quot;)?.trim()
def blockSlotFullDay       = vars.get(&quot;blockSlotFullDay&quot;)?.trim()
def blockTimesStr          = vars.get(&quot;blockTimes&quot;)?.trim()
def blockDurationsStr      = vars.get(&quot;blockDurations&quot;)?.trim()
def isNewPresenterStr      = vars.get(&quot;isNewPresenter&quot;)?.trim()

// ===== Abort helper =====
def abort = { String msg, String responseMsg = &quot;&quot; -&gt;
    log.error(&quot;========================================&quot;)
    log.error(msg)
    log.error(&quot;Please fix these variables in User Defined Variables before running the test.&quot;)
    log.error(&quot;========================================&quot;)
    vars.put(&quot;presenters&quot;, &quot;0&quot;)
    vars.put(&quot;presentersToCreate&quot;, &quot;0&quot;)
    SampleResult.setResponseData(msg, &quot;UTF-8&quot;)
    SampleResult.setResponseCode(&quot;400&quot;)
    if (responseMsg) SampleResult.setResponseMessage(responseMsg)
    SampleResult.setSuccessful(false)
    SampleResult.setStopTestNow(true)
}

// ===== Required field presence checks =====
[
    [presentersStr,   &quot;presenters is empty&quot;],
    [user,            &quot;user is empty&quot;],
    [clientTimeZone,  &quot;clientTimeZone is empty&quot;],
    [categoryTypeStr, &quot;categoryType is required&quot;],
    [categoryStr,     &quot;Category is required&quot;],
    [isNewPresenterStr, &quot;isNewPresenter is empty&quot;]
].each { val, msg -&gt; if (!val) errors.add(msg) }

if (user) {
    if (user.contains(&quot;,&quot;)) {
        errors.add(&quot;user must be a single email — multiple comma-separated values are not supported&quot;)
    } else if (!(user ==~ /^[^@]+@[^@]+\.[^@]+$/)) {
        errors.add(&quot;user has invalid format: &apos;${user}&apos; — expected format user@domain.com&quot;)
    }
}

if (clientTimeZone) {
    try { ZoneId.of(clientTimeZone) }
    catch (Exception e) { errors.add(&quot;clientTimeZone &apos;${clientTimeZone}&apos; is not a valid IANA zone id (e.g. Asia/Calcutta)&quot;) }
}

if (isNewPresenterStr) {
    if (!(isNewPresenterStr.equalsIgnoreCase(&quot;true&quot;) || isNewPresenterStr.equalsIgnoreCase(&quot;false&quot;))) {
        errors.add(&quot;isNewPresenter &apos;${isNewPresenterStr}&apos; is invalid — must be exactly &apos;true&apos; or &apos;false&apos;&quot;)
    } else {
        vars.put(&quot;isNewPresenter&quot;, isNewPresenterStr.toLowerCase())
    }
}

// ===== presenters: required — fixed positive integer OR positive min,max range =====
// Unlike topicsPerPresenter/blockSlots (which may legitimately be disabled), presenters
// is required, so a reversed range (min &gt; max) is a validation error here, not a silent 0.
if (presentersStr) {
    def presentersParts = presentersStr.split(&quot;,&quot;)*.trim()
    if (!presentersParts.every { it.isInteger() }) {
        errors.add(&quot;presenters &apos;${presentersStr}&apos; is invalid — expected a positive integer (e.g. 5) or a min,max range (e.g. 2,5)&quot;)
    } else if (presentersParts.size() &gt; 2) {
        errors.add(&quot;presenters &apos;${presentersStr}&apos; is invalid — expected a single value (e.g. 5) or a range (e.g. 2,5)&quot;)
    } else {
        int presentersMin = presentersParts[0].toInteger()
        int presentersMax = (presentersParts.size() &gt; 1 ? presentersParts[1].toInteger() : presentersMin)
        if (presentersMin &lt;= 0 || presentersMax &lt;= 0) {
            errors.add(&quot;presenters &apos;${presentersStr}&apos; is invalid — values must be positive (at least 1)&quot;)
        } else if (presentersMin &gt; presentersMax) {
            errors.add(&quot;presenters &apos;${presentersStr}&apos; is invalid — min (${presentersMin}) cannot be greater than max (${presentersMax})&quot;)
        }
    }
}

// ===== Shared min,max range validator (&quot;0&quot;/empty = feature disabled, no error) =====
def validateRange = { String varName, String raw, String exampleRange -&gt;
    if (!raw || raw == &quot;0&quot;) return [0, 0]
    def parts = raw.split(&quot;,&quot;)*.trim()
    if (!parts.every { it.isInteger() }) {
        errors.add(&quot;${varName} &apos;${raw}&apos; is invalid — must be positive integers, e.g. ${exampleRange}&quot;)
        return null
    }
    if (parts.any { it.toInteger() &lt; 0 }) {
        errors.add(&quot;${varName} &apos;${raw}&apos; is invalid — negative values not allowed&quot;)
        return null
    }
    if (parts.size() &gt; 2) {
        errors.add(&quot;${varName} &apos;${raw}&apos; is invalid — expected a single value (e.g. 2) or a range (e.g. 1,3)&quot;)
        return null
    }
    int min = parts[0].toInteger()
    int max = (parts.size() &gt; 1 ? parts[1].toInteger() : min)
    if (min &gt; max) {
        log.warn(&quot;${varName} &apos;${raw}&apos; has min (${min}) &gt; max (${max}) — treating as disabled (feature will be skipped), not aborting&quot;)
        return [0, 0]
    }
    return [min, max]
}

def topicsRange = validateRange(&quot;topicsPerPresenter&quot;, topicsPerPresenterStr, &quot;1,3&quot;)
def blockRange  = validateRange(&quot;blockSlotsPerDay&quot;, blockSlotsPerDayStr, &quot;1,3&quot;)
def blockSlotsRange = validateRange(&quot;blockSlots&quot;, blockSlotsStr, &quot;2,4&quot;)

// Blocked slots are only actually created when BOTH a non-zero pool of presenters is
// requested (blockSlots) AND a non-zero per-presenter slot count is requested
// (blockSlotsPerDay). Either one being 0/disabled means no blocking happens this run.
def blockedSlotsRequested = (blockRange != null &amp;&amp; blockRange[1] &gt; 0 &amp;&amp; blockSlotsRange != null &amp;&amp; blockSlotsRange[1] &gt; 0)
if (blockedSlotsRequested) {
    def validateDate = { String val, String name -&gt;
        if (!val) {
            errors.add(&quot;${name} is empty — required when blockSlotsPerDay is set (format: yyyy-MM-dd, e.g. 2026-08-01)&quot;)
        } else if (!(val ==~ /\d{4}-\d{2}-\d{2}/)) {
            errors.add(&quot;${name} has invalid format: &apos;${val}&apos; (expected: yyyy-MM-dd, e.g. 2026-08-01)&quot;)
        } else {
            try { LocalDate.parse(val, dateFormatter) }
            catch (Exception e) { errors.add(&quot;${name} is not a valid date: &apos;${val}&apos; (${e.message})&quot;) }
        }
    }
    validateDate(blockFromDate, &quot;blockFromDate&quot;)
    validateDate(blockToDate, &quot;blockToDate&quot;)
}

// ===== blockSlotFullDay: optional boolean flag. When true, blockSlotsPerDay&apos;s
// count is irrelevant (see &quot;Build Presenter Payload&quot;/&quot;Load Next Existing Presenter&quot;),
// and blockTimes/blockDurations are skipped entirely since each slot already spans the whole day. =====
if (blockSlotFullDay &amp;&amp; !(blockSlotFullDay.equalsIgnoreCase(&quot;true&quot;) || blockSlotFullDay.equalsIgnoreCase(&quot;false&quot;))) {
    errors.add(&quot;blockSlotFullDay &apos;${blockSlotFullDay}&apos; is invalid — expected true or false&quot;)
}
def blockFullDayRequested = blockSlotFullDay?.equalsIgnoreCase(&quot;true&quot;)

// ===== blockTimes: optional comma-separated HH:mm list (minutes must be :00 or :30). Ignored when full-day blocking is on. =====
if (blockTimesStr &amp;&amp; !blockFullDayRequested) {
    def badTimes = blockTimesStr.split(&quot;,&quot;)*.trim().findAll { it }.findAll { t -&gt;
        !(t ==~ /^([01]?\d|2[0-3]):(00|30)$/)
    }
    if (badTimes) {
        errors.add(&quot;blockTimes &apos;${blockTimesStr}&apos; is invalid — each entry must be HH:mm with minutes 00 or 30 (e.g. 11:00, 03:30), got invalid: ${badTimes.join(&apos;, &apos;)}&quot;)
    }
}

// ===== blockDurations: optional comma-separated list of positive integer minutes. Ignored when full-day blocking is on. =====
if (blockDurationsStr &amp;&amp; !blockFullDayRequested) {
    def durParts = blockDurationsStr.split(&quot;,&quot;)*.trim().findAll { it }
    if (!durParts.every { it.isInteger() &amp;&amp; it.toInteger() &gt; 0 }) {
        errors.add(&quot;blockDurations &apos;${blockDurationsStr}&apos; is invalid — must be a comma-separated list of positive integer minutes, e.g. 30,60&quot;)
    }
}

// ===== Abort on validation errors =====
if (errors.size() &gt; 0) {
    def errorMsg = &quot;ABORTING: Validation failed:\n&quot; + errors.collect { &quot;  ✗ ${it}&quot; }.join(&quot;\n&quot;)
    errors.each { log.error(&quot;✗ ${it}&quot;) }
    abort(errorMsg)
    return
}

// ===== Resolve presenters range to a concrete count for this run (once, not per-presenter) =====
int presentersToCreate = props.get(&quot;fn_parseRangeCount&quot;)(vars, log, &quot;presenters&quot;, &quot;overall&quot;)
vars.put(&quot;presentersToCreate&quot;, presentersToCreate.toString())

// ===== Build summary =====
def sb = new StringBuilder()
sb.append(&quot;========================================\n&quot;)
sb.append(&quot;PRESENTER RUN SUMMARY\n&quot;)
sb.append(&quot;========================================\n&quot;)
sb.append(&quot;Presenters to create    : ${presentersStr} -&gt; ${presentersToCreate} this run\n&quot;)
sb.append(&quot;Topics per presenter    : ${topicsPerPresenterStr ?: &apos;0 (disabled)&apos;}\n&quot;)
sb.append(&quot;Block days (per pres.)  : ${blockSlotsStr ?: &apos;0 (disabled)&apos;}\n&quot;)
sb.append(&quot;Blocked slots/presenter : ${blockSlotsPerDayStr ?: &apos;0 (disabled)&apos;}\n&quot;)
if (blockedSlotsRequested) {
    sb.append(&quot;Block date range        : ${blockFromDate} to ${blockToDate}\n&quot;)
}
sb.append(&quot;Block full day          : ${blockSlotFullDay ?: &apos;false&apos;}\n&quot;)
if (!blockFullDayRequested) {
    sb.append(&quot;Block times             : ${blockTimesStr ?: &apos;random :00/:30&apos;}\n&quot;)
    sb.append(&quot;Block durations (min)   : ${blockDurationsStr ?: &apos;30,60 (default)&apos;}\n&quot;)
}
sb.append(&quot;========================================\n&quot;)

log.info(sb.toString())

SampleResult.setResponseData(sb.toString(), &quot;UTF-8&quot;)
SampleResult.setResponseCode(&quot;200&quot;)
SampleResult.setResponseMessage(&quot;Validation passed — ${presentersToCreate} presenter(s) will be created (presenters=${presentersStr})&quot;)
SampleResult.setSuccessful(true)
SampleResult.setIgnore()</stringProp>
