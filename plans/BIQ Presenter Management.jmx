              <stringProp name="WhileController.condition">${__javaScript(parseInt(vars.get(&quot;blockSlotIterCounter&quot;) || 0) &lt; parseInt(vars.get(&quot;blockSlotsForThisPresenter&quot;) || 0))}</stringProp>
            </WhileController>
            <hashTree>
              <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Create Blocked Time Slot" enabled="true">
                <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
                <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
                  <collectionProp name="Arguments.arguments">
                    <elementProp name="" elementType="HTTPArgument">
                      <boolProp name="HTTPArgument.always_encode">false</boolProp>
                      <stringProp name="Argument.value">${dynamicPayload}</stringProp>
                      <stringProp name="Argument.metadata">=</stringProp>
                    </elementProp>
                  </collectionProp>
                </elementProp>
                <stringProp name="HTTPSampler.domain"></stringProp>
                <stringProp name="HTTPSampler.port"></stringProp>
                <stringProp name="HTTPSampler.protocol"></stringProp>
                <stringProp name="HTTPSampler.contentEncoding"></stringProp>
                <stringProp name="HTTPSampler.path">/${contextname}/api/resources/${presenterId}/calendars</stringProp>
                <stringProp name="HTTPSampler.method">POST</stringProp>
                <boolProp name="HTTPSampler.follow_redirects">false</boolProp>
                <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
                <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
                <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
                <stringProp name="HTTPSampler.embedded_url_re"></stringProp>
                <stringProp name="HTTPSampler.connect_timeout">30000</stringProp>
                <stringProp name="HTTPSampler.response_timeout">30000</stringProp>
              </HTTPSamplerProxy>
              <hashTree>
                <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Build Presenter Blocked Slot Payload" enabled="true">
                  <stringProp name="script">// Runs once per loop iteration (Blocked Slot Loop Controller loops = blockSlotsForThisPresenter,
// the total slot count returned by fn_planBlockedDays in Build Presenter Payload).
// blockedSlotDatesPlan (set by fn_planBlockedDays) has one date entry per planned slot,
// in order, so the Nth iteration here targets the Nth entry - this is what makes
// blockSlots (days) and blockSlotsPerDay (slots per day) actually line up, instead of
// every slot landing on an independently random day. Delegates the actual time/duration
// picking and payload assembly to the shared fn_buildBlockedSlotPayload function (also
// used by the existing-flow&apos;s &quot;Build Existing Presenter Blocked Slot Payload&quot;) - this
// preprocessor only handles the create-flow-specific loop counter, date lookup, and
// sampler naming.
def presenterNum = vars.get(&quot;presenterCounter&quot;) ?: &quot;?&quot;

int blockIterNum = (vars.get(&quot;blockSlotIterCounter&quot;) ?: &quot;0&quot;).toInteger() + 1
vars.put(&quot;blockSlotIterCounter&quot;, blockIterNum.toString())
def totalDesired = vars.get(&quot;blockSlotsForThisPresenter&quot;) ?: &quot;?&quot;

def plannedDates = (vars.get(&quot;blockedSlotDatesPlan&quot;) ?: &quot;&quot;).split(&quot;;&quot;)*.trim().findAll { it }
def forcedDate = (blockIterNum &gt;= 1 &amp;&amp; blockIterNum &lt;= plannedDates.size()) ? plannedDates[blockIterNum - 1] : null

def blockedTimeSlotName = sampler.getName()
def requestName = sampler.getName()
//sampler.setName(&quot;${requestName} (${blockIterNum}/${totalDesired})&quot;)
sampler.setName(&quot;${requestName} #${blockIterNum}&quot;)

props.get(&quot;fn_buildBlockedSlotPayload&quot;)(vars, log, &quot;#&quot; + presenterNum + &quot;, blocked slot &quot; + blockIterNum + &quot;/&quot; + totalDesired, forcedDate)</stringProp>
                  <stringProp name="scriptLanguage">groovy</stringProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="cacheKey">true</stringProp>
                </JSR223PreProcessor>
                <hashTree/>
                <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header Manager" enabled="true">
                  <collectionProp name="HeaderManager.headers">
                    <elementProp name="" elementType="Header">
                      <stringProp name="Header.name">x-cloud-customerid</stringProp>
                      <stringProp name="Header.value">${customerId}</stringProp>
                    </elementProp>
                    <elementProp name="" elementType="Header">
                      <stringProp name="Header.name">x-cloud-categorytypeid</stringProp>
                      <stringProp name="Header.value">${categoryTypeId}</stringProp>
                    </elementProp>
                    <elementProp name="" elementType="Header">
                      <stringProp name="Header.name">x-cloud-categoryid</stringProp>
                      <stringProp name="Header.value">${category}</stringProp>
                    </elementProp>
                    <elementProp name="" elementType="Header">
                      <stringProp name="Header.name">x-cloud-requested-timezone</stringProp>
                      <stringProp name="Header.value">${presenterSelectedTimezone}</stringProp>
                    </elementProp>
                    <elementProp name="" elementType="Header">
                      <stringProp name="Header.name">X_cloud_user</stringProp>
                      <stringProp name="Header.value">${user}</stringProp>
                    </elementProp>
                    <elementProp name="" elementType="Header">
                      <stringProp name="Header.name">x-cloud-parentid</stringProp>
                      <stringProp name="Header.value">${presenterId}</stringProp>
                    </elementProp>
                    <elementProp name="X-Cloud-Client-Timezone" elementType="Header">
                      <stringProp name="Header.name">X-Cloud-Client-Timezone</stringProp>
                      <stringProp name="Header.value">${clientTimeZone}</stringProp>
                    </elementProp>
                  </collectionProp>
                </HeaderManager>
