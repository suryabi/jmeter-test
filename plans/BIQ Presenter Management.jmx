          <stringProp name="script">SampleResult.setIgnore()

// Presenter Payload Builder — builds the dynamic Create Presenter POST body.
def _fn_presenterPayloadBuilder = { varsRef, logRef -&gt;
    def fmStr = varsRef.get(&quot;currentFieldMappings&quot;)
    if (!fmStr) {
        logRef.warn(&quot;Presenter payload: currentFieldMappings not found — skipping&quot;)
        varsRef.put(&quot;dynamicPayload&quot;, &apos;{&quot;data&quot;:{}}&apos;)
        return &apos;{&quot;data&quot;:{}}&apos;
    }
    def fmJson = new groovy.json.JsonSlurper().parseText(fmStr)
    def mappings = fmJson._embedded?.fieldMappings ?: []

    // Build attrName → lookupName map from the form&apos;s own field config (Get Form Fields),
    // so lookup-bound fields (e.g. code, designation) are resolved dynamically instead of
    // hardcoding specific lookup names — any future lookup-bound field is picked up automatically.
    def formUIConfigStr = varsRef.get(&quot;currentFormUIConfig&quot;)
    def fieldLookupInfo = [:]
    if (formUIConfigStr) {
        props.get(&quot;fn_extractAllFields&quot;)(formUIConfigStr).each { f -&gt;
            def fn = f.dataMapping ?: f.formControlName
            if (fn &amp;&amp; f.lookupName) fieldLookupInfo[fn] = f.lookupName
        }
    } else {
        logRef.warn(&quot;Presenter payload: currentFormUIConfig not found — lookup-bound fields will be skipped&quot;)
    }

    def rand = java.util.concurrent.ThreadLocalRandom.current()

    // ---- Pick the next random user from the pre-loaded pool (cycles if exhausted) ----
    def totalUsers = (varsRef.get(&quot;randomUserCount&quot;) ?: &quot;50&quot;).toInteger()
    def idx = (varsRef.get(&quot;randomUserIndex&quot;) ?: &quot;1&quot;).toInteger()
    if (idx &gt; totalUsers || idx &lt; 1) idx = 1
    def firstName = varsRef.get(&quot;randomUser_${idx}_firstName&quot;) ?: &quot;John&quot;
    def lastName  = varsRef.get(&quot;randomUser_${idx}_lastName&quot;)  ?: &quot;Doe&quot;
    varsRef.put(&quot;randomUserIndex&quot;, String.valueOf(idx + 1))

    def emailDomain = props.get(&quot;fn_extractEmailDomain&quot;)(varsRef)
    def handle = (firstName + &quot;.&quot; + lastName).toLowerCase().replaceAll(&quot;[^a-z.]&quot;, &quot;&quot;)
    // Secondary handle: lastName.firstName (e.g. sanders.luke)
    def secondaryHandle = (lastName + &quot;.&quot; + firstName).toLowerCase().replaceAll(&quot;[^a-z.]&quot;, &quot;&quot;)
    // Assistant handle: first-initial.lastName (e.g. g.reynolds) — common real-world mailbox convention
    def assistantHandle = (firstName.take(1) + &quot;.&quot; + lastName).toLowerCase().replaceAll(&quot;[^a-z.]&quot;, &quot;&quot;)

    // ---- Precompute reusable values ----
    def primaryEmail    = &quot;${handle}@${emailDomain}&quot;
    def secondaryEmail  = &quot;${secondaryHandle}@${emailDomain}&quot;
    def assistantEmail  = &quot;${assistantHandle}@${emailDomain}&quot;
    def mobile          = props.get(&quot;fn_generatePhone&quot;)()
    // Base Timezone ← pick fresh per presenter from the pool loaded by Get Timezones,
    // so each presenter in the loop gets its own random timezone instead of sharing one.
    def tzCount = (varsRef.get(&quot;timezoneCount&quot;) ?: &quot;0&quot;).toInteger()
    def baseTimezoneVal = tzCount &gt; 0 ? (varsRef.get(&quot;tz_zoneName_&quot; + (rand.nextInt(tzCount) + 1)) ?: &quot;UTC&quot;) : &quot;UTC&quot;
    // Persist this presenter&apos;s assigned timezone so the Blocked Slot payload builder
    // (which runs later, after this presenter is created) can reuse the SAME zone
    // instead of a separate/unrelated one.
    varsRef.put(&quot;presenterSelectedTimezone&quot;, baseTimezoneVal)

    def payload = [:]

    mappings.each { mapping -&gt;
        def attrName = mapping.columnAttribute?.attributeName
        def alias    = mapping.aliasName
        def dataType = (mapping.columnAttribute?.dataType ?: &quot;&quot;).toString().toUpperCase()
        if (!attrName) return

        // Skip server-computed fields (e.g. presenterName = firstName + lastName via dataExpression)
        if (mapping.dataExpression) {
            logRef.info(&quot;Presenter payload: skipping computed field &apos;${attrName}&apos; (has dataExpression)&quot;)
            return
        }

        // Skip CLOB fields (e.g. textAreaField1/notes) — not rendered on the New Presenter
        // form, so no value should be sent for them.
        if (dataType.contains(&quot;CLOB&quot;)) {
            logRef.info(&quot;Presenter payload: skipping CLOB field &apos;${attrName}&apos; (not on form)&quot;)
            return
        }

        def value
        // Normalize alias (strip everything but letters/digits, then lowercase) before matching -
        // a mismatched case or stray whitespace/punctuation from the API (e.g. &quot;Is Executive&quot;
        // instead of &quot;isExecutive&quot;) would silently fall through to the default branch below
        // and could get force-set to true.
        def aliasNorm = (alias ?: &quot;&quot;).toLowerCase().replaceAll(/[^a-z0-9]/, &quot;&quot;)
        def knownAlias = true
        switch (aliasNorm) {
            case &quot;firstname&quot;:      value = firstName; break
            case &quot;lastname&quot;:       value = lastName; break
            case &quot;primaryemail&quot;:   value = primaryEmail; break
            case &quot;secondaryemail&quot;: value = secondaryEmail; break
            case &quot;assistantemail&quot;: value = assistantEmail; break
            case &quot;mobile&quot;:         value = mobile; break
            case &quot;basetimezone&quot;:   value = baseTimezoneVal; break
            case &quot;isebdrequired&quot;:  value = rand.nextBoolean(); break
            case &quot;isemailoptout&quot;:  value = rand.nextBoolean(); break
            case &quot;isexecutive&quot;:    value = rand.nextBoolean(); break
            default: knownAlias = false
        }

        if (!knownAlias) {
            // Lookup-bound field (e.g. code → PHONE_COUNTRY_CODE, designation → DESIGNATIONS) —
            // pick a real value from the tenant&apos;s own dropdown data. Only applies to fields NOT
            // already handled by a known alias above, so a field the live form config happens to
            // expose as lookup-bound (e.g. a Yes/No dropdown) can never silently override an
            // explicitly-handled boolean/text field like isExecutive. If the tenant has no rows for
            // this lookup, leave the field out of the payload entirely rather than sending static
            // data that would never actually appear in that tenant&apos;s dropdown.
            def lookupName = fieldLookupInfo[attrName]
            if (lookupName) {
                def lookupValue = props.get(&quot;fn_pickLookupValue&quot;)(varsRef, lookupName, &quot;tenant&quot;, rand, attrName, logRef)
                if (lookupValue == null) {
                    logRef.warn(&quot;Presenter payload: no &apos;${lookupName}&apos; lookup values for this tenant — leaving &apos;${attrName}&apos; out of payload&quot;)
                    return
                }
                payload[attrName] = lookupValue
                return
            }

            // No known alias (e.g. &quot;Is Active&quot; has none in the mapping) — fall back to
            // attributeName / dataType so new/unmapped fields still get a sane value.
            // NOTE: this &quot;isActive&quot; hardcode is meant for the generic entity active/inactive
            // flag only - if a DIFFERENT boolean field (e.g. isExecutive) ends up here because
            // its alias didn&apos;t match above, it will incorrectly always be forced to true.
            if (attrName == &quot;isActive&quot;) {
                value = true
                if (aliasNorm) {
                    logRef.warn(&quot;Presenter payload: field &apos;${attrName}&apos; (alias=&apos;${alias}&apos;) matched generic isActive fallback (forced true) instead of a known alias case - check for alias mismatch&quot;)
                }
            } else if (dataType.contains(&quot;BOOLEAN&quot;)) {
                value = rand.nextBoolean()
            } else if (dataType.contains(&quot;VARCHAR&quot;) || dataType.contains(&quot;CHAR&quot;)) {
                value = &quot;&quot;
            } else {
                value = null
            }
        }
        if (dataType.contains(&quot;BOOLEAN&quot;) || aliasNorm in [&quot;isexecutive&quot;, &quot;isebdrequired&quot;, &quot;isemailoptout&quot;]) {
            logRef.info(&quot;Presenter payload: boolean field attrName=&apos;${attrName}&apos; alias=&apos;${alias}&apos; dataType=&apos;${dataType}&apos; -&gt; value=${value}&quot;)
        }
        payload[attrName] = value
    }

    def json = groovy.json.JsonOutput.prettyPrint(groovy.json.JsonOutput.toJson([data: payload]))
    varsRef.put(&quot;dynamicPayload&quot;, json)
    logRef.info(&quot;Presenter payload built (randomUser idx=${idx}): &quot; + json)
    return json
}
props.put(&quot;fn_presenterPayloadBuilder&quot;, _fn_presenterPayloadBuilder)

// Topic Payload Builder — builds the dynamic &quot;Add Topic to Presenter&quot; POST body 
def _fn_topicPayloadBuilder = { varsRef, selectedTopicMasterId, logRef -&gt;
    def fmStr = varsRef.get(&quot;currentTopicFieldMappings&quot;)
    if (!fmStr) {
        logRef.warn(&quot;Topic payload: currentTopicFieldMappings not found — skipping&quot;)
        varsRef.put(&quot;dynamicPayload&quot;, &apos;{&quot;data&quot;:{}}&apos;)
        return &apos;{&quot;data&quot;:{}}&apos;
    }
    def fmJson = new groovy.json.JsonSlurper().parseText(fmStr)
    def mappings = fmJson._embedded?.fieldMappings ?: []

    // Find the attribute whose form-config field is a MASTER dropdown bound to our Topic
    // topicMasterTypeId - that&apos;s the field the selected topic id should be written into.
    def formUIConfigStr = varsRef.get(&quot;currentTopicFormUIConfig&quot;)
    def topicMasterAttr = null
    if (formUIConfigStr) {
        def topicMasterTypeId = varsRef.get(&quot;topicMastertypeId&quot;)
        props.get(&quot;fn_extractAllFields&quot;)(formUIConfigStr).each { f -&gt;
            if (f.enumType == &quot;MASTER&quot; &amp;&amp; f.topicMasterTypeId == topicMasterTypeId) {
                topicMasterAttr = f.dataMapping ?: f.formControlName
            }
        }
    } else {
        logRef.warn(&quot;Topic payload: currentTopicFormUIConfig not found — cannot identify the topic-select field&quot;)
    }

    def payload = [:]

    mappings.each { mapping -&gt;
        def attrName = mapping.columnAttribute?.attributeName
        def dataType = (mapping.columnAttribute?.dataType ?: &quot;&quot;).toString().toUpperCase()
        if (!attrName) return

        // Skip server-computed fields
        if (mapping.dataExpression) {
            logRef.info(&quot;Topic payload: skipping computed field &apos;${attrName}&apos; (has dataExpression)&quot;)
            return
        }
        // Skip CLOB fields — not rendered on the form
        if (dataType.contains(&quot;CLOB&quot;)) {
            logRef.info(&quot;Topic payload: skipping CLOB field &apos;${attrName}&apos; (not on form)&quot;)
            return
        }

        def value
        if (attrName == topicMasterAttr) {
            value = selectedTopicMasterId
        } else if (attrName == &quot;isActive&quot;) {
            value = true
        } else if (dataType.contains(&quot;BOOLEAN&quot;)) {
            value = true
        } else if (dataType.contains(&quot;VARCHAR&quot;) || dataType.contains(&quot;CHAR&quot;)) {
            value = &quot;&quot;
        } else {
            // Unrecognized type (e.g. a newly added MASTER/LOOKUP field with a different
            // topicMasterTypeId) — no safe generic default exists, so leave it out rather than
            // send a wrong value; flag it so it doesn&apos;t fail silently.
            logRef.warn(&quot;Topic payload: no default rule for field &apos;${attrName}&apos; (dataType=${dataType}) — leaving it out of the payload&quot;)
            return
        }
        payload[attrName] = value
    }

    if (!topicMasterAttr) {
        logRef.warn(&quot;Topic payload: no MASTER-type field bound to topicMastertypeId=${varsRef.get(&apos;topicMastertypeId&apos;)} was found on the Topic form — the topic selection will be missing from the payload&quot;)
    }

    def json = groovy.json.JsonOutput.prettyPrint(groovy.json.JsonOutput.toJson([data: payload]))
    varsRef.put(&quot;dynamicPayload&quot;, json)
    logRef.info(&quot;Topic payload built: &quot; + json)
    return json
}
props.put(&quot;fn_topicPayloadBuilder&quot;, _fn_topicPayloadBuilder)

// Range Count Parser — shared by topicsPerPresenter and blockSlotsPerDay (create-flow
// AND existing-flow all use the same &quot;fixed count OR min,max range&quot; format/semantics).
// Returns a random int in [min,max] (or the fixed value if no comma), 0 if the param is
// unset, and warns + returns 0 if min &gt; max.
def _fn_parseRangeCount = { varsRef, logRef, paramName, presenterLabel -&gt;
    def rangeStr = (varsRef.get(paramName) ?: &quot;0&quot;).trim()
    def parts = rangeStr.split(&quot;,&quot;)*.trim()
    int minVal = parts[0] as int
    int maxVal = (parts.size() &gt; 1 ? parts[1] as int : parts[0] as int)
    def rand = java.util.concurrent.ThreadLocalRandom.current()
    int result
    if (maxVal &lt; minVal) {
        logRef.warn(&quot;Presenter &quot; + presenterLabel + &quot;: &quot; + paramName + &quot; &apos;&quot; + rangeStr + &quot;&apos; has min &gt; max — treating as disabled, value=0&quot;)
        result = 0
    } else {
        result = minVal + rand.nextInt(maxVal - minVal + 1)
    }
    return result
}
props.put(&quot;fn_parseRangeCount&quot;, _fn_parseRangeCount)

// Blocked Days Planner — called once per presenter created/processed this run.
// blockSlots (fixed count or min,max range) = HOW MANY DISTINCT
// DAYS, within blockFromDate..blockToDate, to block for this presenter (e.g.
// blockFromDate=2026-12-01, blockToDate=2026-12-30, blockSlots=5,6 -&gt; 5 or 6 random
// December days get chosen for this presenter). For EACH of those chosen days,
// blockSlotsPerDay (fixed count or min,max range) is re-rolled INDEPENDENTLY to decide
// how many blocked slots to create on that specific day (so one blocked day for a
// presenter might get 1 slot while another gets 3). When blockSlotFullDay=true,
// every chosen day gets exactly 1 slot (a full-day block already covers the whole day,
// so more than one on the same day would just overlap itself). Stores the result as a
// semicolon-separated &quot;blockedSlotDatesPlan&quot; UDV - one date entry per PLANNED SLOT, in
// order (so the Nth entry is the target date for the Nth blocked-slot loop iteration) -
// and returns the total slot count (sum across all chosen days). Logs one INFO line per
// chosen day showing that day&apos;s resolved slot count, plus a final summary line with the
// full day list and grand total.
def _fn_planBlockedDays = { varsRef, logRef, presenterLabel -&gt;
    def fmt = java.time.format.DateTimeFormatter.ISO_LOCAL_DATE
    def fromDateStr = (varsRef.get(&quot;blockFromDate&quot;) ?: &quot;&quot;).trim()
    def toDateStr = (varsRef.get(&quot;blockToDate&quot;) ?: &quot;&quot;).trim()

    if (!fromDateStr || !toDateStr) {
        logRef.warn(&quot;Presenter &quot; + presenterLabel + &quot;: blockFromDate/blockToDate not set - skipping blocked day planning&quot;)
        varsRef.put(&quot;blockedSlotDatesPlan&quot;, &quot;&quot;)
        return 0
    }

    java.time.LocalDate rangeStart = java.time.LocalDate.parse(fromDateStr, fmt)
    java.time.LocalDate rangeEnd = java.time.LocalDate.parse(toDateStr, fmt)
    if (rangeEnd.isBefore(rangeStart)) {
        def tmp = rangeStart; rangeStart = rangeEnd; rangeEnd = tmp
    }
    long totalDaysInRange = java.time.temporal.ChronoUnit.DAYS.between(rangeStart, rangeEnd) + 1

    int daysToBlock = props.get(&quot;fn_parseRangeCount&quot;)(varsRef, logRef, &quot;blockSlots&quot;, presenterLabel)
    if (daysToBlock &lt;= 0) {
        varsRef.put(&quot;blockedSlotDatesPlan&quot;, &quot;&quot;)
        logRef.info(&quot;Presenter &quot; + presenterLabel + &quot;: blockSlots is 0/unset - no blocked days planned&quot;)
        return 0
    }
    if (daysToBlock &gt; totalDaysInRange) {
        logRef.warn(&quot;Presenter &quot; + presenterLabel + &quot;: blockSlots requested &quot; + daysToBlock + &quot; day(s) but blockFromDate..blockToDate only spans &quot; + totalDaysInRange + &quot; day(s) - capping to &quot; + totalDaysInRange)
        daysToBlock = (int) totalDaysInRange
    }

    def blockFullDayFlag = (varsRef.get(&quot;blockSlotFullDay&quot;) ?: &quot;false&quot;).trim().equalsIgnoreCase(&quot;true&quot;)

    // Pick daysToBlock DISTINCT day-offsets at random out of the range, then sort them
    // chronologically (purely cosmetic - so log/plan order reads earliest-to-latest).
    def allOffsets = (0..&lt;(int) totalDaysInRange).toList()
    Collections.shuffle(allOffsets, new Random())
    def chosenDates = allOffsets.take(daysToBlock).sort().collect { rangeStart.plusDays(it).format(fmt) }

    def plan = []
    chosenDates.each { d -&gt;
        int slotsThisDay = blockFullDayFlag ? 1 : props.get(&quot;fn_parseRangeCount&quot;)(varsRef, logRef, &quot;blockSlotsPerDay&quot;, presenterLabel + &quot; on &quot; + d)
        slotsThisDay.times { plan &lt;&lt; d }
        logRef.info(&quot;Presenter &quot; + presenterLabel + &quot;: &quot; + d + &quot; -&gt; &quot; + slotsThisDay + &quot; slot(s)&quot;)
    }

    varsRef.put(&quot;blockedSlotDatesPlan&quot;, plan.join(&quot;;&quot;))
    logRef.info(&quot;Presenter &quot; + presenterLabel + &quot;: will block &quot; + chosenDates.size() + &quot; day(s) [&quot; + chosenDates.join(&quot;, &quot;) + &quot;] with &quot; + plan.size() + &quot; total blocked slot(s)&quot;)
    return plan.size()
}
props.put(&quot;fn_planBlockedDays&quot;, _fn_planBlockedDays)

// Blocked Slot Payload Builder — shared by the create-flow&apos;s &quot;Build Presenter Blocked
// Slot Payload&quot; and the existing-flow&apos;s &quot;Build Existing Presenter Blocked Slot Payload&quot;.
// When forcedDateStr is provided (the normal case - see fn_planBlockedDays, which decides
// WHICH day each blocked-slot loop iteration belongs to), that exact date is used;
// otherwise (backward-compat / no plan available) a random date inside
// blockFromDate..blockToDate is picked. Builds ONE blocked-slot JSON payload. The
// blockSlotFullDay UDV controls whether the whole day is blocked (00:00:00 -
// 23:59:59) or a partial time window is used instead - in the partial case, the start
// time comes from blockTimes (or a random :00/:30 time if blockTimes is empty) and the
// duration comes from blockDurations (or 30/60 min default if empty). When multiple
// slots are created for the SAME presenter (including multiple slots on the SAME day via
// blockSlotsPerDay &gt; 1), each new slot is retried (up to 30 attempts, varying time/
// duration - the date stays fixed when forcedDateStr is set) against that presenter&apos;s
// previously assigned slots (tracked via the &quot;presenterBlockedIntervals&quot; UDV, reset per
// presenter by the callers) so two slots for one presenter never overlap, even on the
// same day. Comments are picked randomly from a small rotating pool. Sets dynamicPayload
// and returns it.
def _fn_buildBlockedSlotPayload = { varsRef, logRef, presenterLabel, forcedDateStr = null -&gt;
    def fmt = java.time.format.DateTimeFormatter.ISO_LOCAL_DATE
    def fromDateStr = (varsRef.get(&quot;blockFromDate&quot;) ?: &quot;&quot;).trim()
    def toDateStr = (varsRef.get(&quot;blockToDate&quot;) ?: &quot;&quot;).trim()

    if (!fromDateStr || !toDateStr) {
        logRef.warn(&quot;Presenter &quot; + presenterLabel + &quot;: blockFromDate/blockToDate not set - skipping blocked slot creation&quot;)
        varsRef.put(&quot;dynamicPayload&quot;, &quot;{}&quot;)
        return &quot;{}&quot;
    }

    java.time.LocalDate rangeStart = java.time.LocalDate.parse(fromDateStr, fmt)
    java.time.LocalDate rangeEnd = java.time.LocalDate.parse(toDateStr, fmt)
    if (rangeEnd.isBefore(rangeStart)) {
        def tmp = rangeStart; rangeStart = rangeEnd; rangeEnd = tmp
    }

    def rand = java.util.concurrent.ThreadLocalRandom.current()
    long totalDays = java.time.temporal.ChronoUnit.DAYS.between(rangeStart, rangeEnd) + 1

    // blockSlotFullDay flag: if true, EVERY blocked slot is a full-day block, and
    // blockTimes/blockDurations are irrelevant (the whole day is already blocked).
    def blockFullDayFlag = (varsRef.get(&quot;blockSlotFullDay&quot;) ?: &quot;false&quot;).trim().equalsIgnoreCase(&quot;true&quot;)
    boolean blockAllDay = blockFullDayFlag

    // Existing blocked intervals already created for THIS presenter earlier in the same
    // run (reset to empty by the caller at the start of each presenter&apos;s blocking loop -
    // see &quot;presenterBlockedIntervals&quot; in Build Presenter Payload / Load Next Existing
    // Presenter). Format: &quot;yyyy-MM-dd|startSecondOfDay|endSecondOfDay;...&quot;. Used below so a
    // second/third slot for the same presenter never overlaps a slot already assigned to
    // them, even if it lands on the same day.
    def existingIntervals = (varsRef.get(&quot;presenterBlockedIntervals&quot;) ?: &quot;&quot;).split(&quot;;&quot;)*.trim().findAll { it }.collect { entry -&gt;
        def p = entry.split(/\|/)
        [date: p[0], startSec: p[1].toInteger(), endSec: p[2].toInteger()]
    }

    java.time.LocalDate blockDate
    String dateStr
    String startTime, endTime
    int startSec, endSec

    if (blockAllDay) {
        // Full-day block - always exactly 1 slot per chosen day (enforced by the
        // callers), so there is nothing else for it to overlap with on that day.
        blockDate = forcedDateStr ? java.time.LocalDate.parse(forcedDateStr, fmt) : rangeStart.plusDays(rand.nextInt((int) totalDays))
        dateStr = blockDate.format(fmt)
        startTime = &quot;00:00:00&quot;
        endTime = &quot;23:59:59&quot;
        startSec = 0
        endSec = 24 * 3600
    } else {
        int maxAttempts = 30
        boolean found = false
        for (int attempt = 1; attempt &lt;= maxAttempts &amp;&amp; !found; attempt++) {
            blockDate = forcedDateStr ? java.time.LocalDate.parse(forcedDateStr, fmt) : rangeStart.plusDays(rand.nextInt((int) totalDays))
            dateStr = blockDate.format(fmt)

            // ===== Pick a start time =====
            // blockTimes: comma-separated HH:mm values to pick from at random. If empty,
            // generate a random time between 00:00 and 23:30, snapped to the :00/:30 mark
            // only (never arbitrary minutes like :02 or :04).
            def blockTimesStr = (varsRef.get(&quot;blockTimes&quot;) ?: &quot;&quot;).trim()
            java.time.LocalTime startLt
            if (blockTimesStr) {
                def timeOptions = blockTimesStr.split(&quot;,&quot;)*.trim().findAll { it }
                def chosenTime = timeOptions[rand.nextInt(timeOptions.size())]
                try {
                    startLt = java.time.LocalTime.parse(chosenTime, java.time.format.DateTimeFormatter.ofPattern(&quot;H:mm&quot;))
                } catch (Exception e) {
                    logRef.warn(&quot;Presenter &quot; + presenterLabel + &quot;: blockTimes entry &apos;&quot; + chosenTime + &quot;&apos; is not a valid HH:mm time - falling back to a random :00/:30 time&quot;)
                    startLt = null
                }
            }
            if (startLt == null) {
                int totalHalfHourSlots = 48 // 00:00, 00:30, ... 23:30
                int slot = rand.nextInt(totalHalfHourSlots)
                startLt = java.time.LocalTime.of(slot.intdiv(2), (slot % 2) * 30)
            }
            // Snap to :00 or :30 regardless of source, so blockTimes entries like 11:02 or
            // 03:04 never slip through - only :00 or :30 minutes are ever used.
            int snappedMinute = (startLt.getMinute() &lt; 30) ? 0 : 30
            startLt = java.time.LocalTime.of(startLt.getHour(), snappedMinute)

            // ===== Pick a duration =====
            // blockDurations: comma-separated minute values to pick from at random. If
            // empty, default to a mix of 30 and 60 minute blocks.
            def blockDurationsStr = (varsRef.get(&quot;blockDurations&quot;) ?: &quot;&quot;).trim()
            def durationOptions = blockDurationsStr ?
                blockDurationsStr.split(&quot;,&quot;)*.trim().findAll { it }.findResults { it.isInteger() ? it.toInteger() : null } :
                []
            if (!durationOptions) {
                if (blockDurationsStr) {
                    logRef.warn(&quot;Presenter &quot; + presenterLabel + &quot;: blockDurations &apos;&quot; + blockDurationsStr + &quot;&apos; had no valid integers - defaulting to 30,60&quot;)
                }
                durationOptions = [30, 60]
            }
            int durationMinutes = durationOptions[rand.nextInt(durationOptions.size())]

            java.time.LocalDateTime startLdt = java.time.LocalDateTime.of(blockDate, startLt)
            java.time.LocalDateTime endLdt = startLdt.plusMinutes(durationMinutes)
            startTime = startLdt.toLocalTime().toString() + &quot;:00&quot;
            endTime = (endLdt.toLocalDate() == blockDate ? endLdt.toLocalTime().toString() + &quot;:00&quot; : &quot;23:59:59&quot;)
            startSec = startLt.toSecondOfDay()
            endSec = (endLdt.toLocalDate() == blockDate) ? endLdt.toLocalTime().toSecondOfDay() : 24 * 3600

            // Only intervals on the SAME date can possibly overlap. Standard interval
            // overlap test: two ranges [s1,e1) and [s2,e2) overlap iff s1 &lt; e2 AND s2 &lt; e1.
            boolean overlaps = existingIntervals.any { it.date == dateStr &amp;&amp; startSec &lt; it.endSec &amp;&amp; it.startSec &lt; endSec }
            if (!overlaps) {
                found = true
            }
        }
        if (!found) {
            logRef.warn(&quot;Presenter &quot; + presenterLabel + &quot;: could not find a non-overlapping date/time after &quot; + maxAttempts + &quot; attempts - proceeding with the last candidate (it may overlap an earlier slot for this presenter)&quot;)
        }
    }

    // Remember this interval so the NEXT blocked slot for this same presenter (if any) is
    // checked against it too.
    varsRef.put(&quot;presenterBlockedIntervals&quot;,
        ((varsRef.get(&quot;presenterBlockedIntervals&quot;) ?: &quot;&quot;) + (varsRef.get(&quot;presenterBlockedIntervals&quot;) ? &quot;;&quot; : &quot;&quot;) + dateStr + &quot;|&quot; + startSec + &quot;|&quot; + endSec))

    // Rotating pool of realistic comments - one is picked at random per blocked slot.
    def comments = [
    &quot;Vacation&quot;,
    &quot;Annual Leave&quot;,
    &quot;Sick Leave&quot;,
    &quot;Medical Appointment&quot;,
    &quot;Training&quot;,
    &quot;Client Meeting&quot;,
    &quot;Conference Attendance&quot;,
    &quot;Internal Meeting&quot;,
    &quot;Team Offsite&quot;,
    &quot;Travel&quot;,
    &quot;Company Event&quot;,
    &quot;Family Emergency&quot;
    ]
    def comment = comments[rand.nextInt(comments.size())]

    // Use the SAME timezone assigned to this presenter (falls back to clientTimeZone,
    // then UTC, if for some reason it wasn&apos;t set).
    def zone = varsRef.get(&quot;presenterSelectedTimezone&quot;) ?: varsRef.get(&quot;clientTimeZone&quot;) ?: &quot;UTC&quot;

    def payload = &quot;{\n&quot; +
        &quot;    \&quot;zone\&quot;: \&quot;&quot; + zone + &quot;\&quot;,\n&quot; +
        &quot;    \&quot;calendarFromDate\&quot;: { \&quot;isoDate\&quot;: \&quot;&quot; + dateStr + &quot;T00:00:00\&quot; },\n&quot; +
        &quot;    \&quot;calendarStartTime\&quot;: { \&quot;isoDate\&quot;: \&quot;&quot; + dateStr + &quot;T&quot; + startTime + &quot;\&quot; },\n&quot; +
        &quot;    \&quot;calendarEndTime\&quot;: { \&quot;isoDate\&quot;: \&quot;&quot; + dateStr + &quot;T&quot; + endTime + &quot;\&quot; },\n&quot; +
        &quot;    \&quot;calendarToDate\&quot;: { \&quot;isoDate\&quot;: \&quot;&quot; + dateStr + &quot;T00:00:00\&quot; },\n&quot; +
        &quot;    \&quot;blockAllDay\&quot;: &quot; + blockAllDay + &quot;,\n&quot; +
        &quot;    \&quot;calendarType\&quot;: \&quot;MAINTENANCE\&quot;,\n&quot; +
        &quot;    \&quot;comments\&quot;: \&quot;&quot; + comment + &quot;\&quot;\n&quot; +
        &quot;}&quot;

    varsRef.put(&quot;dynamicPayload&quot;, payload)
    logRef.info(&quot;Presenter &quot; + presenterLabel + &quot;: blocked slot date=&quot; + dateStr + &quot; allDay=&quot; + blockAllDay + &quot; comment=&quot; + comment)
    return payload
}
props.put(&quot;fn_buildBlockedSlotPayload&quot;, _fn_buildBlockedSlotPayload)</stringProp>
