        <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="API Field Variables" enabled="false">
          <collectionProp name="Arguments.arguments">
            <elementProp name="categoryType" elementType="Argument">
              <stringProp name="Argument.name">categoryType</stringProp>
              <stringProp name="Argument.value">/${contextname}/api/categorytypes</stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
              <stringProp name="Argument.desc">items=_embedded.categoryTypes display=categoryTypeName value=uniqueId ignore=CATEGORY_TYPE_EVENTS header.x-cloud-customerid=field:customerId</stringProp>
            </elementProp>
