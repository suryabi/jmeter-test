          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Topics PostProcessor" enabled="true">
            <stringProp name="script">// Parse Get Topics response (mastertypes/{id}/masters) into topicId_N / topicName_N vars.
// Runs once (this sampler sits outside the Presenter Loop Controller), so the full
// topic list is fetched a single time and reused for every presenter.
def response = prev.getResponseDataAsString()

if (!response || response.trim().isEmpty()) {
    log.warn(&quot;Get Topics: empty response - no topics found&quot;)
    vars.put(&quot;topicId_count&quot;, &quot;0&quot;)
    return
}

def json = new groovy.json.JsonSlurper().parseText(response)

// Supports multiple response formats:
//   - HAL format:    { _embedded: { masters: [...] } }
//   - Simple format: { masters: [...] }
//   - Array format:  [...]
// With ?hierarchy=true the API returns ALL levels (L1...L6) flattened into
// this single list - each master carries its own parent.uniqueId, same as BIQ.jmx.
def topics = json._embedded?.masters ?: json.masters ?: (json instanceof List ? json : [])

def count = 0
topics.each { topic -&gt;
    def data = topic.data ?: topic
    // FIX (mirrors BIQ.jmx): uniqueId is always at the TOP-LEVEL master object,
    // never inside data. Checking data first previously returned wrong/null ids
    // and made parent-child linking impossible.
    def uniqueId = (topic.uniqueId ?: topic.id ?: data.uniqueId ?: data.id)?.toString()?.trim()
    if (!uniqueId) {
        return
    }
    count++
    def displayName = (topic.metaData?.searchDisplayText ?:
                      data.searchDisplayText ?:
                      data.displayName ?:
                      data.masterName ?:
                      data.name ?:
                      topic.displayName ?:
                      topic.name ?:
                      uniqueId)?.toString()?.trim()

    // Parent id identifies where this topic sits in the hierarchy - a topic whose
    // id never shows up as another topic&apos;s parentId is a leaf (deepest level).
    def parentId = (topic?.parent?.uniqueId ?: topic?.parent?.id)?.toString()?.trim() ?: &quot;&quot;

    vars.put(&quot;topicId_&quot; + count, uniqueId)
    vars.put(&quot;topicName_&quot; + count, displayName)
    vars.put(&quot;topicParentId_&quot; + count, parentId)
}

vars.put(&quot;topicId_count&quot;, count.toString())
log.info(&quot;Get Topics: loaded &quot; + count + &quot; topic(s) across all hierarchy levels&quot;)</stringProp>
