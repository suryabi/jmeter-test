          </HTTPSamplerProxy>
          <hashTree>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Form Template PostProcessor" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput

def response = prev.getResponseDataAsString()
def json = new JsonSlurper().parseText(response)

def templateConfig = json?.templateConfig ?: [:]

// Flatten every SECTION&apos;s formControls across every top-level key
// (meeting-details, presenter-details, hold-details, ...) into one list.
// Each control is tagged with the sectionKey it came from and that
// section&apos;s &quot;apiId&quot; (e.g. &quot;meeting&quot;, &quot;presenters&quot;, &quot;holdRemarks&quot;) -
// the apiId is what Update Meeting uses to know which part of the payload
// a control&apos;s &quot;dataMapping&quot; belongs under.
def controls = []
def sectionApiIds = [:]

// A section with isDocumentTemplate:true (e.g. &quot;meeting-document-details&quot;) has
// no formControls of its own - it just tells us whether THIS event&apos;s form
// actually has a Documents tab at all, and which doc names are restricted.
def hasDocumentSection = templateConfig.any { sectionKey, sectionDef -&gt;
    sectionDef?.isDocumentTemplate == true
}
def documentRestrictedList = []
templateConfig.each { sectionKey, sectionDef -&gt;
    if (sectionDef?.isDocumentTemplate == true) {
        documentRestrictedList = sectionDef?.restrictedDocList ?: []
    }
}

templateConfig.each { sectionKey, sectionDef -&gt;
    def apiId = sectionDef?.apiId
    if (apiId) {
        sectionApiIds[sectionKey] = apiId
    }

    // meeting-document-details (and any other non-form section) has no
    // &quot;config&quot; array of form controls - skip it.
    def sectionConfigs = sectionDef?.config ?: []

    sectionConfigs.each { block -&gt;
        if (block?.elementType != &quot;SECTION&quot;) {
            return
        }
        def formControls = block?.formControls ?: []
        formControls.each { fc -&gt;
            if (fc?.elementType != &quot;FORMCONTROL&quot;) {
                return
            }
            if (!fc?.dataMapping) {
                // A control with no dataMapping has nothing to send to the
                // update API (nothing to key the payload attribute on).
                return
            }
            // Keep only the piece of each dependentControls entry that
            // Update Meeting needs to evaluate real conditional visibility:
            // which control it targets (by formControlName) and the
            // evalValue/evalCondition that decides whether that control is
            // hidden, once THIS control (the parent) has a resolved value.
            def dependents = (fc?.dependentControls ?: []).findAll { dep -&gt;
                dep?.formControlName &amp;&amp; dep?.rules?.hide?.condition
            }.collect { dep -&gt;
                [
                    formControlName    : dep.formControlName,
                    removeModelIfHidden: dep?.removeModelIfHidden ?: false,
                    evalValue          : dep.rules.hide.condition.evalValue,
                    evalCondition      : dep.rules.hide.condition.evalCondition
                ]
            }

            controls &lt;&lt; [
                sectionKey       : sectionKey,
                apiId            : apiId,
                sectionTitle     : block?.sectionConfig?.title,
                displayName      : fc?.displayName,
                dataMapping      : fc?.dataMapping,
                formControlName  : fc?.formControlName,
                formControlType  : fc?.formControlType,
                dropdownEnum     : fc?.dropdownEnum,
                dropdownEnumType : fc?.dropdownEnumType,
                dropdownLookupType: fc?.dropdownLookupType,
                multiSelect      : fc?.multiSelect,
                disabled         : fc?.disabled,
                // &quot;hide&quot; true means the control starts hidden and only
                // appears once a sibling control&apos;s dependentControls rule
                // reveals it (e.g. &quot;Other Account Type&quot; only shows once
                // Account Type == &quot;Other&quot;). Used as the DEFAULT visibility
                // for a control; &quot;Update Meeting PreProcessor&quot; overrides it
                // once it evaluates the actual driving control&apos;s value via
                // &quot;dependents&quot; below.
                hide             : fc?.hide ?: false,
                // If true and this control ends up hidden, its key is left
                // OUT of the payload entirely instead of being sent as null
                // (e.g. Presenter First/Last Name when &quot;Others&quot; isn&apos;t picked).
                removeModelIfHidden: fc?.removeModelIfHidden ?: false,
                // Controls THIS control&apos;s value hides/shows, evaluated once
                // this control has a resolved value.
                dependents       : dependents,
                validators       : fc?.validators ?: []
            ]
        }
    }
}

vars.put(&quot;formTemplateControlsJson&quot;, JsonOutput.toJson(controls))
vars.put(&quot;formTemplateSectionApiIdsJson&quot;, JsonOutput.toJson(sectionApiIds))
vars.put(&quot;formTemplateControlsCount&quot;, controls.size().toString())
vars.put(&quot;hasDocumentSection&quot;, hasDocumentSection.toString())
vars.put(&quot;documentRestrictedListJson&quot;, JsonOutput.toJson(documentRestrictedList))
log.info(&quot;Form Template: flattened &quot; + controls.size() + &quot; form control(s) across section(s) &quot; + sectionApiIds)
log.info(&quot;Form Template: hasDocumentSection=&quot; + hasDocumentSection + &quot; restrictedDocList=&quot; + documentRestrictedList)</stringProp>
            </JSR223PostProcessor>
