            <hashTree/>
            <com.atlantbh.jmeter.plugins.jsonutils.jsonformatter.JSONFormatter guiclass="com.atlantbh.jmeter.plugins.jsonutils.jsonformatter.gui.JSONFormatterGui" testclass="com.atlantbh.jmeter.plugins.jsonutils.jsonformatter.JSONFormatter" testname="jp@gc - JSON Format Post Processor" enabled="true"/>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Lookup Values PostProcessor" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput

def response = prev.getResponseDataAsString()
def json = new JsonSlurper().parseText(response)

def allValues = json?._embedded?.lookupValues ?: json?._embedded?.lookupvalues ?: json?._embedded?.values ?: (json instanceof List ? json : [])

// Confirmed against the real /lookupvalues response: each entry carries
// its lookup type name directly as &quot;lookupTypeName&quot; (e.g. ACCOUNT_TYPE /
// REGION / INDUSTRY / LINE_OF_BUSINESS / YES_NO / PRESENTER_STATUS /
// HOLD_STATUS_REMARKS / MEETING_FOCUS / MEETING_TYPE ...), which is what
// the form template&apos;s &quot;dropdownEnum&quot; matches against. &quot;code&quot; is the raw
// value sent back to the API, &quot;value&quot; is the human-readable label shown
// in the UI.
def byType = [:]

allValues.each { v -&gt;
    def typeId = (v?.lookupTypeName ?: v?.lookupType?.code ?: v?.lookupType?.uniqueId)?.toString()
    if (!typeId) {
        return
    }
    def code = (v?.code ?: v?.value ?: v?.uniqueId)?.toString()
    def label = (v?.value ?: v?.code)?.toString()
    if (code) {
        def bucket = byType.get(typeId)
        if (bucket == null) {
            bucket = []
            byType.put(typeId, bucket)
        }
        // Store full original entry to check for parent references later
        bucket &lt;&lt; [code: code, label: label, parentCode: v?.parentCode, parentId: v?.parentId, lineOfBusiness: v?.lineOfBusiness]
    }
}

vars.put(&quot;lookupValuesByTypeJson&quot;, JsonOutput.toJson(byType))
log.info(&quot;Lookup Values: grouped &quot; + allValues.size() + &quot; entries into &quot; + byType.size() + &quot; lookup type(s) -&gt; &quot; + byType.keySet())

// Diagnostic: code and label are supposed to be interchangeable for most
// lookup entries (many backends just reuse the display text as the raw
// code), but catch-all entries like &quot;Other&quot; often have a distinct internal
// code (e.g. OTHER / OTH / 99) that does not match the display word. If the
// API silently rejects a value it doesn&apos;t recognize, sending the label
// instead of the code for exactly these entries would explain a selection
// that never saves. Log every entry whose label/code differ so mismatches
// are easy to spot in the results log, calling out &quot;other&quot;-like ones.
byType.each { typeId, entries -&gt;
    entries.each { e -&gt;
        if (e.code != e.label) {
            def flag = (e.label?.toString()?.trim()?.equalsIgnoreCase(&quot;Other&quot;)) ? &quot; &lt;-- OTHER&quot; : &quot;&quot;
            log.info(&quot;Lookup Values: &quot; + typeId + &quot; code=&apos;&quot; + e.code + &quot;&apos; label=&apos;&quot; + e.label + &quot;&apos; (mismatch)&quot; + flag)
        }
    }
}

// --- kept for the existing &quot;Get Vacant Slots&quot; flow, which randomly picks
// one of these meeting durations per meeting (see &quot;Select Room And
// Duration For Meeting&quot; preprocessor) ---
def durationEntries = byType[&quot;MEETING_DURATION&quot;] ?: byType[&quot;MEETINGDURATION&quot;] ?: byType[&quot;DURATION&quot;] ?: []
def lookupDurations = durationEntries.collect { it.code }.findAll { it != null &amp;&amp; it.isInteger() }

// The &quot;meetingDurations&quot; UDV (e.g. &quot;30,60&quot;) is the SOURCE OF TRUTH for which
// durations may be booked. Previously it was ignored: every lookup value
// (including 15) was eligible, and the UDV was overwritten with the pick.
// The pick now lives in &quot;selectedMeetingDuration&quot;, so the UDV stays intact.
def configured = (vars.get(&quot;meetingDurations&quot;) ?: &quot;&quot;).split(&quot;,&quot;).collect { it.trim() }.findAll { it &amp;&amp; it.isInteger() }
def durations
if (configured) {
    durations = configured
    if (lookupDurations) {
        def unknown = configured.findAll { !(it in lookupDurations) }
        if (unknown) {
            log.warn(&quot;Lookup Values: configured meetingDurations &quot; + unknown + &quot; are not in the MEETING_DURATION lookup &quot; + lookupDurations + &quot; - using them anyway.&quot;)
        }
    }
    log.info(&quot;Lookup Values: using configured meetingDurations &quot; + durations)
} else if (lookupDurations) {
    durations = lookupDurations
    log.info(&quot;Lookup Values: meetingDurations UDV empty - using lookup durations &quot; + durations)
} else {
    // Last-resort fallback so the flow still works.
    durations = [&quot;30&quot;]
    log.warn(&quot;Lookup Values: no meetingDurations configured and no MEETING_DURATION lookup entries - falling back to &quot; + durations)
}

vars.put(&quot;meetingDurationCount&quot;, durations.size().toString())
durations.eachWithIndex { d, idx -&gt;
    vars.put(&quot;meetingDuration_${idx}&quot;, d)
}</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
