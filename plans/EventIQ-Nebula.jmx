                        <stringProp name="cacheKey">true</stringProp>
                        <stringProp name="script">import org.apache.jmeter.protocol.http.util.HTTPArgument

// Remove Content-Type inherited from the top-level HTTP Header Manager
// (application/json) - it would otherwise collide with the multipart
// boundary Content-Type JMeter sets for this file upload.
def hm = sampler.getHeaderManager()
if (hm != null) {
    for (int i = hm.size() - 1; i &gt;= 0; i--) {
        if (hm.get(i).getName().equalsIgnoreCase(&quot;Content-Type&quot;)) {
            hm.remove(i)
        }
    }
}

sampler.getArguments().clear()

def uploadTypeArg = new HTTPArgument(&quot;uploadType&quot;, vars.get(&quot;documentUploadTypeId&quot;) ?: &quot;&quot;)
uploadTypeArg.setAlwaysEncoded(false)
sampler.getArguments().addArgument(uploadTypeArg)

def documentInfoArg = new HTTPArgument(&quot;documentInfo&quot;, vars.get(&quot;documentInfoJson&quot;) ?: &quot;{}&quot;)
documentInfoArg.setAlwaysEncoded(false)
documentInfoArg.setContentType(&quot;application/json&quot;)
sampler.getArguments().addArgument(documentInfoArg)</stringProp>
