<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.4.1">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="EventIQ" enabled="true">
      <boolProp name="TestPlan.serialize_threadgroups">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <stringProp name="TestPlan.comments"></stringProp>
      <stringProp name="TestPlan.user_define_classpath"></stringProp>
    </TestPlan>
    <hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="EIQ Request Flow(Nebula)" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">1</stringProp>
        <stringProp name="ThreadGroup.ramp_time">1</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <stringProp name="ThreadGroup.duration"></stringProp>
        <stringProp name="ThreadGroup.delay"></stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
      </ThreadGroup>
      <hashTree>
        <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="API Field Variables" enabled="false">
          <collectionProp name="Arguments.arguments">
            <elementProp name="eventId" elementType="Argument">
              <stringProp name="Argument.name">eventId</stringProp>
              <stringProp name="Argument.value">/${contextname}/api/events</stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
              <stringProp name="Argument.desc">items=_embedded.events display=eventName value=eventId header.x-cloud-customerid=field:customerId</stringProp>
            </elementProp>
            <elementProp name="eventDayId" elementType="Argument">
              <stringProp name="Argument.name">eventDayId</stringProp>
              <stringProp name="Argument.value">/${contextname}/api/events/${eventId}/eventdates</stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
              <stringProp name="Argument.desc">items= display=eventDate value=eventDateId depends=eventId</stringProp>
            </elementProp>
          </collectionProp>
        </Arguments>
        <hashTree/>
        <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="Insight Fields" enabled="false">
          <collectionProp name="Arguments.arguments">
            <elementProp name="meetingOpen" elementType="Argument">
              <stringProp name="Argument.name">meetingOpen</stringProp>
              <stringProp name="Argument.value"></stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
              <stringProp name="Argument.desc">kind=scope_open entity=meeting match=`Meeting (\d+)/(\d+) Creation Started` index=$1 total=$2 status=started stepLabel=`Meeting $1/$2 creation started` stepStatus=info</stringProp>
            </elementProp>
            <elementProp name="eventInfo" elementType="Argument">
              <stringProp name="Argument.name">eventInfo</stringProp>
              <stringProp name="Argument.value"></stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
              <stringProp name="Argument.desc">kind=run_field match=`Event:\s*(.+)` set=eventName group=1</stringProp>
            </elementProp>
            <elementProp name="stepEventValidation" elementType="Argument">
              <stringProp name="Argument.name">stepEventValidation</stringProp>
              <stringProp name="Argument.value"></stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
              <stringProp name="Argument.desc">kind=step scope=run match=`Get Events: matched eventId` label=`Event validated` status=info</stringProp>
            </elementProp>
            <elementProp name="meetingEventDate" elementType="Argument">
              <stringProp name="Argument.name">meetingEventDate</stringProp>
              <stringProp name="Argument.value"></stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
              <stringProp name="Argument.desc">kind=field entity=meeting match=`Event Date:\s*(\d{4}-\d{2}-\d{2})` set=eventDate group=1</stringProp>
            </elementProp>
            <elementProp name="meetingCustomer" elementType="Argument">
              <stringProp name="Argument.name">meetingCustomer</stringProp>
              <stringProp name="Argument.value"></stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
              <stringProp name="Argument.desc">kind=field entity=meeting match=`Account Name:\s*(.+)` set=accountName group=1</stringProp>
            </elementProp>
            <elementProp name="meetingAccountName" elementType="Argument">
              <stringProp name="Argument.name">meetingAccountName</stringProp>
              <stringProp name="Argument.value"></stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
              <stringProp name="Argument.desc">kind=field entity=meeting match=`fn_accountName:.+customer=&apos;([^&apos;]+)&apos;` set=accountName group=1 onlyIfEmpty=true</stringProp>
            </elementProp>
            <elementProp name="meetingLocation" elementType="Argument">
              <stringProp name="Argument.name">meetingLocation</stringProp>
              <stringProp name="Argument.value"></stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
              <stringProp name="Argument.desc">kind=field entity=meeting match=`Location:\s*(.+)` set=locationName group=1</stringProp>
            </elementProp>
            <elementProp name="meetingRoom" elementType="Argument">
              <stringProp name="Argument.name">meetingRoom</stringProp>
              <stringProp name="Argument.value"></stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
              <stringProp name="Argument.desc">kind=field entity=meeting match=`Room:\s*(.+)` set=roomName group=1</stringProp>
            </elementProp>
            <elementProp name="meetingCreated" elementType="Argument">
              <stringProp name="Argument.name">meetingCreated</stringProp>
              <stringProp name="Argument.value"></stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
              <stringProp name="Argument.desc">kind=field entity=meeting match=`Create Meeting.*Status:\s*SUCCESS` set=status value=created</stringProp>
            </elementProp>
            <elementProp name="stepMeetingCreated" elementType="Argument">
              <stringProp name="Argument.name">stepMeetingCreated</stringProp>
              <stringProp name="Argument.value"></stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
              <stringProp name="Argument.desc">kind=step scope=meeting match=`Create Meeting.*Status:\s*SUCCESS` label=`Meeting $index/$total: $accountName created` status=success</stringProp>
            </elementProp>
            <elementProp name="meetingFailed" elementType="Argument">
              <stringProp name="Argument.name">meetingFailed</stringProp>
              <stringProp name="Argument.value"></stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
              <stringProp name="Argument.desc">kind=field entity=meeting match=`Create Meeting.*Status:\s*FAILED` set=status value=failed</stringProp>
            </elementProp>
            <elementProp name="stepMeetingFailed" elementType="Argument">
              <stringProp name="Argument.name">stepMeetingFailed</stringProp>
              <stringProp name="Argument.value"></stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
              <stringProp name="Argument.desc">kind=step scope=meeting match=`Create Meeting.*Status:\s*FAILED` label=`Meeting $index/$total: creation failed` status=failed</stringProp>
            </elementProp>
            <elementProp name="meetingStartTime" elementType="Argument">
              <stringProp name="Argument.name">meetingStartTime</stringProp>
              <stringProp name="Argument.value"></stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
              <stringProp name="Argument.desc">kind=field entity=meeting match=`Start Time:\s*(\d{2}:\d{2})` set=startTime group=1</stringProp>
            </elementProp>
            <elementProp name="meetingEndTime" elementType="Argument">
              <stringProp name="Argument.name">meetingEndTime</stringProp>
              <stringProp name="Argument.value"></stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
              <stringProp name="Argument.desc">kind=field entity=meeting match=`End Time:\s*(\d{2}:\d{2})` set=endTime group=1</stringProp>
            </elementProp>
            <elementProp name="meetingDuration" elementType="Argument">
              <stringProp name="Argument.name">meetingDuration</stringProp>
              <stringProp name="Argument.value"></stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
              <stringProp name="Argument.desc">kind=field entity=meeting match=`Duration:\s*(\d+)\s*min` set=durationMinutes group=1</stringProp>
            </elementProp>
            <elementProp name="meetingId" elementType="Argument">
              <stringProp name="Argument.name">meetingId</stringProp>
              <stringProp name="Argument.value"></stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
              <stringProp name="Argument.desc">kind=field entity=meeting match=`Meeting ID:\s*([0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12})` set=meetingId group=1</stringProp>
            </elementProp>
            <elementProp name="meetingStatus" elementType="Argument">
              <stringProp name="Argument.name">meetingStatus</stringProp>
              <stringProp name="Argument.value"></stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
              <stringProp name="Argument.desc">kind=field entity=meeting match=`Meeting Status:\s*(\w+)` set=meetingStatus group=1</stringProp>
            </elementProp>
            <elementProp name="stepMeetingUpdate" elementType="Argument">
              <stringProp name="Argument.name">stepMeetingUpdate</stringProp>
              <stringProp name="Argument.value"></stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
              <stringProp name="Argument.desc">kind=step scope=meeting match=`Update Meeting.*Status:\s*SUCCESS` label=`Meeting $index/$total: updated` status=success</stringProp>
            </elementProp>
            <elementProp name="stepMeetingStatus" elementType="Argument">
              <stringProp name="Argument.name">stepMeetingStatus</stringProp>
              <stringProp name="Argument.value"></stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
              <stringProp name="Argument.desc">kind=step scope=meeting match=`Meeting Status:\s*(\w+)` label=`Meeting $index/$total: status changed to $1` status=success</stringProp>
            </elementProp>
            <elementProp name="runEventFallback" elementType="Argument">
              <stringProp name="Argument.name">runEventFallback</stringProp>
              <stringProp name="Argument.value"></stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
              <stringProp name="Argument.desc">kind=field entity=run match=`Event:\s*(.+)` set=eventName group=1 onlyIfEmpty=true</stringProp>
            </elementProp>
            <elementProp name="runMeetingIdFallback" elementType="Argument">
              <stringProp name="Argument.name">runMeetingIdFallback</stringProp>
              <stringProp name="Argument.value"></stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
              <stringProp name="Argument.desc">kind=field entity=run match=`Meeting ID:\s*([0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12})` set=meetingId group=1 onlyIfEmpty=true</stringProp>
            </elementProp>
            <elementProp name="stepEventDay" elementType="Argument">
              <stringProp name="Argument.name">stepEventDay</stringProp>
              <stringProp name="Argument.value"></stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
              <stringProp name="Argument.desc">kind=step scope=run match=`Event Day:\s*([^|]+)$` label=`Event Day: $1` status=info</stringProp>
            </elementProp>
            <elementProp name="meetingSummary" elementType="Argument">
              <stringProp name="Argument.name">meetingSummary</stringProp>
              <stringProp name="Argument.value"></stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
              <stringProp name="Argument.desc">kind=summary entity=meeting field=status counts=created,failed,started</stringProp>
            </elementProp>
            <elementProp name="uiMeetingList" elementType="Argument">
