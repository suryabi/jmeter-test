          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Get All Locations" enabled="true">
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
              <collectionProp name="Arguments.arguments">
                <elementProp name="isActive" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">true</boolProp>
                  <stringProp name="Argument.value">true</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                  <boolProp name="HTTPArgument.use_equals">true</boolProp>
                  <stringProp name="Argument.name">isActive</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
            <stringProp name="HTTPSampler.domain">${host}</stringProp>
            <stringProp name="HTTPSampler.port">${port}</stringProp>
            <stringProp name="HTTPSampler.protocol">${protocol}</stringProp>
            <stringProp name="HTTPSampler.contentEncoding"></stringProp>
            <stringProp name="HTTPSampler.path">/${contextname}/api/events/${eventId}/locations</stringProp>
            <stringProp name="HTTPSampler.method">GET</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
            <stringProp name="HTTPSampler.embedded_url_re"></stringProp>
            <stringProp name="HTTPSampler.connect_timeout"></stringProp>
            <stringProp name="HTTPSampler.response_timeout"></stringProp>
          </HTTPSamplerProxy>
          <hashTree>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Location PostProcessor" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper

def response = prev.getResponseDataAsString()
def json = new JsonSlurper().parseText(response)
def locations = json._embedded.locations

log.info(&quot;Get Locations: API returned &quot; + locations.size() + &quot; location(s)&quot;)

// Log location types for debugging
locations.each { loc -&gt;
    log.info(&quot;Get Locations: location name=&quot; + loc.name + &quot;, uniqueId=&quot; + loc.uniqueId + &quot;, locationType.uniqueId=&quot; + loc.locationType?.uniqueId + &quot;, locationTypeId=&quot; + loc.locationTypeId)
}

// Separate venues (EVENT_LOCATION) from rooms (all other location types)
// Handle both locationType.uniqueId and locationTypeId formats
def eventLocations = locations.findAll {
    def typeId = it.locationType?.uniqueId ?: it.locationTypeId
    typeId == &quot;EVENT_LOCATION&quot;
}
def rooms = locations.findAll {
    def typeId = it.locationType?.uniqueId ?: it.locationTypeId
    typeId != &quot;EVENT_LOCATION&quot; &amp;&amp; typeId != null
}

log.info(&quot;Get Locations: found &quot; + eventLocations.size() + &quot; venue(s) and &quot; + rooms.size() + &quot; room(s) after filtering&quot;)

vars.put(&quot;eventLocationCount&quot;, eventLocations.size().toString())

eventLocations.eachWithIndex { loc, idx -&gt;
    vars.put(&quot;eventLocation_${idx}_id&quot;, loc.uniqueId)
    vars.put(&quot;eventLocation_${idx}_name&quot;, loc.name)
}

// Build the flat room list directly from the first API call - no need for additional calls
vars.put(&quot;totalRoomCount&quot;, rooms.size().toString())

rooms.eachWithIndex { room, idx -&gt;
    vars.put(&quot;allRoom_${idx}_id&quot;, room.uniqueId)
    vars.put(&quot;allRoom_${idx}_name&quot;, room.name)
    // Store parent venue info - note: parent field might not exist in response
    def parentId = &quot;&quot;
    def parentName = &quot;&quot;

    // Check different possible parent field structures
    if (room.parent?.uniqueId) {
        parentId = room.parent.uniqueId
        parentName = room.parent.name ?: &quot;&quot;
    } else if (room.parentId) {
        parentId = room.parentId
    } else if (room.locationId) {
        parentId = room.locationId
    }

    vars.put(&quot;allRoom_${idx}_locationId&quot;, parentId)
    vars.put(&quot;allRoom_${idx}_locationName&quot;, parentName)

    log.info(&quot;Room ${idx}: id=${room.uniqueId}, name=${room.name}, parentId=${parentId}&quot;)
}

log.info(&quot;Get Locations: found &quot; + eventLocations.size() + &quot; venue(s) and &quot; + rooms.size() + &quot; room(s)&quot;)

// Default pick: first room, for backward compatibility
if (rooms) {
    vars.put(&quot;locationId&quot;, rooms[0].uniqueId)
    vars.put(&quot;locationName&quot;, rooms[0].name)
} else {
    log.warn(&quot;Get Locations: no rooms found for eventId=&quot; + vars.get(&quot;eventId&quot;))
}
</stringProp>
