            <elementProp name="eventDayId" elementType="Argument">
              <stringProp name="Argument.name">eventDayId</stringProp>
              <stringProp name="Argument.value"></stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
              <stringProp name="Argument.desc">DROPDOWN, API, LABEL=eventDay. Select a specific event day to create meetings only on that day, or leave empty to create meetings on each event day</stringProp>
            </elementProp>
            <elementProp name="meetings" elementType="Argument">
              <stringProp name="Argument.name">meetings</stringProp>
              <stringProp name="Argument.value">1</stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
              <stringProp name="Argument.desc">REQUIRED, LABEL=NoOfMeetings. Number of meetings to create on each event day. If a specific event day is selected, the specified number of meetings will be created on that day</stringProp>
            </elementProp>
            <elementProp name="meetingDurations" elementType="Argument">
              <stringProp name="Argument.name">meetingDurations</stringProp>
              <stringProp name="Argument.value">30,60</stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
              <stringProp name="Argument.desc">REQUIRED, LABEL=meetingDuration. Meeting duration in minutes (comma-separated)</stringProp>
            </elementProp>
            <elementProp name="loggedInUser" elementType="Argument">
              <stringProp name="Argument.name">loggedInUser</stringProp>
              <stringProp name="Argument.value">supportuser@briefingiq.com</stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
              <stringProp name="Argument.desc">REQUIRED, LABEL=user. Email address of the logged-in user</stringProp>
            </elementProp>
            <elementProp name="meetingStatus" elementType="Argument">
              <stringProp name="Argument.name">meetingStatus</stringProp>
              <stringProp name="Argument.value">CONFIRM</stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
              <stringProp name="Argument.desc">LABEL=meetingActions. List of meeting actions. One action will be randomly selected from the list after the submit action</stringProp>
            </elementProp>
          </collectionProp>
        </Arguments>
