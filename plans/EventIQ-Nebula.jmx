                  <hashTree>
                    <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Document Types PostProcessor" enabled="true">
                      <stringProp name="scriptLanguage">groovy</stringProp>
                      <stringProp name="parameters"></stringProp>
                      <stringProp name="filename"></stringProp>
                      <stringProp name="cacheKey">true</stringProp>
                      <stringProp name="script">import groovy.json.JsonSlurper

def response = prev.getResponseDataAsString()
def json = new JsonSlurper().parseText(response)

def types = json?._embedded?.documentTypes ?: []

def restrictedNames = []
try {
    restrictedNames = new JsonSlurper().parseText(vars.get(&quot;documentRestrictedListJson&quot;) ?: &quot;[]&quot;)
} catch (e) {
    restrictedNames = []
}

// PDF-only for now - only consider document types whose mimeTypes list
// actually accepts .pdf.
def pdfEligible = types.findAll { t -&gt;
    (t?.mimeTypes ?: []).any { it?.toString()?.toLowerCase() == &quot;.pdf&quot; }
}

def chosen = null
if (restrictedNames) {
    chosen = pdfEligible.find { t -&gt; restrictedNames.contains(t?.uploadTypeName) }
}
if (!chosen) {
    chosen = pdfEligible ? pdfEligible[0] : null
}

if (chosen) {
    vars.put(&quot;documentUploadTypeId&quot;, chosen.uniqueId ?: &quot;&quot;)
    vars.put(&quot;documentUploadTypeName&quot;, chosen.uploadTypeName ?: &quot;&quot;)
    log.info(&quot;Document Types: selected uploadType=&apos;&quot; + chosen.uploadTypeName + &quot;&apos; (&quot; + chosen.uniqueId + &quot;) for PDF upload&quot;)
} else {
    vars.put(&quot;documentUploadTypeId&quot;, &quot;&quot;)
    vars.put(&quot;documentUploadTypeName&quot;, &quot;&quot;)
    log.warn(&quot;Document Types: no PDF-eligible document type found for this event - skipping document upload&quot;)
}</stringProp>
                    </JSR223PostProcessor>
