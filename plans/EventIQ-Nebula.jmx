          </hashTree>
        </hashTree>
        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="Invalid (Event or EventDay)" enabled="true">
          <stringProp name="IfController.condition">&quot;${eventValid}&quot; != &quot;true&quot; || &quot;${eventDayValid}&quot; != &quot;true&quot;</stringProp>
          <boolProp name="IfController.evaluateAll">false</boolProp>
        </IfController>
        <hashTree>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Skip Meeting Creation" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">SampleResult.setSuccessful(false)
def reason = []
if (vars.get(&quot;eventValid&quot;) != &quot;true&quot;) reason &lt;&lt; &quot;eventId is not valid&quot;
if (vars.get(&quot;eventDayValid&quot;) != &quot;true&quot;) reason &lt;&lt; &quot;eventDayId is not valid&quot;
def msg = &quot;Skipping meeting creation - &quot; + reason.join(&quot; and &quot;)
SampleResult.setResponseMessage(msg)
SampleResult.setResponseData(msg, &quot;UTF-8&quot;)
log.error(msg)</stringProp>
          </JSR223Sampler>
          <hashTree/>
        </hashTree>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
