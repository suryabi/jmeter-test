                  <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Track Created Meeting" enabled="true">
                    <stringProp name="scriptLanguage">groovy</stringProp>
                    <stringProp name="parameters"></stringProp>
                    <stringProp name="filename"></stringProp>
                    <stringProp name="cacheKey">true</stringProp>
                    <stringProp name="script">def meetingIdx = vars.get(&quot;meetingIdx&quot;)
def meetingId = vars.get(&quot;meetingId&quot;)
def locationName = vars.get(&quot;locationName&quot;)

vars.put(&quot;meetingId_&quot; + meetingIdx, meetingId ?: &quot;&quot;)

def createdCount = (vars.get(&quot;createdMeetingCount&quot;) ?: &quot;0&quot;).toInteger()

if (meetingId) {
    createdCount += 1
    vars.put(&quot;createdMeetingCount&quot;, createdCount.toString())
    log.info(&quot;Created meeting #&quot; + (meetingIdx.toInteger() + 1) + &quot; -&gt; meetingId=&quot; + meetingId + &quot; room=&quot; + locationName)
} else {
    log.warn(&quot;Meeting #&quot; + (meetingIdx.toInteger() + 1) + &quot; did not return a meetingId - check the response&quot;)
}

// Show the room and the running created-meeting count right on the sample
// label so it&apos;s visible directly in View Results Tree / Summary Report,
// e.g. &quot;Create Meeting - Alpine (Created 3/10)&quot; instead of just &quot;Create Meeting&quot;.
def perDay = (vars.get(&quot;meetings&quot;) ?: &quot;1&quot;).toInteger()
def inDay = (meetingIdx.toInteger() % perDay) + 1
prev.setSampleLabel(&quot;Create Meeting - &quot; + locationName + &quot; (Day &quot; + vars.get(&quot;dayNumber&quot;) + &quot;/&quot; + vars.get(&quot;matchedEventDateCount&quot;) + &quot;, &quot; + inDay + &quot;/&quot; + perDay + &quot;)&quot;)</stringProp>
                  </JSR223PostProcessor>
