                  <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Meeting Status" enabled="true">
                    <stringProp name="scriptLanguage">groovy</stringProp>
                    <stringProp name="parameters"></stringProp>
                    <stringProp name="filename"></stringProp>
                    <stringProp name="cacheKey">true</stringProp>
                    <stringProp name="script">import groovy.json.JsonSlurper
import java.util.concurrent.ThreadLocalRandom

// ------------------------------------------------------------------
// Pick ONE meeting status (from UDV &quot;meetingStatus&quot;) that the app
// currently allows for this meeting, based on the Get Meeting By Id
// response (_links). The chosen action is called after this sampler.
// ------------------------------------------------------------------

// Reset first so a value from an earlier iteration never leaks through
vars.put(&quot;selectedMeetingStatus&quot;, &quot;&quot;)
vars.put(&quot;hasMeetingStatus&quot;, &quot;false&quot;)

def body = prev.getResponseDataAsString()
if (!body) {
    log.warn(&quot;Select Meeting Status: empty response from Get Meeting By Id - no status selected&quot;)
    return
}

def json
try {
    json = new JsonSlurper().parseText(body)
} catch (Exception e) {
    log.error(&quot;Select Meeting Status: response is not valid JSON - &quot; + e.getMessage())
    return
}

// Current status of the meeting, e.g. SUBMITTED
def currentStatus = (json.statusCode ?: &quot;&quot;).toString()
vars.put(&quot;currentMeetingStatus&quot;, currentStatus)

// Actions the app allows right now = keys of _links (CONFIRM, HOLD, CANCEL, ...)
def availableActions = []
if (json._links instanceof Map) {
    availableActions = json._links.keySet().collect { it.toString().trim().toUpperCase() }
}

// Statuses configured in UDV, e.g. &quot;CONFIRM, HOLD&quot; -&gt; [CONFIRM, HOLD]
def requested = (vars.get(&quot;meetingStatus&quot;) ?: &quot;&quot;)
        .split(&quot;,&quot;)
        .collect { it.trim().toUpperCase() }
        .findAll { it }
        .unique()

// Only keep the configured statuses that are actually available for this meeting
def eligible = requested.findAll { availableActions.contains(it) }

if (eligible.isEmpty()) {
    log.warn(&quot;Select Meeting Status: none of &quot; + requested + &quot; is available for meeting &quot;
            + vars.get(&quot;meetingId&quot;) + &quot; (current status=&quot; + currentStatus
            + &quot;, available=&quot; + availableActions + &quot;) - status call will be skipped&quot;)
    return
}

// Randomly select exactly one of the eligible statuses
def selected = eligible[ThreadLocalRandom.current().nextInt(eligible.size())]

vars.put(&quot;selectedMeetingStatus&quot;, selected)
vars.put(&quot;hasMeetingStatus&quot;, &quot;true&quot;)

log.info(&quot;Select Meeting Status: meetingId=&quot; + vars.get(&quot;meetingId&quot;)
        + &quot; current=&quot; + currentStatus + &quot; configured=&quot; + requested
        + &quot; eligible=&quot; + eligible + &quot; -&gt; selected=&quot; + selected)
</stringProp>
                  </JSR223PostProcessor>
                  <hashTree/>
                  <com.atlantbh.jmeter.plugins.jsonutils.jsonformatter.JSONFormatter guiclass="com.atlantbh.jmeter.plugins.jsonutils.jsonformatter.gui.JSONFormatterGui" testclass="com.atlantbh.jmeter.plugins.jsonutils.jsonformatter.JSONFormatter" testname="jp@gc - JSON Format Post Processor" enabled="true"/>
                  <hashTree/>
                </hashTree>
                <IfController guiclass="IfControllerPanel" testclass="IfController" testname="Status Action Available" enabled="true">
                  <stringProp name="IfController.condition">&quot;${hasMeetingStatus}&quot; == &quot;true&quot;</stringProp>
                  <boolProp name="IfController.evaluateAll">false</boolProp>
                </IfController>
                <hashTree>
                  <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="${selectedMeetingStatus} Meeting" enabled="true">
                    <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
                    <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
                      <collectionProp name="Arguments.arguments">
                        <elementProp name="" elementType="HTTPArgument">
                          <boolProp name="HTTPArgument.always_encode">false</boolProp>
                          <stringProp name="Argument.value">{}</stringProp>
                          <stringProp name="Argument.metadata">=</stringProp>
                        </elementProp>
                      </collectionProp>
                    </elementProp>
                    <stringProp name="HTTPSampler.domain">${host}</stringProp>
                    <stringProp name="HTTPSampler.port">${port}</stringProp>
                    <stringProp name="HTTPSampler.protocol">${protocol}</stringProp>
                    <stringProp name="HTTPSampler.contentEncoding"></stringProp>
                    <stringProp name="HTTPSampler.path">/${contextname}/api/meetings/${meetingId}/actions/${selectedMeetingStatus}?sendNotification=false</stringProp>
                    <stringProp name="HTTPSampler.method">PUT</stringProp>
                    <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
                    <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
                    <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
                    <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
                    <stringProp name="HTTPSampler.embedded_url_re"></stringProp>
                    <stringProp name="HTTPSampler.connect_timeout"></stringProp>
                    <stringProp name="HTTPSampler.response_timeout"></stringProp>
                  </HTTPSamplerProxy>
                  <hashTree>
                    <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header Manager" enabled="true">
                      <collectionProp name="HeaderManager.headers">
                        <elementProp name="" elementType="Header">
                          <stringProp name="Header.name">x-cloud-customerid</stringProp>
                          <stringProp name="Header.value">${customerId}</stringProp>
                        </elementProp>
                        <elementProp name="" elementType="Header">
                          <stringProp name="Header.name">x-cloud-categorytypeid</stringProp>
                          <stringProp name="Header.value">${categoryTypeId}</stringProp>
                        </elementProp>
                        <elementProp name="" elementType="Header">
                          <stringProp name="Header.name">x-cloud-categoryid</stringProp>
                          <stringProp name="Header.value">${categoryId}</stringProp>
                        </elementProp>
                        <elementProp name="" elementType="Header">
                          <stringProp name="Header.name">x-cloud-eventid</stringProp>
                          <stringProp name="Header.value">${eventId}</stringProp>
                        </elementProp>
                      </collectionProp>
                    </HeaderManager>
                    <hashTree/>
                    <com.atlantbh.jmeter.plugins.jsonutils.jsonformatter.JSONFormatter guiclass="com.atlantbh.jmeter.plugins.jsonutils.jsonformatter.gui.JSONFormatterGui" testclass="com.atlantbh.jmeter.plugins.jsonutils.jsonformatter.JSONFormatter" testname="jp@gc - JSON Format Post Processor" enabled="true"/>
                    <hashTree/>
