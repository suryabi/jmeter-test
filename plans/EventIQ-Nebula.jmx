        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Common Function" enabled="true">
          <stringProp name="script">SampleResult.setIgnore()

// Fake account names used to populate customer/account name fields.
props.put(&quot;data_allCustomers&quot;, [
    &quot;Airbus&quot;, &quot;American Airlines&quot;, &quot;Boeing&quot;, &quot;British Airways&quot;, &quot;Cathay Pacific&quot;,
    &quot;Delta Air Lines&quot;, &quot;Emirates&quot;, &quot;Etihad Airways&quot;, &quot;IndiGo&quot;, &quot;Japan Airlines&quot;,
    &quot;Lufthansa&quot;, &quot;Qantas Airways&quot;, &quot;Singapore Airlines&quot;, &quot;Southwest Airlines&quot;,
    &quot;Turkish Airlines&quot;, &quot;United Airlines&quot;, &quot;Korean Air&quot;, &quot;Air Canada&quot;, &quot;Air France&quot;,
    &quot;Alaska Airlines&quot;, &quot;JetBlue&quot;, &quot;Vistara&quot;, &quot;SpiceJet&quot;, &quot;Air India&quot;,
    &quot;Thai Airways&quot;, &quot;Aston Martin&quot;, &quot;Audi&quot;, &quot;BMW&quot;, &quot;BYD&quot;, &quot;Bentley&quot;, &quot;Bugatti&quot;,
    &quot;Cadillac&quot;, &quot;Chevrolet&quot;, &quot;Dodge&quot;, &quot;Ferrari&quot;, &quot;Ford Motor&quot;, &quot;GMC&quot;,
    &quot;General Motors&quot;, &quot;Genesis&quot;, &quot;Harley-Davidson&quot;, &quot;Honda Motor&quot;, &quot;Hyundai Motor&quot;,
    &quot;Jaguar Land Rover&quot;, &quot;Jeep&quot;, &quot;Kia Corporation&quot;, &quot;Lamborghini&quot;, &quot;Lexus&quot;,
    &quot;Maserati&quot;, &quot;Mazda&quot;, &quot;Mercedes-Benz&quot;, &quot;Nissan Motor&quot;, &quot;Porsche&quot;, &quot;Renault&quot;,
    &quot;Rolls-Royce&quot;, &quot;Subaru Corporation&quot;, &quot;Suzuki&quot;, &quot;Tata Motors&quot;, &quot;Tesla&quot;,
    &quot;Toyota Motor&quot;, &quot;Volkswagen&quot;, &quot;Volvo&quot;, &quot;Ducati&quot;, &quot;Fiat&quot;, &quot;Alfa Romeo&quot;,
    &quot;SEAT&quot;, &quot;Skoda&quot;, &quot;Peugeot&quot;, &quot;Mitsubishi Motors&quot;, &quot;Yamaha Motor&quot;,
    &quot;Royal Enfield&quot;, &quot;Zurich Insurance&quot;, &quot;American Express&quot;, &quot;Allianz&quot;, &quot;Aviva&quot;,
    &quot;Bank of America&quot;, &quot;Bank of China&quot;, &quot;Barclays&quot;, &quot;Morgan Stanley&quot;,
    &quot;PNC Financial Services&quot;, &quot;PayPal&quot;, &quot;Paytm&quot;, &quot;PhonePe&quot;, &quot;Razorpay&quot;,
    &quot;Royal Bank of Canada&quot;, &quot;Berkshire Hathaway&quot;, &quot;BlackRock&quot;, &quot;BNP Paribas&quot;,
    &quot;Capital One&quot;, &quot;Citigroup&quot;, &quot;Commonwealth Bank of Australia&quot;, &quot;Deutsche Bank&quot;,
