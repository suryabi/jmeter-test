              <stringProp name="Argument.value"></stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
              <stringProp name="Argument.desc">kind=ui entity=meeting list=true title=Meeting $index/$total</stringProp>
            </elementProp>
            <elementProp name="uiAccountName" elementType="Argument">
