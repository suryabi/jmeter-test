                  <stringProp name="cacheKey">true</stringProp>
                  <stringProp name="script">SampleResult.setSuccessful(false)
def meetingIdx = vars.get(&quot;meetingIdx&quot;)
def msg = &quot;Day &quot; + vars.get(&quot;dayNumber&quot;) + &quot; - Meeting #&quot; + (meetingIdx.toInteger() + 1) + &quot;: Get Vacant Slots (called once) found no usable slot in venue &quot; + vars.get(&quot;parentLocationId&quot;) + &quot; for duration=&quot; + vars.get(&quot;selectedMeetingDuration&quot;) + &quot; minutes - skipping remaining meetings for this day&quot;
SampleResult.setResponseMessage(msg)
SampleResult.setResponseData(msg, &quot;UTF-8&quot;)
log.warn(msg)

// Set flag to exit meeting loop early - no point trying remaining meetings
vars.put(&quot;noSlotsAvailable&quot;, &quot;true&quot;)</stringProp>
