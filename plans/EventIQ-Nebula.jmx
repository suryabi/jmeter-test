                  <com.atlantbh.jmeter.plugins.jsonutils.jsonformatter.JSONFormatter guiclass="com.atlantbh.jmeter.plugins.jsonutils.jsonformatter.gui.JSONFormatterGui" testclass="com.atlantbh.jmeter.plugins.jsonutils.jsonformatter.JSONFormatter" testname="jp@gc - JSON Format Post Processor" enabled="true"/>
                  <hashTree/>
                  <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Store Presenters List" enabled="true">
                    <stringProp name="scriptLanguage">groovy</stringProp>
                    <stringProp name="parameters"></stringProp>
                    <stringProp name="filename"></stringProp>
                    <stringProp name="cacheKey">true</stringProp>
                    <stringProp name="script">// Caches the REAL presenter records returned by this call (uniqueId,
// firstName, lastName, designation, primaryEmail, secondaryEmail,
// secondaryEmailId, status, presenter, isOtherPresenter, assistantEmail,
// primaryEmails, sortOrder, presenterType, ...) so &quot;Update Meeting&quot; can send
// one of these objects as-is instead of fabricating a presenter from
// unrelated form-template controls (which produced the wrong shape).
import groovy.json.JsonSlurper
import groovy.json.JsonOutput

try {
    def body = prev.getResponseDataAsString()
    def json = body ? new JsonSlurper().parseText(body) : null
    // Shape-agnostic: walk the whole response and collect every presenter
    // record (a map with uniqueId + firstName), wherever it is nested
    // (_embedded.*, grouped under topics, ...). De-duplicated by uniqueId.
    def found = [:]
    def walk
    walk = { node -&gt;
        if (node instanceof Map) {
            if (node.uniqueId &amp;&amp; node.firstName != null) {
                found[node.uniqueId.toString()] = node
            } else {
                node.values().each { walk(it) }
            }
        } else if (node instanceof Collection) {
            node.each { walk(it) }
        }
    }
    walk(json)
    def list = found.values().toList()
    log.info(&quot;Get Presenters for Topics: found &quot; + list.size() + &quot; presenter record(s); first record keys=&quot; + (list ? list[0].keySet().join(&quot;,&quot;) : &quot;n/a&quot;))
    vars.put(&quot;presentersListJson&quot;, JsonOutput.toJson(list))
    log.info(&quot;Get Presenters for Topics: cached &quot; + list.size() + &quot; presenter(s) for Update Meeting&quot;)
} catch (Exception e) {
    vars.put(&quot;presentersListJson&quot;, &quot;[]&quot;)
    log.warn(&quot;Get Presenters for Topics: could not parse response (&quot; + e.message + &quot;) - presentersListJson set to []&quot;)
}</stringProp>
                  </JSR223PostProcessor>
                  <hashTree/>
                </hashTree>
                <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Update Meeting" enabled="true">
                  <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
                  <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
                    <collectionProp name="Arguments.arguments">
                      <elementProp name="" elementType="HTTPArgument">
                        <boolProp name="HTTPArgument.always_encode">false</boolProp>
                        <stringProp name="Argument.value">${updateMeetingPayloadJson}</stringProp>
                        <stringProp name="Argument.metadata">=</stringProp>
                      </elementProp>
                    </collectionProp>
                  </elementProp>
                  <stringProp name="HTTPSampler.domain">${host}</stringProp>
                  <stringProp name="HTTPSampler.port">${port}</stringProp>
                  <stringProp name="HTTPSampler.protocol">${protocol}</stringProp>
                  <stringProp name="HTTPSampler.contentEncoding"></stringProp>
                  <stringProp name="HTTPSampler.path">/${contextname}/api/events/${eventId}/meetings/${meetingId}</stringProp>
                  <stringProp name="HTTPSampler.method">PUT</stringProp>
                  <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
                  <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
                  <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
                  <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
                  <stringProp name="HTTPSampler.embedded_url_re"></stringProp>
                  <stringProp name="HTTPSampler.connect_timeout"></stringProp>
                  <stringProp name="HTTPSampler.response_timeout"></stringProp>
                </HTTPSamplerProxy>
                <hashTree>
                  <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Alias Mapping" enabled="true">
                    <stringProp name="scriptLanguage">groovy</stringProp>
                    <stringProp name="parameters"></stringProp>
                    <stringProp name="filename"></stringProp>
                    <stringProp name="cacheKey">true</stringProp>
                    <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput

// ----------------------------------------------------------------------
// Alias -&gt; role mapping for auto-generated Update Meeting field values.
// Add new roles/aliases here one at a time - each role is filled from ONE
// random person (from the &quot;Fetch Random Data&quot; / randomuser.me pool) so
// first name, last name and email stay consistent with each other.
// ----------------------------------------------------------------------
def aliasGroups = [
    host: [
        firstName: &quot;hostFirstName&quot;,
        lastName : &quot;hostLastName&quot;,
        email    : &quot;hostEmail&quot;
    ],
    onsiteLead: [
        firstName: &quot;onsiteLeadFirstName&quot;,
        lastName : &quot;onsiteLeadLastName&quot;,
        email    : &quot;onsiteLeadEmail&quot;
    ]
]

def poolSize = (vars.get(&quot;randomUserCount&quot;) ?: &quot;0&quot;).toInteger()
if (poolSize == 0) {
    log.warn(&quot;Alias Field Random Data Mapper: randomUserCount is 0/missing - run &apos;Fetch Random Data&apos; first. Skipping.&quot;)
    return
}

// -- Resolve business alias name -&gt; real dataMapping/attributeName -------
// The alias (e.g. &quot;onsiteLeadFirstName&quot;) is NOT always the key Update
// Meeting actually sends - that&apos;s the form field&apos;s attributeName/dataMapping
// (e.g. &quot;textField22&quot;), which formFieldsByAttributeJson exposes per-field
// as &quot;aliasName&quot;. Build alias -&gt; attributeName here so overrides always
// land on the field the payload builder is really looking at. Some fields
// (like the host ones) happen to have attributeName == aliasName already.
def dataMappingByAlias = [:]
try {
    def fieldMeta = new JsonSlurper().parseText(vars.get(&quot;formFieldsByAttributeJson&quot;) ?: &quot;{}&quot;)
    fieldMeta.each { attributeName, meta -&gt;
        if (meta?.aliasName) {
            dataMappingByAlias[meta.aliasName] = attributeName
        }
    }
} catch (Exception e) {
    log.warn(&quot;Alias Field Random Data Mapper: could not parse formFieldsByAttributeJson (${e.message}) - alias resolution will fall back to using alias names as-is.&quot;)
}

def resolveKey = { String alias -&gt;
    def resolved = dataMappingByAlias[alias]
    if (!resolved) {
        // No aliasName match found - assume the alias IS the real field key
        // (true for fields like hostFirstName/hostLastName/hostEmail).
        resolved = alias
    }
    resolved
}

// Sequential, non-repeating pointer into the random user pool so each role
// (host, onsiteLead, ...) gets a DIFFERENT random person this iteration.
def nextIndex = (vars.get(&quot;randomUserIndex&quot;) ?: &quot;1&quot;).toInteger()

def overrides = [:]
try {
    def raw = vars.get(&quot;updateMeetingFieldOverridesJson&quot;)
    if (raw) {
        overrides = new JsonSlurper().parseText(raw)
    }
} catch (Exception e) {
    log.warn(&quot;Alias Field Random Data Mapper: could not parse existing updateMeetingFieldOverridesJson (${e.message}) - starting fresh.&quot;)
}

aliasGroups.each { role, aliases -&gt;
    if (nextIndex &gt; poolSize) {
        nextIndex = 1 // wrap around if we run out of unique random users
    }
    def first = vars.get(&quot;randomUser_${nextIndex}_firstName&quot;) ?: &quot;Test&quot;
    def last  = vars.get(&quot;randomUser_${nextIndex}_lastName&quot;)  ?: &quot;User&quot;
    nextIndex++

    def email = (first + &quot;.&quot; + last + &quot;@gmail.com&quot;).toLowerCase()

    // HARDCODED: onsiteLeadEmail is always deepa@allianceit.com
    if (role == &quot;onsiteLead&quot;) {
        email = &quot;deepa@allianceit.com&quot;
        log.info(&quot;Alias Field Random Data Mapper: Hardcoded onsiteLeadEmail to deepa@allianceit.com&quot;)
    }

    if (aliases.firstName) overrides[resolveKey(aliases.firstName)] = first
    if (aliases.lastName)  overrides[resolveKey(aliases.lastName)]  = last
    if (aliases.email)     overrides[resolveKey(aliases.email)]     = email

    vars.put(role + &quot;FirstName&quot;, first)
    vars.put(role + &quot;LastName&quot;, last)
    vars.put(role + &quot;Email&quot;, email)
}

// -- CXO Name And Title 1..3 ----------------------------------------------
// Each alias is ONE field holding &quot;First Last - Designation&quot;. Every field gets
// a DIFFERENT random person from the pool plus a random designation from
// props &quot;data_Titles&quot; (registered in the Common Function sampler). The alias
// is resolved to the real attributeName through resolveKey, like the others.
def titlesSource = props.get(&quot;data_Titles&quot;)
def pickTitle = {
    def srcVal = titlesSource
    if (srcVal instanceof Closure) {
        srcVal = (srcVal.maximumNumberOfParameters == 0) ? srcVal.call() : srcVal.call(vars)
    }
    if (srcVal instanceof CharSequence) {
        return srcVal.toString()
    }
    if (srcVal != null &amp;&amp; (srcVal instanceof Collection || srcVal.getClass().isArray())) {
        def titleList = srcVal as List
        if (titleList) {
            return titleList[java.util.concurrent.ThreadLocalRandom.current().nextInt(titleList.size())].toString()
        }
    }
    return null
}

def cxoAliases = [&quot;CXONameAndTitle1&quot;, &quot;CXONameAndTitle2&quot;, &quot;CXONameAndTitle3&quot;]
cxoAliases.each { cxoAlias -&gt;
    if (nextIndex &gt; poolSize) {
        nextIndex = 1
    }
    def cxoFirst = vars.get(&quot;randomUser_${nextIndex}_firstName&quot;) ?: &quot;Test&quot;
    def cxoLast  = vars.get(&quot;randomUser_${nextIndex}_lastName&quot;)  ?: &quot;User&quot;
    nextIndex++

    def cxoTitle = pickTitle()
    if (!cxoTitle) {
        log.warn(&quot;Alias Field Random Data Mapper: props data_Titles missing/empty - &quot; + cxoAlias + &quot; override skipped.&quot;)
        return
    }
    def cxoValue = cxoFirst + &quot; &quot; + cxoLast + &quot; - &quot; + cxoTitle
    overrides[resolveKey(cxoAlias)] = cxoValue
    vars.put(cxoAlias, cxoValue)
}

// -- Account Name --------------------------------------------------------
// fn_accountName (registered in the common-functions setup sampler) picks a
// random customer from data_allCustomers and stores it in vars.accountName.
// It has to be invoked explicitly here (it was never called anywhere else,
// which is why accountName was always going out blank/default) and its
// result mapped through resolveKey so it lands on whatever real
// dataMapping/attributeName the form&apos;s &quot;accountName&quot; alias resolves to.
def accountNameFn = props.get(&quot;fn_accountName&quot;)
if (accountNameFn) {
    try {
        def selectedAccount = accountNameFn(vars)
        overrides[resolveKey(&quot;accountName&quot;)] = selectedAccount
        // Meeting Details is derived from the account picked above.
        overrides[resolveKey(&quot;meetingDetails&quot;)] = &quot;Meeting Details of &quot; + selectedAccount
        // Meeting Notes is derived from the account picked above.
        overrides[resolveKey(&quot;meetingNotes&quot;)] = &quot;Meeting Notes of &quot; + selectedAccount
    } catch (Exception e) {
        log.warn(&quot;Alias Field Random Data Mapper: fn_accountName failed (&quot; + e.message + &quot;) - accountName override skipped.&quot;)
    }
} else {
    log.warn(&quot;Alias Field Random Data Mapper: fn_accountName not found in props - was the common-functions setup sampler run? accountName override skipped.&quot;)
}

// -- Meeting Focus / Meeting Sub Focus (textField2 / textField3) ----------
// Sourced from the &quot;Get Topics&quot; call (cached in vars &quot;topicsJson&quot;). The UI
// only lists presenters tagged with the selected topic (sub topic when one
// is chosen), so the topic is picked from those that have at least one
// available presenter in &quot;presentersListJson&quot; (from &apos;Get Presenters for
// Topics&apos;); the chosen topic uniqueId is stored in &quot;selectedTopicUid&quot; so
// Update Meeting can pick matching presenters. Set the UDV
// &quot;topicPayloadField&quot; to &quot;name&quot; if the API expects the display name
// instead of the topic id (default: &quot;id&quot;).
try {
    def rawTopics = vars.get(&quot;topicsJson&quot;)
    def topicTree = rawTopics ? new JsonSlurper().parseText(rawTopics) : []
    def rawPresenters = vars.get(&quot;presentersListJson&quot;)
    def presenterPool = rawPresenters ? new JsonSlurper().parseText(rawPresenters) : []
    // Clear last iteration&apos;s values so nothing stale is carried over.
    overrides.remove(&quot;textField2&quot;)
    overrides.remove(&quot;textField3&quot;)
    vars.remove(&quot;selectedTopicUid&quot;)
    if (topicTree) {
        def valueField = (vars.get(&quot;topicPayloadField&quot;) ?: &quot;id&quot;).trim()
        def rndTopic = new Random()

        // topic uniqueId -&gt; number of available (not occupied) presenters tagged with it
        def presentersByTopic = [:]
        presenterPool.findAll { it.occupied != true }.each { pr -&gt;
            (pr.topics ?: []).collect { it?.uniqueId }.findAll { it }.unique().each { uid -&gt;
                presentersByTopic[uid] = (presentersByTopic[uid] ?: 0) + 1
            }
        }

        // Rebuild parent/child links. If &quot;Get Topics&quot; does not expose a sub
        // topic&apos;s parent in a shape the parser recognises, the sub topic ends
        // up in the tree as a parent - and Meeting Focus (a parent-only
        // dropdown) then gets a sub-topic id and shows blank in the UI.
        // Presenter records always carry the parent (&quot;parent&quot;: {uniqueId,
        // name}), so use them to fill any missing link.
        def parentOf = [:]   // childId -&gt; [id, name]
        presenterPool.each { pr -&gt;
            (pr.topics ?: []).each { tp -&gt;
                if (tp?.uniqueId &amp;&amp; tp.parent instanceof Map &amp;&amp; tp.parent.uniqueId) {
                    parentOf[tp.uniqueId.toString()] = [id: tp.parent.uniqueId.toString(), name: tp.parent.name?.toString()]
                }
            }
        }
        def nodes = [:]      // id -&gt; [id, name, parentId]
        topicTree.each { par -&gt;
            if (!nodes.containsKey(par.id)) {
                nodes[par.id] = [id: par.id, name: par.name, parentId: null]
            }
            par.children?.each { ch -&gt; nodes[ch.id] = [id: ch.id, name: ch.name, parentId: par.id] }
        }
        nodes.values().toList().each { n -&gt;
            if (!n.parentId &amp;&amp; parentOf[n.id]) {
                n.parentId = parentOf[n.id].id
                if (!nodes.containsKey(n.parentId)) {
                    nodes[n.parentId] = [id: n.parentId, name: parentOf[n.id].name, parentId: null]
                }
            }
        }

        // Selectable combos: ROOT topic + one of its children when it has any, else root alone.
        def candidates = []
        def roots = nodes.values().findAll { !it.parentId }
        roots.each { par -&gt;
            def kids = nodes.values().findAll { it.parentId == par.id }
            if (kids) {
                kids.each { ch -&gt; candidates &lt;&lt; [parent: par, child: ch, leaf: ch.id] }
            } else {
                candidates &lt;&lt; [parent: par, child: null, leaf: par.id]
            }
        }
        log.info(&quot;Alias Field Random Data Mapper: topic tree has &quot; + roots.size() + &quot; root topic(s), &quot; + roots.count { r -&gt; nodes.values().any { it.parentId == r.id } } + &quot; with sub topics, &quot; + nodes.size() + &quot; topic(s) total&quot;)
        def withPresenters = candidates.findAll { presentersByTopic[it.leaf] }
        if (!withPresenters) {
            log.warn(&quot;Alias Field Random Data Mapper: no topic has an available presenter (presentersListJson empty or untagged) - picking a topic without presenter filtering.&quot;)
        }
        def pool = withPresenters ?: candidates
        def pick = pool[rndTopic.nextInt(pool.size())]

        overrides[&quot;textField2&quot;] = pick.parent[valueField]
        if (pick.child) {
            overrides[&quot;textField3&quot;] = pick.child[valueField]
        }
        vars.put(&quot;selectedTopicUid&quot;, pick.leaf.toString())
        log.info(&quot;Alias Field Random Data Mapper: Meeting Focus=&quot; + pick.parent.name + &quot;, Sub Focus=&quot; + (pick.child ? pick.child.name : &quot;n/a&quot;) + &quot;, presenters available for topic=&quot; + (presentersByTopic[pick.leaf] ?: 0))
    } else {
        log.warn(&quot;Alias Field Random Data Mapper: topicsJson is empty/missing - run &apos;Get Topics&apos; first. Meeting Focus/Sub Focus will be null.&quot;)
    }
} catch (Exception e) {
    log.warn(&quot;Alias Field Random Data Mapper: could not set Meeting Focus/Sub Focus (&quot; + e.message + &quot;)&quot;)
}

vars.put(&quot;randomUserIndex&quot;, nextIndex.toString())
vars.put(&quot;updateMeetingFieldOverridesJson&quot;, JsonOutput.toJson(overrides))
log.info(&quot;Alias Field Random Data Mapper: set overrides for [&quot; + aliasGroups.keySet().join(&quot;, &quot;) + &quot;, accountName] -&gt; &quot; + JsonOutput.toJson(overrides))</stringProp>
                  </JSR223PreProcessor>
                  <hashTree/>
                  <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Meeting PreProcessor" enabled="true">
                    <stringProp name="scriptLanguage">groovy</stringProp>
                    <stringProp name="parameters"></stringProp>
                    <stringProp name="filename"></stringProp>
                    <stringProp name="cacheKey">true</stringProp>
                    <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput

def slurper = new JsonSlurper()

def parseJsonVar = { name, fallback -&gt;
    def raw = vars.get(name)
    if (!raw) {
        return fallback
    }

    try {
        return slurper.parseText(raw)
    } catch (Exception e) {
        log.warn(&quot;Update Meeting: could not parse &apos;&quot; + name + &quot;&apos; as JSON (&quot; + e.message + &quot;) - using default. Value was: &quot; + raw)
        return fallback
    }
}

try {
    def controls      = parseJsonVar(&quot;formTemplateControlsJson&quot;, [])
    def fieldMeta     = parseJsonVar(&quot;formFieldsByAttributeJson&quot;, [:])
    def lookupByType  = parseJsonVar(&quot;lookupValuesByTypeJson&quot;, [:])
    def apiIdKeyMap   = parseJsonVar(&quot;updateMeetingApiIdKeyMapJson&quot;, [meeting: &quot;data&quot;, holdRemarks: &quot;remarks&quot;])
    def fieldOverrides = parseJsonVar(&quot;updateMeetingFieldOverridesJson&quot;, [:])
    def extraFields   = parseJsonVar(&quot;updateMeetingExtraFieldsJson&quot;, [:])

    if (!controls) {
        log.warn(&quot;Update Meeting PreProcessor: formTemplateControlsJson is empty. Sending an empty body.&quot;)
    }

    // Diagnostic: several fields in this schema pair an &quot;Other&quot; option with
    // a companion free-text control that only appears/is required once
    // &quot;Other&quot; is selected (confirmed pattern: accountType=&quot;Other&quot; persists
    // together with a separate &quot;otherAccountType&quot; value). Log every control
    // whose dependents list is keyed off an &quot;Other&quot;-ish evalValue so we can
    // see, from a real API response, exactly which companion field(s) exist
    // for remarks (and any other &quot;Other&quot;-bearing dropdown) and whether this
    // script is currently generating/sending them at all.
    controls.each { c -&gt;
        c.dependents?.each { dep -&gt;
            if (dep?.evalValue?.toString()?.trim()?.equalsIgnoreCase(&quot;Other&quot;)) {
                log.info(&quot;Update Meeting: control &apos;&quot; + c.dataMapping + &quot;&apos; (apiId=&apos;&quot; + c.apiId +
                        &quot;&apos;) has an &apos;Other&apos;-triggered dependent -&gt; formControlName=&apos;&quot; + dep.formControlName +
                        &quot;&apos;, evalCondition=&apos;&quot; + dep.evalCondition + &quot;&apos;, removeModelIfHidden=&quot; + dep.removeModelIfHidden)
            }
        }
    }

    // Diagnostic + override: the &quot;Reason&quot; control in the Status Change
    // Details UI renders as a single-select dropdown, not a checklist, so a
    // JS array value likely never matches any option and shows empty - no
    // matter how many items are in it or what they are. Log what the API&apos;s
    // own form template actually reports for multiSelect/multivalueField on
    // every control so we can see whether the script&apos;s belief that this
    // field is multi-select is even correct, and allow forcing specific
    // dataMappings to a single scalar value (via the forceSingleValueFields
    // UDV, comma-separated dataMappings, e.g. &quot;remarks&quot;) so this can be
    // A/B tested against the real UI without more guesswork.
    // ⚠ CONFIRMED BY SERVER STACK TRACE: BIQEventServiceImpl throws
    // ClassCastException (String cannot be cast to java.util.List) when
    // &quot;remarks&quot; is sent as a scalar. The backend requires a List here,
    // no exceptions. Do NOT default forceSingleValueFields to include
    // &quot;remarks&quot; (or send it as anything but a JSON array) again - doing so
    // fails the entire PUT, not just this one field. Left as an opt-in via
    // the UDV only for testing other, unrelated fields if a similar
    // single-vs-multi question ever comes up for them.
    def forceSingleValueFieldsRaw = (vars.get(&quot;forceSingleValueFields&quot;) ?: &quot;none&quot;).trim()
    def forceSingleValueFields = forceSingleValueFieldsRaw.equalsIgnoreCase(&quot;none&quot;)
            ? ([] as Set)
            : forceSingleValueFieldsRaw.split(&quot;,&quot;).collect { it.trim() }.findAll { it } as Set

    controls.each { c -&gt;
        def m = fieldMeta[c.dataMapping]

        if (c.multiSelect == true || m?.multivalueField == true) {
            log.info(&quot;Update Meeting: dataMapping=&apos;&quot; + c.dataMapping + &quot;&apos; (apiId=&apos;&quot; + c.apiId +
                    &quot;&apos;) reports multiSelect=&quot; + c.multiSelect + &quot;, meta.multivalueField=&quot; + m?.multivalueField)
        }

        if (c.dataMapping in forceSingleValueFields &amp;&amp; c.multiSelect == true) {
            log.info(&quot;Update Meeting: forcing dataMapping=&apos;&quot; + c.dataMapping +
                    &quot;&apos; to a single (non-array) value for this run (forceSingleValueFields override).&quot;)
            c.multiSelect = false
            if (m instanceof Map) {
                m.multivalueField = false
            }
        }
    }

    def sectionsToInclude = (vars.get(&quot;updateMeetingSections&quot;) ?: &quot;meeting,holdRemarks&quot;)
            .split(&quot;,&quot;)
            .collect { it.trim() }
            .findAll { it } as Set

    log.info(&quot;Update Meeting: sectionsToInclude = &quot; + sectionsToInclude)

    // The lookupvalues API documents &quot;code&quot; as the raw value the API
    // CRITICAL: Always use &quot;label&quot; for lookup payloads, NOT &quot;code&quot;.
    // The lookup parsing (line 1023) maps the API&apos;s &quot;value&quot; field → our &quot;label&quot; field.
    // Per line 1013 comment: &quot;code is the raw value sent back to the API, value is
    // the human-readable label shown in the UI&quot; - but empirically the API expects
    // the &quot;value&quot; field (human-readable) when UPDATING meetings, not the &quot;code&quot;.
    // Our &quot;label&quot; field = API&apos;s &quot;value&quot; field, so send that.
    def extractLookupValue = { opt -&gt;
        if (!opt) return null
        return opt.label ?: opt.code
    }

    def rnd = new Random()

    def randomFrom = { List list -&gt;
        (list == null || list.isEmpty()) ? null : list[rnd.nextInt(list.size())]
    }

    def numberFromValidators = { validators, defMin, defMax -&gt;
        def min = defMin
        def max = defMax

        validators?.each { v -&gt;
            def s = v?.toString()

            if (s?.startsWith(&quot;MIN:&quot;)) {
                def m = s.substring(4).trim()

                if (m.isNumber()) {
                    min = m.toBigDecimal().toInteger()
                } else {
                    log.warn(&quot;Update Meeting: MIN validator &apos;&quot; + s + &quot;&apos; is not a number. Using default &quot; + min)
                }
            }

            if (s?.startsWith(&quot;MAX:&quot;)) {
                def m = s.substring(4).trim()

                if (m.isNumber()) {
                    max = m.toBigDecimal().toInteger()
                } else {
                    log.warn(&quot;Update Meeting: MAX validator &apos;&quot; + s + &quot;&apos; is not a number. Using default &quot; + max)
                }
            }
        }

        if (max &lt; min) {
            max = min
        }

        min + rnd.nextInt((max - min) + 1)
    }

    def asMultiSelect = { control, value -&gt;
        if (control.multiSelect == true &amp;&amp; value != null &amp;&amp; !(value instanceof List)) {
            return [value]
        }

        return value
    }

    def isHiddenByCondition = { parentValue, evalCondition, evalValue -&gt;
        switch (evalCondition) {
            case &quot;!=&quot;:
                return parentValue != evalValue

            case &quot;=&quot;:
            case &quot;==&quot;:
                return parentValue == evalValue

            case &quot;notincludes&quot;:
                return !(parentValue instanceof Collection) || !parentValue.contains(evalValue)

            case &quot;includes&quot;:
                return (parentValue instanceof Collection) &amp;&amp; parentValue.contains(evalValue)

            default:
                log.warn(&quot;Update Meeting: unknown hide evalCondition &apos;&quot; + evalCondition + &quot;&apos;.&quot;)
                return false
        }
    }

    def sampleValueFor = { control, meta, selectedValues -&gt;
        def dataMapping = control.dataMapping
        def dropdownEnumType = control.dropdownEnumType
        def controlType = control.formControlType
        def validators = control.validators ?: []

        if (meta?.computed) {
            return null
        }

        if (fieldOverrides.containsKey(dataMapping)) {
            return fieldOverrides[dataMapping]
        }

        if (dropdownEnumType == &quot;LOOKUP&quot;) {
            def allOptions = lookupByType[control.dropdownEnum]

            if (!allOptions) {
                log.warn(&quot;Update Meeting: no cached lookup values for dropdownEnum=&apos;&quot; +
                        control.dropdownEnum + &quot;&apos; and field &apos;&quot; + dataMapping + &quot;&apos;.&quot;)
                return null
            }

            def options = allOptions

            def isMulti = (control.multiSelect == true) || (meta?.multivalueField == true)

            if (isMulti) {
                def shuffledOpts = new ArrayList(options)
                Collections.shuffle(shuffledOpts, rnd)

                def take = 1 + rnd.nextInt(2)

                def chosen = shuffledOpts.take(
                        Math.min(take, shuffledOpts.size())
                )

                // &quot;Other&quot; (and similar catch-all options) are exclusive in the
                // real UI - picking it clears/disables the rest of the
                // checklist. If it ends up in a multi-pick alongside anything
                // else, collapse the selection down to just &quot;Other&quot; so the
                // payload matches a combination the UI can actually render
                // as selected. Without this, e.g. remarks = [&quot;Exec/EA
                // Approval&quot;, &quot;Other&quot;] gets accepted by the API but shows as
                // nothing selected when the meeting is reopened in the UI.
                def isOtherOption = { opt -&gt;
                    def val = extractLookupValue(opt)?.toString()
                    val?.trim()?.equalsIgnoreCase(&quot;Other&quot;)
                }

                if (chosen.size() &gt; 1 &amp;&amp; chosen.any(isOtherOption)) {
                    chosen = [chosen.find(isOtherOption)]
                }

                return chosen.collect { extractLookupValue(it) }.findAll { it != null }
            }

            def picked = randomFrom(options)

            if (!picked) {
                log.warn(&quot;Update Meeting: no cached lookup values for dropdownEnum=&apos;&quot; +
                        control.dropdownEnum + &quot;&apos; and field &apos;&quot; + dataMapping + &quot;&apos;.&quot;)
                return null
            }

            return extractLookupValue(picked)
        }

        if (dropdownEnumType == &quot;CUSTOM&quot;) {
            log.warn(&quot;Update Meeting: CUSTOM dropdown &apos;&quot; + dataMapping +
                    &quot;&apos; has no override configured.&quot;)
            return null
        }

        if (controlType == &quot;CHIPS&quot;) {
            if (validators.any { it?.toString() == &quot;EMAIL&quot; }) {
                def emailCount = 1 + rnd.nextInt(2)

                return (1..emailCount).collect { i -&gt;
                    (&quot;chip.&quot; + dataMapping.toLowerCase() + &quot;.&quot; +
                            System.currentTimeMillis() + &quot;.&quot; + i + &quot;@gmail.com&quot;).toString()
                }
            }

            // Free-text CHIPS: always send 2 values.
            return [
                (1000 + rnd.nextInt(9000)).toString(),
                (1000 + rnd.nextInt(9000)).toString()
            ]
        }

        if (controlType == &quot;DATE&quot;) {
            return null
        }

        def dataType = (meta?.dataType ?: &quot;&quot;).toString().toUpperCase()

        if (dataType.startsWith(&quot;NUMBER&quot;) ||
                validators.any { it?.toString() == &quot;NUMBER&quot; }) {
            return numberFromValidators(validators, 1, 10).toString()
        }

        if (dataType == &quot;BOOLEAN&quot;) {
            return rnd.nextBoolean()
        }

        if (validators.any { it?.toString() == &quot;EMAIL&quot; }) {
            return (
                &quot;loadtest.&quot; +
                dataMapping.toLowerCase() +
                &quot;.&quot; +
                System.currentTimeMillis() +
                &quot;@example.com&quot;
            ).toString()
        }

        if (controlType == &quot;TEXTAREA&quot;) {
            def textAreaPool = props.get(&quot;data_defaultTextAreas&quot;) as String[]

            if (textAreaPool &amp;&amp; textAreaPool.length &gt; 0) {
                return textAreaPool[rnd.nextInt(textAreaPool.length)]
            }

            log.warn(&quot;Update Meeting: data_defaultTextAreas is empty.&quot;)
        } else if (controlType == &quot;TEXTFIELD&quot;) {
            def textFieldPool = props.get(&quot;data_defaultTextFields&quot;) as String[]

            if (textFieldPool &amp;&amp; textFieldPool.length &gt; 0) {
                return textFieldPool[rnd.nextInt(textFieldPool.length)]
            }

            log.warn(&quot;Update Meeting: data_defaultTextFields is empty.&quot;)
        }

        return (
            &quot;Test &quot; +
            (control.displayName ?: dataMapping) +
            &quot; &quot; +
            (1000 + rnd.nextInt(9000))
        ).toString()
    }

    def sections = [:]
    def sectionOrder = []

    def computedHidden = [:]
    def computedRemoveIfHidden = [:]

    // Track selected values for parent-child dropdown dependencies
    def selectedValues = [:]

    // DEBUG: Count controls by apiId before filtering
    def controlsByApiId = [:]
    controls.each { c -&gt;
        def apiId = c.apiId ?: &quot;null&quot;
        controlsByApiId[apiId] = (controlsByApiId[apiId] ?: 0) + 1
    }
    log.info(&quot;Update Meeting: Total controls by apiId: &quot; + controlsByApiId)

    controls.each { control -&gt;

        if (!(control.apiId in sectionsToInclude)) {
            return
        }

        def dataMapping = control.dataMapping

        if (!dataMapping) {
            return
        }

        def formControlName = control.formControlName

        def isHidden

        if (formControlName != null &amp;&amp;
                computedHidden.containsKey(formControlName)) {
            isHidden = computedHidden[formControlName]
        } else {
            isHidden = control.hide == true
        }

        def meta = fieldMeta[dataMapping]

        def value

        if (control.disabled == true) {
            // Disabled controls (e.g. Status Change Date) are read-only in the
            // form, so nothing is generated for them - not even an override.
            // The key is still sent with a null value, like the UI does.
            value = null
        } else if (isHidden &amp;&amp; !fieldOverrides.containsKey(dataMapping)) {
            value = null
        } else {
            value = sampleValueFor(control, meta, selectedValues)
        }

        value = asMultiSelect(control, value)

        // Track this value for dependent dropdown filtering
        if (value != null &amp;&amp; dataMapping) {
            selectedValues[dataMapping] = value
        }

        control.dependents?.each { dep -&gt;
            computedHidden[dep.formControlName] =
                    isHiddenByCondition(
                            value,
                            dep.evalCondition,
                            dep.evalValue
                    )

            computedRemoveIfHidden[dep.formControlName] =
                    dep.removeModelIfHidden == true
        }

        def removeIfHidden =
                control.removeModelIfHidden == true ||
                computedRemoveIfHidden[formControlName] == true

        if (isHidden &amp;&amp; removeIfHidden) {
            return
        }

        def bucket = sections.get(control.apiId)

        if (bucket == null) {
            bucket = [:]
            sections.put(control.apiId, bucket)
            sectionOrder &lt;&lt; control.apiId
        }

        // DEBUG: Log all lookup field assignments to diagnose population issues
        if (control.dropdownEnumType == &quot;LOOKUP&quot;) {
            def logValue = groovy.json.JsonOutput.toJson(value)
            log.info(&quot;Update Meeting: LOOKUP field &apos;&quot; + dataMapping +
                     &quot;&apos; (enum=&apos;&quot; + control.dropdownEnum +
                     &quot;&apos;, apiId=&apos;&quot; + control.apiId +
                     &quot;&apos;, multiSelect=&quot; + control.multiSelect +
                     &quot;) = &quot; + logValue)
        }

        bucket.put(dataMapping, value)
    }

    def DOLLAR = String.valueOf((char) 36)

    def body = [:]

    def bodyEventId = vars.get(&quot;eventId&quot;)
    def bodyMeetingId = vars.get(&quot;meetingId&quot;)

    if (!bodyMeetingId) {
        log.warn(&quot;Update Meeting: meetingId is empty.&quot;)
    }

    body[&quot;eventId&quot;] = bodyEventId
    body[&quot;meetingId&quot;] = bodyMeetingId

    for (apiId in sectionOrder) {

        def fields = sections[apiId]
        def payloadKey = apiIdKeyMap[apiId] ?: apiId

        def resolvePlaceholders = { String text -&gt;

            def sb = new StringBuilder()
            def i = 0

            while (i &lt; text.length()) {

                def ch = text.charAt(i)

                if (ch == (DOLLAR as char) &amp;&amp;
                        i + 1 &lt; text.length() &amp;&amp;
                        text.charAt(i + 1) == (&apos;{&apos; as char)) {

                    def close = text.indexOf(&apos;}&apos;, i + 2)
                    def key = close != -1
                            ? text.substring(i + 2, close)
                            : null

                    def validKey =
                            key &amp;&amp;
                            key.length() &gt; 0 &amp;&amp;
                            key.every {
                                c -&gt;
                                    c == &apos;_&apos; ||
                                    Character.isLetterOrDigit((char) c)
                            }

                    if (validKey) {
                        sb.append((fields[key] ?: &quot;&quot;).toString())
                        i = close + 1
                        continue
                    }
                }

                sb.append(ch)
                i++
            }

            sb.toString()
        }

        def extras = extraFields[payloadKey]

        if (extras) {
            for (entry in extras.entrySet()) {

                def k = entry.key
                def v = entry.value

                if (v instanceof String) {
                    v = resolvePlaceholders(v)
                }

                fields[k] = v
            }
        }

        // API expects remarks as an OBJECT with nested fields:
        // body.remarks = {reason, holdDate, remarks: [...]}
        // NOT merged into root. The nested structure is correct.
        if (apiId == &quot;presenters&quot;) {
            body[payloadKey] = [fields]
        } else {
            body[payloadKey] = fields
        }
    }

    // CRITICAL: Reorder remarks fields to match UI field order.
    // API has a parsing bug where field order matters - it must be:
    // reason (first) → holdDate (second) → remarks array (third).
    // JMeter default iteration order puts them in the wrong sequence,
    // causing the API to silently strip the remarks array.
    if (body.containsKey(&quot;remarks&quot;) &amp;&amp; body.remarks instanceof Map) {
        def old = body.remarks
        def ordered = new LinkedHashMap()
        if (old.containsKey(&quot;reason&quot;)) ordered.put(&quot;reason&quot;, old.reason)
        if (old.containsKey(&quot;holdDate&quot;)) ordered.put(&quot;holdDate&quot;, old.holdDate)
        if (old.containsKey(&quot;remarks&quot;)) ordered.put(&quot;remarks&quot;, old.remarks)
        // Preserve any other unexpected fields
        old.each { k, v -&gt;
            if (!ordered.containsKey(k)) ordered.put(k, v)
        }
        body.remarks = ordered
    }

    try {

        def presentersList =
                parseJsonVar(&quot;presentersListJson&quot;, [])

        def poolSize =
                (vars.get(&quot;randomUserCount&quot;) ?: &quot;0&quot;).toInteger()

        def takePerson = {

            if (poolSize == 0) {
                return [
                    first: &quot;Test&quot;,
                    last : &quot;User&quot; + (1000 + rnd.nextInt(9000))
                ]
            }

            def idx =
                    (vars.get(&quot;randomUserIndex&quot;) ?: &quot;1&quot;).toInteger()

            if (idx &gt; poolSize) {
                idx = 1
            }

            def person = [
                first: (
                    vars.get(&quot;randomUser_&quot; + idx + &quot;_firstName&quot;)
                    ?: &quot;Test&quot;
                ),
                last: (
                    vars.get(&quot;randomUser_&quot; + idx + &quot;_lastName&quot;)
                    ?: &quot;User&quot;
                )
            ]

            vars.put(
                    &quot;randomUserIndex&quot;,
                    (idx + 1).toString()
            )

            return person
        }

        def slug = {
            String s -&gt;
                s.toLowerCase()
                 .replaceAll(&quot;[^a-z0-9]&quot;, &quot;&quot;)
        }

        def secondaryPerson = takePerson()

        def secondaryEmailValue =
                slug(secondaryPerson.first) +
                &quot;.&quot; +
                slug(secondaryPerson.last) +
                &quot;@briefingiq.com&quot;

        // otherPresenterPercent UDV removed - hardcoded default (was 30).
        def otherPct = 30

        // presenterCount UDV removed - hardcoded default (was 2).
        def wanted = 2

        def topicUid =
                vars.get(&quot;selectedTopicUid&quot;)

        def eligible =
                presentersList.findAll { pr -&gt;
                    pr.occupied != true &amp;&amp;
                    (
                        !topicUid ||
                        (pr.topics ?: []).any {
                            it?.uniqueId == topicUid
                        }
                    )
                }

        // BUGFIX: previously, when no eligible (available) presenter existed
        // for the timeslot/topic, the code fell back to the FULL presenter
        // list - which includes presenters marked occupied/not-available -
        // and only escaped to &quot;Others&quot; on a random 30% roll. 70% of the
        // time this silently submitted a named presenter who was actually
        // unavailable, causing the API to reject the request with
        // &quot;Presenter is not available for selected timeslot&quot;, matching the
        // UI screen where every named presenter shows (Not Available) and
        // only &quot;Others&quot; is selectable. Fix: force Others whenever there is
        // no eligible presenter, and never fall back to the unavailable pool.
        def noEligiblePresenters = !eligible

        if (noEligiblePresenters) {
            log.warn(
                &quot;Update Meeting: no eligible presenter found&quot; +
                (topicUid ? &quot; for topic &quot; + topicUid : &quot;&quot;) +
                &quot; - all presenters are unavailable for this timeslot. &quot; +
                &quot;Forcing OTHERS presenter instead of falling back to an unavailable one.&quot;
            )
        }

        def useOthers =
                noEligiblePresenters ||
                rnd.nextInt(100) &lt; otherPct

        def shuffled =
                new ArrayList(eligible)

        Collections.shuffle(shuffled, rnd)

        def chosenList =
                shuffled.take(
                    Math.max(
                        1,
                        Math.min(wanted, shuffled.size())
                    )
                )

        if (useOthers) {

            def otherPerson = takePerson()

            def otherEmail =
                    slug(otherPerson.first) +
                    &quot;.&quot; +
                    slug(otherPerson.last) +
                    &quot;@gmail.com&quot;

            def otherStatus =
                    (vars.get(&quot;presenterStatus&quot;) ?: &quot;CONFIRMED&quot;).trim()

            def op = [
                firstName     : otherPerson.first,
                lastName      : otherPerson.last,
                primaryEmail  : otherEmail,
                primaryEmails : [&quot;others&quot;],
                secondaryEmail: [secondaryEmailValue],
                status        : otherStatus
            ]

            body[&quot;presenters&quot;] = [op]

            log.info(
                &quot;Update Meeting: using OTHERS presenter &quot; +
                otherPerson.first +
                &quot; &quot; +
                otherPerson.last +
                &quot; &lt;&quot; +
                otherEmail +
                &quot;&gt;&quot;
            )

        } else if (chosenList) {

            def emailOf = {
                rec -&gt;
                    rec.primaryEmail ?:
                    (
                        rec.primaryEmails
                            ? rec.primaryEmails[0]
                            : null
                    )
            }

            def presenterStatus =
                    (vars.get(&quot;presenterStatus&quot;) ?: &quot;CONFIRMED&quot;).trim()

            def p = [
                secondaryEmail: [secondaryEmailValue],
                status        : presenterStatus,
                primaryEmails : chosenList
                        .collect { emailOf(it) }
                        .findAll { it }
            ]

            p = p.findAll {
                k, v -&gt; v != null
            }

            body[&quot;presenters&quot;] = [p]

            log.info(
                &quot;Update Meeting: primaryEmails=&quot; +
                p.primaryEmails.join(&quot;, &quot;)
            )

        } else {

            log.warn(
                &quot;Update Meeting: presentersListJson has no presenters.&quot;
            )
        }

    } catch (Throwable pt) {

        log.error(
            &quot;Update Meeting: failed to build presenters (&quot; +
            pt.class.name +
            &quot;: &quot; +
            pt.message +
            &quot;)&quot;,
            pt
        )
    }

    def payload =
            JsonOutput.prettyPrint(
                JsonOutput.toJson(body)
            )

    vars.put(
        &quot;updateMeetingPayloadJson&quot;,
        payload
    )

    log.info(
        &quot;Update Meeting: built payload for meetingId=&quot; +
        vars.get(&quot;meetingId&quot;) +
        &quot; -&gt; &quot; +
        payload
    )

} catch (Throwable t) {

    log.error(
        &quot;Update Meeting PreProcessor: FAILED to build payload (&quot; +
        t.class.name +
        &quot;: &quot; +
        t.message +
        &quot;) - sending {} instead.&quot;,
        t
    )

    vars.put(
        &quot;updateMeetingPayloadJson&quot;,
        &quot;{}&quot;
    )
}</stringProp>
                  </JSR223PreProcessor>
