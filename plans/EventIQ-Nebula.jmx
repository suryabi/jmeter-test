            </JSR223PostProcessor>
            <hashTree/>
            <com.atlantbh.jmeter.plugins.jsonutils.jsonformatter.JSONFormatter guiclass="com.atlantbh.jmeter.plugins.jsonutils.jsonformatter.gui.JSONFormatterGui" testclass="com.atlantbh.jmeter.plugins.jsonutils.jsonformatter.JSONFormatter" testname="jp@gc - JSON Format Post Processor" enabled="true"/>
            <hashTree/>
          </hashTree>
          <LoopController guiclass="LoopControlPanel" testclass="LoopController" testname="For Each Event Day" enabled="true">
            <boolProp name="LoopController.continue_forever">false</boolProp>
            <stringProp name="LoopController.loops">${matchedEventDateCount}</stringProp>
          </LoopController>
          <hashTree>
            <CounterConfig guiclass="CounterConfigGui" testclass="CounterConfig" testname="Event Day Index Counter" enabled="true">
              <stringProp name="CounterConfig.start">0</stringProp>
              <stringProp name="CounterConfig.end"></stringProp>
              <stringProp name="CounterConfig.incr">1</stringProp>
              <stringProp name="CounterConfig.name">dayIdx</stringProp>
              <stringProp name="CounterConfig.format"></stringProp>
              <boolProp name="CounterConfig.per_user">false</boolProp>
            </CounterConfig>
            <hashTree/>
            <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Select Event Day" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">SampleResult.setIgnore()

// Runs once per event day, before the meetings of that day are created.
// Points the shared date variables (used by Get Vacant Slots and Create
// Meeting) at the day this pass of the &quot;For Each Event Day&quot; loop is on.
def dayIdx   = (vars.get(&quot;dayIdx&quot;) ?: &quot;0&quot;).toInteger()
def dayCount = (vars.get(&quot;matchedEventDateCount&quot;) ?: &quot;0&quot;).toInteger()

vars.put(&quot;dayNumber&quot;, (dayIdx + 1).toString())
vars.put(&quot;requestDate&quot;, vars.get(&quot;eventDate_${dayIdx}_eventDate&quot;))
vars.put(&quot;startTime&quot;,   vars.get(&quot;eventDate_${dayIdx}_startTime&quot;))
vars.put(&quot;endTime&quot;,     vars.get(&quot;eventDate_${dayIdx}_endTime&quot;))
vars.put(&quot;eventDateId&quot;, vars.get(&quot;eventDate_${dayIdx}_eventDateId&quot;))

// Reset flag for this day - fresh slot availability
vars.remove(&quot;noSlotsAvailable&quot;)

log.info(&quot;Event Day &quot; + (dayIdx + 1) + &quot;/&quot; + dayCount + &quot;: eventDateId=&quot; + vars.get(&quot;eventDateId&quot;)
        + &quot; requestDate=&quot; + vars.get(&quot;requestDate&quot;) + &quot; - creating &quot; + vars.get(&quot;meetings&quot;) + &quot; meeting(s)&quot;)
</stringProp>
            </JSR223Sampler>
            <hashTree/>
            <LoopController guiclass="LoopControlPanel" testclass="LoopController" testname="Create Meeting" enabled="true">
              <boolProp name="LoopController.continue_forever">false</boolProp>
              <stringProp name="LoopController.loops">${meetings}</stringProp>
            </LoopController>
            <hashTree>
              <CounterConfig guiclass="CounterConfigGui" testclass="CounterConfig" testname="Meeting Index Counter" enabled="true">
                <stringProp name="CounterConfig.start">0</stringProp>
                <stringProp name="CounterConfig.end"></stringProp>
                <stringProp name="CounterConfig.incr">1</stringProp>
                <stringProp name="CounterConfig.name">meetingIdx</stringProp>
                <stringProp name="CounterConfig.format"></stringProp>
                <boolProp name="CounterConfig.per_user">false</boolProp>
              </CounterConfig>
              <hashTree/>
              <IfController guiclass="IfControllerPanel" testclass="IfController" testname="Exit if No Slots Available" enabled="true">
                <stringProp name="IfController.condition">${__groovy(vars.get(&quot;noSlotsAvailable&quot;) == &quot;true&quot;)}</stringProp>
                <boolProp name="IfController.evaluateAll">false</boolProp>
              </IfController>
              <hashTree>
                <TestAction guiclass="TestActionGui" testclass="TestAction" testname="Skip to Next Day" enabled="true">
                  <intProp name="ActionProcessor.action">4</intProp>
                  <intProp name="ActionProcessor.target">0</intProp>
                  <stringProp name="ActionProcessor.duration">0</stringProp>
                </TestAction>
                <hashTree/>
              </hashTree>
              <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Reset Meeting Room State" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">SampleResult.setIgnore()

// Runs once per meeting, BEFORE &quot;Get Vacant Slots&quot;. Get Vacant Slots is now
// called exactly ONCE per meeting (no retry loop), so all we need is a clean
// slate: no leftover slot flag and no leftover meetingId from the previous meeting.
vars.put(&quot;hasVacantSlot&quot;, &quot;false&quot;)
vars.remove(&quot;meetingId&quot;)   // so a failed Create never reuses the previous meeting&apos;s id
</stringProp>
              </JSR223Sampler>
              <hashTree/>
              <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Get Vacant Slots" enabled="true">
                <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
                  <collectionProp name="Arguments.arguments">
                    <elementProp name="requestDate" elementType="HTTPArgument">
                      <boolProp name="HTTPArgument.always_encode">true</boolProp>
                      <stringProp name="Argument.value">${requestDate}</stringProp>
                      <stringProp name="Argument.metadata">=</stringProp>
                      <boolProp name="HTTPArgument.use_equals">true</boolProp>
                      <stringProp name="Argument.name">requestDate</stringProp>
                    </elementProp>
                    <elementProp name="interval" elementType="HTTPArgument">
                      <boolProp name="HTTPArgument.always_encode">true</boolProp>
                      <stringProp name="Argument.value">${selectedMeetingDuration}</stringProp>
                      <stringProp name="Argument.metadata">=</stringProp>
                      <boolProp name="HTTPArgument.use_equals">true</boolProp>
                      <stringProp name="Argument.name">interval</stringProp>
                    </elementProp>
                    <elementProp name="mode" elementType="HTTPArgument">
                      <boolProp name="HTTPArgument.always_encode">true</boolProp>
                      <stringProp name="Argument.value">VACANT</stringProp>
                      <stringProp name="Argument.metadata">=</stringProp>
                      <boolProp name="HTTPArgument.use_equals">true</boolProp>
                      <stringProp name="Argument.name">mode</stringProp>
                    </elementProp>
                    <elementProp name="location" elementType="HTTPArgument">
                      <boolProp name="HTTPArgument.always_encode">true</boolProp>
                      <stringProp name="Argument.value">${parentLocationId}</stringProp>
                      <stringProp name="Argument.metadata">=</stringProp>
                      <boolProp name="HTTPArgument.use_equals">true</boolProp>
                      <stringProp name="Argument.name">location</stringProp>
                    </elementProp>
                    <elementProp name="groupfield" elementType="HTTPArgument">
                      <boolProp name="HTTPArgument.always_encode">true</boolProp>
                      <stringProp name="Argument.value">timeslot</stringProp>
                      <stringProp name="Argument.metadata">=</stringProp>
                      <boolProp name="HTTPArgument.use_equals">true</boolProp>
                      <stringProp name="Argument.name">groupfield</stringProp>
                    </elementProp>
                  </collectionProp>
                </elementProp>
                <stringProp name="HTTPSampler.domain">${host}</stringProp>
                <stringProp name="HTTPSampler.port">${port}</stringProp>
                <stringProp name="HTTPSampler.protocol">${protocol}</stringProp>
                <stringProp name="HTTPSampler.contentEncoding"></stringProp>
                <stringProp name="HTTPSampler.path">/${contextname}/api/events/${eventId}/meetinglocations</stringProp>
                <stringProp name="HTTPSampler.method">GET</stringProp>
                <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
                <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
                <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
                <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
                <stringProp name="HTTPSampler.embedded_url_re"></stringProp>
                <stringProp name="HTTPSampler.connect_timeout"></stringProp>
                <stringProp name="HTTPSampler.response_timeout"></stringProp>
              </HTTPSamplerProxy>
              <hashTree>
                <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Select Room And Duration For Meeting" enabled="true">
                  <stringProp name="scriptLanguage">groovy</stringProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="cacheKey">true</stringProp>
                  <stringProp name="script">def totalRooms = (vars.get(&quot;totalRoomCount&quot;) ?: &quot;0&quot;).toInteger()
def meetingIdx = vars.get(&quot;meetingIdx&quot;).toInteger()

// Runs before the SINGLE &quot;Get Vacant Slots&quot; call of each meeting.
// 1) pick one random meeting duration (from Get All Lookup Values)
// 2) pick the venue to query (the venue of the first room)
// The vacant-slot response covers every room of that venue, so the room itself
// is chosen in &quot;Slot PostProcessor&quot; from that one response - no extra API calls.

def durationCount = (vars.get(&quot;meetingDurationCount&quot;) ?: &quot;0&quot;).toInteger()
if (durationCount &gt; 0) {
  def durationIdx = new Random().nextInt(durationCount)
  def chosenDuration = vars.get(&quot;meetingDuration_${durationIdx}&quot;)
  vars.put(&quot;selectedMeetingDuration&quot;, chosenDuration)
  log.info(&quot;Meeting &quot; + (meetingIdx + 1) + &quot;: picked random duration=&quot; + chosenDuration + &quot; minutes&quot;)
} else {
  vars.put(&quot;selectedMeetingDuration&quot;, &quot;&quot;)
  log.warn(&quot;Meeting &quot; + (meetingIdx + 1) + &quot;: no meeting durations available from Lookup Values - &apos;interval&apos; param will be blank&quot;)
}

if (totalRooms == 0) {
  log.error(&quot;No rooms available across any event location; cannot create meeting #&quot; + (meetingIdx + 1))
} else {
  def roomIdx = 0
  def roomUniqueId = vars.get(&quot;allRoom_${roomIdx}_id&quot;)
  def roomName = vars.get(&quot;allRoom_${roomIdx}_name&quot;)
  def parentVenueId = vars.get(&quot;allRoom_${roomIdx}_locationId&quot;)

  vars.put(&quot;locationId&quot;, roomUniqueId)
  vars.put(&quot;locationName&quot;, roomName)
  vars.put(&quot;parentLocationId&quot;, parentVenueId)

  log.info(&quot;Meeting &quot; + (meetingIdx + 1) + &quot; -&gt; querying venue=&quot; + parentVenueId + &quot; (single Get Vacant Slots call)&quot;)
}
</stringProp>
                </JSR223PreProcessor>
                <hashTree/>
                <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header Manager" enabled="true">
                  <collectionProp name="HeaderManager.headers">
                    <elementProp name="" elementType="Header">
                      <stringProp name="Header.name">x-cloud-customerid</stringProp>
                      <stringProp name="Header.value">${customerId}</stringProp>
                    </elementProp>
                    <elementProp name="" elementType="Header">
                      <stringProp name="Header.name">x-cloud-categorytypeid</stringProp>
                      <stringProp name="Header.value">${categoryTypeId}</stringProp>
                    </elementProp>
                    <elementProp name="" elementType="Header">
                      <stringProp name="Header.name">x-cloud-categoryid</stringProp>
                      <stringProp name="Header.value">${categoryId}</stringProp>
                    </elementProp>
                    <elementProp name="" elementType="Header">
                      <stringProp name="Header.name">x-cloud-eventid</stringProp>
                      <stringProp name="Header.value">${eventId}</stringProp>
                    </elementProp>
                  </collectionProp>
                </HeaderManager>
                <hashTree/>
                <com.atlantbh.jmeter.plugins.jsonutils.jsonformatter.JSONFormatter guiclass="com.atlantbh.jmeter.plugins.jsonutils.jsonformatter.gui.JSONFormatterGui" testclass="com.atlantbh.jmeter.plugins.jsonutils.jsonformatter.JSONFormatter" testname="jp@gc - JSON Format Post Processor" enabled="true"/>
                <hashTree/>
                <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Slot PostProcessor" enabled="true">
                  <stringProp name="scriptLanguage">groovy</stringProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="cacheKey">true</stringProp>
                  <stringProp name="script">import groovy.json.JsonSlurper

def response = prev.getResponseDataAsString()
def json = new JsonSlurper().parseText(response)

def requestDate = vars.get(&quot;requestDate&quot;)
def venueId = vars.get(&quot;parentLocationId&quot;)

// Assume nothing found until a slot is actually picked below.
vars.put(&quot;hasVacantSlot&quot;, &quot;false&quot;)

// The Get Vacant Slots endpoint returns _embedded.locationTimeSlots
def slots = json?._embedded?.locationTimeSlots ?: json?._embedded?.timeslots ?: json?._embedded?.meetinglocations ?: json?._embedded?.locations ?: (json instanceof List ? json : [])

log.info(&quot;Vacant Slots: API returned &quot; + slots.size() + &quot; slot(s)&quot;)

// Build room info directly from the vacant slots response
// The response includes a &apos;locations&apos; array with room details
def roomMap = [:] // roomId -&gt; room name
slots.each { slot -&gt;
    if (slot.locations instanceof List) {
        slot.locations.each { room -&gt;
            if (room.uniqueId &amp;&amp; room.locationTypeId == &quot;ROOM&quot;) {
                roomMap[room.uniqueId.toString()] = room.name
            }
        }
    }
}

log.info(&quot;Vacant Slots: extracted &quot; + roomMap.size() + &quot; room(s) from API response: &quot; + roomMap)

def roomNameOf = { String id -&gt;
    return roomMap[id] ?: id
}

// Filter: keep only entries marked vacant AND that have a valid locationId
def vacantSlots = slots.findAll { slot -&gt;
  if (!(slot instanceof Map)) return false
  if (slot.status != &quot;vacant&quot;) return false
  if (!slot.locationId) return false
  return true
}

log.info(&quot;Vacant Slots: after filtering, &quot; + vacantSlots.size() + &quot; vacant slot(s) with valid locationId&quot;)
if (vacantSlots.size() &gt; 0) {
    log.info(&quot;Vacant Slots: sample slot - locationId=&quot; + vacantSlots[0].locationId + &quot;, startTime=&quot; + vacantSlots[0].startTime + &quot;, endTime=&quot; + vacantSlots[0].endTime)
}

def pickField = { entry, names -&gt; names.findResult { entry instanceof Map ? entry.get(it) : null } }

// CRITICAL: Filter out time slots that OVERLAP with already-used slots.
// Multiple threads can call Get Vacant Slots simultaneously and get the same
// slot list before any meetings are created. Check for OVERLAPS not just
// exact matches - a meeting at 9:00-10:00 conflicts with 8:30-9:30 even
// though they have different start/end times. Two ranges overlap if:
// (newStart &lt; existingEnd) AND (newEnd &gt; existingStart)
// Track slots per room AND date - same time on different days is OK.

// LOAD EXISTING MEETINGS FROM API (on first call per run)
def usedSlotsMap = props.get(&quot;usedTimeSlots&quot;)
if (!props.get(&quot;existingMeetingsLoaded&quot;)) {
  try {
      def eventId = vars.get(&quot;eventId&quot;)
      def customerId = vars.get(&quot;customerId&quot;)
      def categoryTypeId = vars.get(&quot;categoryTypeId&quot;)
      def categoryId = vars.get(&quot;categoryId&quot;)
      def protocol = vars.get(&quot;protocol&quot;) ?: &quot;https&quot;
      def host = vars.get(&quot;host&quot;)
      def contextname = vars.get(&quot;contextname&quot;) ?: &quot;event-iq&quot;
      def authorization = vars.get(&quot;authorization&quot;)

      if (eventId &amp;&amp; host) {
          def url = protocol + &quot;://&quot; + host + &quot;/&quot; + contextname + &quot;/api/events/&quot; + eventId + &quot;/meetings?page=0&amp;size=1000&quot;
          def connection = new URL(url).openConnection()
          connection.setRequestMethod(&quot;GET&quot;)
          connection.setRequestProperty(&quot;Authorization&quot;, authorization)
          connection.setRequestProperty(&quot;x-cloud-customerid&quot;, customerId)
          connection.setRequestProperty(&quot;x-cloud-categorytypeid&quot;, categoryTypeId)
          connection.setRequestProperty(&quot;x-cloud-categoryid&quot;, categoryId)
          connection.setRequestProperty(&quot;x-cloud-eventid&quot;, eventId)

          if (connection.responseCode == 200) {
              def responseText = connection.inputStream.text
              def meetingsJson = new groovy.json.JsonSlurper().parseText(responseText)
              def meetings = meetingsJson?._embedded?.meetingList ?: meetingsJson?.content ?: []

              def loadedCount = 0
              meetings.each { meeting -&gt;
                  // EventIQ meetings have requestDates array with the actual slots
                  def requestDates = meeting.requestDates ?: []
                  requestDates.each { reqDate -&gt;
                      def meetingLocationId = reqDate.location?.uniqueId ?: reqDate.locationId ?: meeting.locationId
                      def startTime = reqDate.requestedStartTime ?: reqDate.startTime
                      def endTime = reqDate.requestedEndTime ?: reqDate.endTime
                      def meetingDate = reqDate.requestDate ?: reqDate.date

                      if (meetingLocationId &amp;&amp; startTime &amp;&amp; endTime &amp;&amp; meetingDate) {
                          def slotKey = meetingLocationId + &quot;|&quot; + meetingDate + &quot;|&quot; + startTime + &quot;|&quot; + endTime
                          usedSlotsMap.put(slotKey, true)
                          loadedCount++
                      }
                  }
              }
              log.info(&quot;Loaded &quot; + loadedCount + &quot; existing meeting slot(s) to prevent time conflicts&quot;)
          } else {
              log.warn(&quot;Failed to load existing meetings: HTTP &quot; + connection.responseCode)
          }
      }
  } catch (Exception e) {
      log.warn(&quot;Error loading existing meetings: &quot; + e.message)
  }
  props.put(&quot;existingMeetingsLoaded&quot;, true)
}

def overlaps = { String roomId, slotStart, slotEnd -&gt;
  def startLong = slotStart instanceof Long ? slotStart : Long.parseLong(slotStart.toString())
  def endLong = slotEnd instanceof Long ? slotEnd : Long.parseLong(slotEnd.toString())
  def roomDatePrefix = roomId + &quot;|&quot; + requestDate + &quot;|&quot;

  for (usedKey in usedSlotsMap.keySet()) {
      if (!usedKey.startsWith(roomDatePrefix)) continue

      def parts = usedKey.split(&quot;\\|&quot;)
      if (parts.length &lt; 4) continue

      def usedStart = Long.parseLong(parts[2])
      def usedEnd = Long.parseLong(parts[3])

      // Overlap detection: (A.start &lt; B.end) AND (A.end &gt; B.start)
      if (startLong &lt; usedEnd &amp;&amp; endLong &gt; usedStart) {
          return true
      }
  }
  return false
}

// Group the vacant slots by room
def slotsByRoom = vacantSlots.groupBy { it.locationId.toString() }
log.info(&quot;Vacant Slots: grouped into &quot; + slotsByRoom.size() + &quot; room(s): &quot; + slotsByRoom.keySet())

// Use all rooms from the API response in order
def roomOrder = slotsByRoom.keySet().toList()
log.info(&quot;Vacant Slots: room order = &quot; + roomOrder)

// BUGFIX: the old logic looped rooms IN ORDER and &apos;break&apos;-ed at the FIRST
// room that had any free slot, only randomizing the TIME within that one
// room. That meant room #1 absorbed every meeting (usually landing on its
// earliest opening, e.g. 7 AM) until it was fully booked, THEN room #2 took
// over and repeated the same pattern - looking like &quot;every room picks 7 AM,
// in order&quot; instead of a real random spread. Fix: build a single pool of
// every (room, slot) combination that is actually free across ALL rooms,
// then pick one uniformly at random from that whole pool.
def pool = []
roomOrder.each { roomId -&gt;
  slotsByRoom[roomId].each { slot -&gt;
      def start = pickField(slot, [&quot;startTime&quot;, &quot;requestedStartTime&quot;, &quot;slotStartTime&quot;, &quot;start&quot;])
      def end = pickField(slot, [&quot;endTime&quot;, &quot;requestedEndTime&quot;, &quot;slotEndTime&quot;, &quot;end&quot;])
      if (start != null &amp;&amp; end != null &amp;&amp; !overlaps(roomId, start, end)) {
          pool &lt;&lt; [roomId: roomId, start: start, end: end]
      }
  }
}

def chosenRoomId = pool ? pool[0].roomId : null

if (pool) {
  // Pick a RANDOM (room, slot) pair from across the WHOLE venue so load
  // isn&apos;t hammering the same room/time every time.
  def randomIdx = new Random().nextInt(pool.size())
  def chosenSlot = pool[randomIdx]
  chosenRoomId = chosenSlot.roomId
  def slotStart = chosenSlot.start
  def slotEnd   = chosenSlot.end

  // Mark this slot as used BEFORE creating the meeting to prevent another
  // thread from picking an overlapping slot. Key format:
  // locationId|requestDate|startTime|endTime
  usedSlotsMap.put(chosenRoomId + &quot;|&quot; + requestDate + &quot;|&quot; + slotStart + &quot;|&quot; + slotEnd, true)

  // Create Meeting uses these variables
  vars.put(&quot;locationId&quot;, chosenRoomId)
  vars.put(&quot;locationName&quot;, roomNameOf(chosenRoomId))
  vars.put(&quot;startTime&quot;, slotStart.toString())
  vars.put(&quot;endTime&quot;, slotEnd.toString())
  vars.put(&quot;hasVacantSlot&quot;, &quot;true&quot;)
  log.info(&quot;Vacant Slots: picked slot &quot; + (randomIdx + 1) + &quot;/&quot; + pool.size() + &quot; -&gt; &quot; + slotStart + &quot; - &quot; + slotEnd + &quot; for room=&quot; + vars.get(&quot;locationName&quot;) + &quot;, date=&quot; + requestDate)
} else {
  // Single call, no retry: nothing usable in this venue&apos;s response. Log where slots were lost.
  def waitlist = slots.count { it instanceof Map &amp;&amp; it.locationId == null }
  def notVacant = slots.count { it instanceof Map &amp;&amp; it.status != null &amp;&amp; it.status != &quot;vacant&quot; }
  log.warn(&quot;Vacant Slots: NO usable slot. venue=&quot; + venueId + &quot;, date=&quot; + requestDate + &quot;, interval=&quot; + vars.get(&quot;selectedMeetingDuration&quot;) +
             &quot; | raw entries=&quot; + slots.size() + &quot;, waitlist(locationId=null)=&quot; + waitlist + &quot;, non-vacant status=&quot; + notVacant +
             &quot;, vacant real-room slots=&quot; + vacantSlots.size() + &quot; in &quot; + slotsByRoom.size() + &quot; room(s) &quot; + slotsByRoom.keySet() +
             &quot; (rest, if any, were dropped as overlapping slots already used in this run)&quot;)
}
</stringProp>
                </JSR223PostProcessor>
                <hashTree/>
              </hashTree>
              <IfController guiclass="IfControllerPanel" testclass="IfController" testname="Vacant Slot Found" enabled="true">
                <stringProp name="IfController.condition">&quot;${hasVacantSlot}&quot; == &quot;true&quot;</stringProp>
                <boolProp name="IfController.evaluateAll">false</boolProp>
              </IfController>
