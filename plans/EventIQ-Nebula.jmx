        <hashTree>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Event Date PostProcessor" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput

def response = prev.getResponseDataAsString()
def json = new JsonSlurper().parseText(response)

// UDV the user passes in - the eventDateId they want to select
def eventDayId = vars.get(&quot;eventDayId&quot;)?.trim()

def matched = []
def eventDayValid = &quot;false&quot;

if (eventDayId == null || eventDayId.isEmpty()) {
    // Not supplied -&gt; use EVERY event day (in date order). The &quot;For Each Event
    // Day&quot; loop then creates the requested number of meetings on each of them.
    // This still counts as valid for the meeting-creation flow.
    if (json &amp;&amp; json.size() &gt; 0) {
        matched = json.sort(false) { it.eventDate }
        eventDayValid = &quot;true&quot;
        log.info(&quot;Event Dates: eventDayId not provided, using all &quot; + matched.size() + &quot; event day(s)&quot;)
    } else {
        matched = []
        eventDayValid = &quot;false&quot;
        log.warn(&quot;Event Dates: eventDayId not provided and no event dates exist for this event&quot;)
    }

} else {
    def hit = json.find { it.eventDateId == eventDayId }

    if (hit != null) {
        matched = [hit]
        eventDayValid = &quot;true&quot;
        log.info(&quot;Event Dates: matched eventDayId=&quot; + eventDayId)
    } else {
        // Only an explicitly supplied but non-matching eventDayId is treated as invalid.
        matched = []
        eventDayValid = &quot;false&quot;
        log.error(&quot;Event Dates: no matching eventDateId for eventDayId=&quot; + eventDayId)
    }
}

vars.put(&quot;eventDayValid&quot;, eventDayValid)
vars.put(&quot;matchedEventDateCount&quot;, matched.size().toString())

matched.eachWithIndex { d, idx -&gt;
    vars.put(&quot;eventDate_${idx}_eventDate&quot;, d.eventDate.toString())
    vars.put(&quot;eventDate_${idx}_startTime&quot;, d.eventStartTime.toString())
    vars.put(&quot;eventDate_${idx}_endTime&quot;, d.eventEndTime.toString())
    vars.put(&quot;eventDate_${idx}_eventDateId&quot;, d.eventDateId)
}

// Backward-compatible single-value vars (first match) for the Create Meeting body
if (eventDayValid == &quot;true&quot;) {
    vars.put(&quot;requestDate&quot;, matched[0].eventDate.toString())
    vars.put(&quot;startTime&quot;, matched[0].eventStartTime.toString())
    vars.put(&quot;endTime&quot;, matched[0].eventEndTime.toString())
    vars.put(&quot;eventDateId&quot;, matched[0].eventDateId)
} else {
    vars.remove(&quot;requestDate&quot;)
    vars.remove(&quot;startTime&quot;)
    vars.remove(&quot;endTime&quot;)
    vars.remove(&quot;eventDateId&quot;)
}

// Full matched set as JSON, ready to drop straight into a requestDates[] array
vars.put(&quot;matchedEventDatesJson&quot;, JsonOutput.toJson(matched))
</stringProp>
          </JSR223PostProcessor>
