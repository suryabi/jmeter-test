                  <stringProp name="cacheKey">true</stringProp>
                  <stringProp name="script">// Calculate 1-based display values for sampler name
def dayIdx = (vars.get(&quot;dayIdx&quot;) ?: &quot;0&quot;).toInteger()
def meetingIdx = (vars.get(&quot;meetingIdx&quot;) ?: &quot;0&quot;).toInteger()
def totalDays = vars.get(&quot;matchedEventDateCount&quot;) ?: &quot;1&quot;
def totalMeetings = vars.get(&quot;meetings&quot;) ?: &quot;1&quot;

vars.put(&quot;dayNum&quot;, String.valueOf(dayIdx + 1))
vars.put(&quot;meetingNum&quot;, String.valueOf(meetingIdx + 1))</stringProp>
