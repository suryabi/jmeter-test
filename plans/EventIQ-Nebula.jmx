    ] as String[])
}

// ACCOUNT NAME FUNCTION - Returns unique customer name per event run
// First 750 picks are random unique, then sequential from index 0
def _fn_accountName = { varsRef -&gt;
    def customers = props.get(&quot;data_allCustomers&quot;) as String[]

    if (!customers || customers.length == 0) {
        throw new IllegalStateException(&quot;data_allCustomers is empty or not configured&quot;)
    }

    // Get or initialize the used customers set for this event run
    def usedCustomersJson = varsRef.get(&quot;usedCustomers&quot;)
    def usedCustomers = []
    if (usedCustomersJson) {
        try {
            usedCustomers = new groovy.json.JsonSlurper().parseText(usedCustomersJson)
        } catch (Exception e) {
            log.warn(&quot;fn_accountName: Could not parse usedCustomers, resetting to empty: &quot; + e.message)
            usedCustomers = []
        }
    }

    // Filter out already used customers
    def availableCustomers = customers.findAll { !usedCustomers.contains(it) }

    def selectedCustomer
    def selectionMode

    // If all customers are used, switch to sequential mode
    if (!availableCustomers || availableCustomers.size() == 0) {
        log.info(&quot;fn_accountName: All &quot; + customers.length + &quot; customers used, switching to SEQUENTIAL mode&quot;)

        // Get or initialize sequential index
        def seqIndex = (varsRef.get(&quot;customerSequentialIndex&quot;) ?: &quot;0&quot;).toInteger()

        // Wrap around if we&apos;ve gone through all customers sequentially
        if (seqIndex &gt;= customers.length) {
            seqIndex = 0
            log.info(&quot;fn_accountName: Sequential index wrapped around to 0&quot;)
        }

        // Pick customer sequentially by index
        selectedCustomer = customers[seqIndex]
        selectionMode = &quot;SEQUENTIAL&quot;

        // Increment and save index for next call
        varsRef.put(&quot;customerSequentialIndex&quot;, (seqIndex + 1).toString())

        log.info(&quot;fn_accountName: Sequential mode - customer=&apos;&quot; + selectedCustomer + &quot;&apos; at index &quot; + seqIndex + &quot;/&quot; + customers.length)
    } else {
        // First 750: Randomly select from available customers
        def randomIndex = java.util.concurrent.ThreadLocalRandom.current().nextInt(availableCustomers.size())
        selectedCustomer = availableCustomers[randomIndex]
        selectionMode = &quot;RANDOM&quot;

        // Add to used list and save back to vars
        usedCustomers &lt;&lt; selectedCustomer
        varsRef.put(&quot;usedCustomers&quot;, groovy.json.JsonOutput.toJson(usedCustomers))

        log.info(&quot;fn_accountName: Random mode - customer=&apos;&quot; + selectedCustomer + &quot;&apos; (&quot; + usedCustomers.size() + &quot;/&quot; + customers.length + &quot; used)&quot;)
    }

    varsRef.put(&quot;accountName&quot;, selectedCustomer)

    return selectedCustomer
}

props.put(&quot;fn_accountName&quot;, _fn_accountName)

log.info(&quot;Common Functions Initialized Successfully&quot;)</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
