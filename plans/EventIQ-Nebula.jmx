            <hashTree/>
            <com.atlantbh.jmeter.plugins.jsonutils.jsonformatter.JSONFormatter guiclass="com.atlantbh.jmeter.plugins.jsonutils.jsonformatter.gui.JSONFormatterGui" testclass="com.atlantbh.jmeter.plugins.jsonutils.jsonformatter.JSONFormatter" testname="jp@gc - JSON Format Post Processor" enabled="true"/>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Topics PostProcessor" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">// Caches the topics returned by &quot;Get Topics&quot; (includechilds=true) so
// &quot;Update Meeting&quot; can send a REAL Meeting Focus (textField2) and Meeting
// Sub Focus (textField3) instead of null. Shape-agnostic: walks the whole
// response and collects every topic record (topicId/uniqueId + name),
// whether children are nested under the parent or linked via parentId.
// Result -&gt; vars &quot;topicsJson&quot; = [ {id, name, children:[{id, name}]}, ... ]
import groovy.json.JsonSlurper
import groovy.json.JsonOutput

try {
    def body = prev.getResponseDataAsString()
    def json = body ? new JsonSlurper().parseText(body) : null

    def topics = [:]   // id -&gt; [id, name, parentId]
    def walk
    walk = { node, String parentId -&gt;
        if (node instanceof Map) {
            def id = (node.topicId ?: node.uniqueId)?.toString()
            def isTopic = id &amp;&amp; node.name != null
            String nextParent = parentId
            if (isTopic) {
                def par = (node.parent instanceof Map) ? node.parent : null
                def pid = (node.parentTopicId ?: node.parentId ?: par?.uniqueId ?: parentId)?.toString()
                // Topic records carry their parent as a nested object
                // (&quot;parent&quot;: {uniqueId, name, ...}) - register it so a parent is
                // known even if it is not listed as its own record.
                if (par?.uniqueId &amp;&amp; par.name != null &amp;&amp; !topics.containsKey(par.uniqueId.toString())) {
                    topics[par.uniqueId.toString()] = [id: par.uniqueId.toString(), name: par.name.toString(), parentId: null]
                }
                if (!topics.containsKey(id)) {
                    topics[id] = [id: id, name: node.name.toString(), parentId: pid]
                }
                nextParent = id
            }
            // Only descend into lists / _embedded so nested metadata objects
            // (topicType, _links, ...) are not mistaken for child topics.
            node.each { k, v -&gt;
                if (v instanceof Collection || k == &quot;_embedded&quot;) {
                    walk(v, nextParent)
                }
            }
        } else if (node instanceof Collection) {
            node.each { walk(it, parentId) }
        }
    }
    walk(json, null)

    def all = topics.values().toList()
    def parents = all.findAll { !it.parentId || !topics.containsKey(it.parentId) }
    def tree = parents.collect { p -&gt;
        [id: p.id, name: p.name,
         children: all.findAll { it.parentId == p.id }.collect { [id: it.id, name: it.name] }]
    }
    log.info(&quot;Get Topics: found &quot; + all.size() + &quot; topic record(s), &quot; + tree.size() + &quot; parent(s); first record=&quot; + (all ? JsonOutput.toJson(all[0]) : &quot;n/a&quot;))
    vars.put(&quot;topicsJson&quot;, JsonOutput.toJson(tree))
} catch (Exception e) {
    vars.put(&quot;topicsJson&quot;, &quot;[]&quot;)
    log.warn(&quot;Get Topics: could not parse response (&quot; + e.message + &quot;) - topicsJson set to []&quot;)
}</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
          </hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Fetch Random Data" enabled="true">
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
