        </JSR223Sampler>
        <hashTree/>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Used Customers &amp; Time Slots" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">SampleResult.setIgnore()

// Reset the used customers list at the start of each event run.
// This ensures no duplicate customer names are assigned to meetings within
// the same event. The fn_accountName function (in Common Function sampler)
// maintains this list and filters out already-used customers.
// After 750 unique customers are used, it switches to sequential mode.
vars.put(&quot;usedCustomers&quot;, &quot;[]&quot;)
vars.put(&quot;customerSequentialIndex&quot;, &quot;0&quot;)

// Reset the used time slots list at the start of each event run.
// This prevents race conditions where multiple threads pick the same time
// slot from Get Vacant Slots before any meetings are created. Slots are
// tracked as &quot;locationId|requestDate|startTime|endTime&quot; and filtered out when selecting.
// The Vacant Slots PostProcessor will load existing meetings from the API on first call.
props.put(&quot;usedTimeSlots&quot;, new java.util.concurrent.ConcurrentHashMap&lt;String, Boolean&gt;())
props.remove(&quot;existingMeetingsLoaded&quot;)  // Reset flag so API load happens on first vacant slots call

log.info(&quot;Used Customers &amp; Time Slots Tracker: Reset to empty for new event run&quot;)</stringProp>
        </JSR223Sampler>
