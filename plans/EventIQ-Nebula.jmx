                      <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Document Cleanup PostProcessor" enabled="true">
                        <stringProp name="scriptLanguage">groovy</stringProp>
                        <stringProp name="parameters"></stringProp>
                        <stringProp name="filename"></stringProp>
                        <stringProp name="cacheKey">true</stringProp>
                        <stringProp name="script">def filePath = vars.get(&quot;documentFilePath&quot;)
if (filePath) {
    def deleted = new File(filePath).delete()
    log.info(&quot;Meeting Document cleanup: &quot; + (deleted ? &quot;removed &quot; : &quot;could not remove &quot;) + filePath)
}</stringProp>
