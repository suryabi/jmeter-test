# BriefingIQ JMeter Runner — local overrides (not committed; copy to .env)

# Apache JMeter install directory (folder containing bin/ApacheJMeter.jar)
# JMETER_HOME="D:\Softwares\Jmeter 5.4\Jmeter 5.4"

# Java for JMeter population runs only — does NOT change system JAVA_HOME.
# Use this when backend work requires Java 8 but JMeter needs 17/21 on Windows.
# Run: npm run setup:jmeter-java
# Or auto-download Temurin 17 (no admin): npm run install:jmeter-java
# JMETER_JAVA_HOME="C:\Program Files\Eclipse Adoptium\jdk-17.0.13.11-hotspot"

# Optional: full path to jmeter executable if not on PATH
# JMETER_BIN="D:\Softwares\Jmeter 5.4\Jmeter 5.4\bin\jmeter.bat"
